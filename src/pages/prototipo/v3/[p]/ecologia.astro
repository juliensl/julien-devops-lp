---
// PROTÓTIPO v3 · Página de ecologia da variante escura: /prototipo/v3/a/ecologia/.
import PrototipoV3 from '../../../../layouts/PrototipoV3.astro';
import Vista from '../../../../components/prototipo-v3/Vista.astro';
import Ecologia from '../../../../components/prototipo-v3/Ecologia.astro';
import { temas } from '../../../../components/prototipo-v3/temas';
import type { P } from '../../../../components/prototipo-v3/dados';

export function getStaticPaths() {
	return [
		{ params: { p: 'a' }, props: { n: 1 } },
	];
}
const p = Astro.props.n as P;
const t = temas[p - 1];
---

<PrototipoV3 titulo={`Ecologia · Variante ${t.letra} · ${t.nome}`}>
	<Vista p={p} pagina="ecologia" modo="rotas">
		<Ecologia p={p} modo="rotas" />
	</Vista>
</PrototipoV3>
