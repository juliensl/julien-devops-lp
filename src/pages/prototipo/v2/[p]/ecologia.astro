---
// PROTÓTIPO v2 · Página de ecologia de cada protótipo: /prototipo/v2/N/ecologia/.
import PrototipoV2 from '../../../../layouts/PrototipoV2.astro';
import Vista from '../../../../components/prototipo-v2/Vista.astro';
import Ecologia from '../../../../components/prototipo-v2/Ecologia.astro';
import { temas } from '../../../../components/prototipo-v2/temas';
import type { P } from '../../../../components/prototipo-v2/dados';

export function getStaticPaths() {
	return ['1', '2', '3'].map((p) => ({ params: { p } }));
}
const p = Number(Astro.params.p) as P;
---

<PrototipoV2 titulo={`Ecologia · Protótipo ${p} · ${temas[p - 1].nome}`}>
	<Vista p={p} pagina="ecologia" modo="rotas">
		<Ecologia p={p} modo="rotas" />
	</Vista>
</PrototipoV2>
