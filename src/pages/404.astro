---
// The 404 page: English only, the only one with no equivalents in other languages, with the site's
// look and a link to the home page of each published language (#54, "Página 404"). Its texts live here,
// not in the dictionaries, because it doesn't exist in other languages.
// It serves any address that doesn't exist, and also `/` while French is not published:
// `astro preview` and the host's `.htaccess` show it with the 404 status code.
// `Base.astro` always gives it `noindex`, so it also stays out of the sitemap.
import { HTML_CODES, PHASE, LANGUAGE_NAMES, PREFIXES } from '../config/site';
import { values } from '../config/values';
import Base from '../layouts/Base.astro';
---

<Base
	language="en"
	noEquivalents
	title={`Page not found · ${values.name}`}
	description={`This address doesn't exist on ${values.name}'s site.`}
>
	<main class="page-width py-16 sm:py-24">
		<p class="label">Error 404</p>
		<h1 class="mt-6 max-w-3xl text-[clamp(2.25rem,4.4vw,3.5rem)] leading-[1.1]">
			This page doesn't exist
		</h1>
		<p class="mt-6 max-w-2xl text-lg text-foreground-secondary">
			The link may be broken, or the address mistyped.
		</p>
		<p id="main-pages" class="mt-10">
			Go to the home page in:
		</p>
		<ul aria-labelledby="main-pages" class="mt-4 flex flex-wrap gap-3">
			{PHASE.publishedLanguages.map((l) => (
				<li>
					<a
						href={PREFIXES[l]}
						hreflang={l}
						lang={HTML_CODES[l]}
						class="inline-flex min-h-11 items-center rounded-full border border-line-strong px-5 transition-colors hover:bg-surface-2"
					>
						{LANGUAGE_NAMES[l]}
					</a>
				</li>
			))}
		</ul>
	</main>
</Base>
