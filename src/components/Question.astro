---
// One question and its answer, in a `<details>` that opens without JS, on the questions page. A list of
// them is separated by lines.
import { withNonBreakingSpaces } from '../lib/spaces';

interface Props {
	question: string;
	answer: string;
}

const { question, answer } = Astro.props;
---

<details class="question">
	<summary>{withNonBreakingSpaces(question)}</summary>
	<p class="max-w-3xl pb-5 text-foreground-secondary">{withNonBreakingSpaces(answer)}</p>
</details>

<style>
	.question {
		border-top: 1px solid var(--color-line);

		&:last-child {
			border-bottom: 1px solid var(--color-line);
		}

		summary {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			min-height: 3.5rem;
			padding-block: 0.6rem;
			font-family: var(--font-heading);
			font-size: 1.2rem;
			line-height: 1.3;
			cursor: pointer;
			list-style: none;

			&::-webkit-details-marker {
				display: none;
			}

			/* A + that turns into a × when the answer is open. */
			&::after {
				content: '+';
				flex: none;
				font-family: var(--font-body);
				font-size: 1.25rem;
				color: var(--color-green);
				transition: transform 0.2s;
			}
		}

		&[open] summary::after {
			transform: rotate(45deg);
		}
	}
</style>
