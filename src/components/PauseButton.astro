---
// The fixed button, in the bottom-left corner, that pauses and resumes every automatic animation
// on the page (WCAG 2.2.2). It goes on the pages that have them: the home page and the ecology one (#69).
//
// The shared signal, which each animation listens to without importing anything from here:
// - when paused, `<html data-animation="paused">`; when running, the attribute is absent;
// - on each click, `document` receives the `animation` event, with `detail.paused`.
// A CSS animation stops with `:root[data-animation='paused'] { animation-play-state: paused }`.
// With reduced motion, the button doesn't show: each animation checks it on its own, with
// `matchMedia('(prefers-reduced-motion: reduce)')` or `@media`, and stays still.
interface Props {
	/** The label while the animations run. */
	pause: string;
	/** The label while paused. */
	resume: string;
}

const { pause, resume } = Astro.props;
---

{/* Hidden until the script runs: without JS, it would be useless. */}
<button
	type="button"
	hidden
	data-pause-animation
	data-pause={pause}
	data-resume={resume}
	class="fixed bottom-[calc(1rem+env(safe-area-inset-bottom,0px))] left-[calc(1rem+env(safe-area-inset-left,0px))] z-30 inline-flex h-10 cursor-pointer items-center gap-2 rounded-full border border-line-strong bg-background/85 pr-3.5 pl-3 text-[0.8125rem] leading-none font-medium text-foreground-secondary backdrop-blur-[6px] hover:border-foreground hover:text-foreground motion-reduce:hidden max-md:w-10 max-md:justify-center max-md:p-0"
>
	<span class="icon" aria-hidden="true"></span>
	{/* On mobile, only the icon: the label is left to screen readers. */}
	<span data-label class="max-md:sr-only">
		{pause}
	</span>
</button>

<script>
	import { afterLoad } from '../scripts/after-load';

	afterLoad(() => {
		const html = document.documentElement;
		const buttons = document.querySelectorAll<HTMLButtonElement>('[data-pause-animation]');

		for (const button of buttons) {
			button.addEventListener('click', () => {
				const paused = html.dataset.animation !== 'paused';
				if (paused) html.dataset.animation = 'paused';
				else delete html.dataset.animation;
				document.dispatchEvent(new CustomEvent('animation', { detail: { paused } }));
			});
			button.hidden = false;
		}

		// The label says what the next click does.
		document.addEventListener('animation', () => {
			const paused = html.dataset.animation === 'paused';
			for (const button of buttons) {
				button.querySelector('[data-label]')!.textContent = paused
					? button.dataset.resume!
					: button.dataset.pause!;
			}
		});
	});
</script>

<style>
	/* A page with the button reserves the corner for it: the end of the page rises above it and the
	   focused element never ends up underneath (WCAG 2.4.11). From the start, not only once the button
	   shows, so the page doesn't jump. On a short screen, the header would leave no room for the focus:
	   there, the header, which spans the full width, takes priority. */
	@media (prefers-reduced-motion: no-preference) {
		:global(body:has([data-pause-animation])) {
			padding-bottom: calc(3.5rem + env(safe-area-inset-bottom, 0px));
		}
	}
	@media (prefers-reduced-motion: no-preference) and (min-height: 20rem) {
		:global(html:has([data-pause-animation])) {
			scroll-padding-bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
		}
	}

	/* Two bars; when paused, a triangle. */
	.icon {
		width: 10px;
		height: 12px;
		border-inline: 3px solid currentColor;
	}
	:global(:root[data-animation='paused']) .icon {
		width: 0;
		height: 0;
		border-inline: 0;
		border-left: 10px solid currentColor;
		border-block: 6px solid transparent;
	}
</style>
