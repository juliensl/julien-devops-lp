---
// O botão fixo, no canto inferior esquerdo, que pausa e retoma todas as animações automáticas
// da página (WCAG 2.2.2). Entra nas páginas que as têm: a principal e a de ecologia (#69).
//
// O sinal partilhado, que cada animação escuta sem importar nada daqui:
// - em pausa, <html data-animation="paused">; a andar, o atributo não existe;
// - a cada clique, document recebe o evento «animation», com detail.pausada.
// Uma animação em CSS para com :root[data-animation='paused'] { animation-play-state: paused }.
// Com movimento reduzido, o botão não aparece: cada animação vê-o ela própria, com
// matchMedia('(prefers-reduced-motion: reduce)') ou @media, e fica parada.
interface Props {
	/** O nome enquanto as animações andam. */
	pausar: string;
	/** O nome em pausa. */
	retomar: string;
}

const { pausar, retomar } = Astro.props;
---

{/* Escondido até o script correr: sem JS, não serviria para nada. */}
<button
	type="button"
	hidden
	data-pause-animation
	data-pause={pausar}
	data-resume={retomar}
	class="fixed bottom-[calc(1rem+env(safe-area-inset-bottom,0px))] left-[calc(1rem+env(safe-area-inset-left,0px))] z-30 inline-flex h-10 cursor-pointer items-center gap-2 rounded-full border border-line-strong bg-background/85 pr-3.5 pl-3 text-[0.8125rem] leading-none font-medium text-foreground-secondary backdrop-blur-[6px] hover:border-foreground hover:text-foreground motion-reduce:hidden max-md:w-10 max-md:justify-center max-md:p-0"
>
	<span class="icon" aria-hidden="true"></span>
	{/* No telemóvel, só o ícone: o nome fica para os leitores de ecrã. */}
	<span data-label class="max-md:sr-only">
		{pausar}
	</span>
</button>

<script>
	import { depoisDoCarregamento } from '../scripts/after-load';

	depoisDoCarregamento(() => {
		const html = document.documentElement;
		const botoes = document.querySelectorAll<HTMLButtonElement>('[data-pause-animation]');

		for (const botao of botoes) {
			botao.addEventListener('click', () => {
				const pausada = html.dataset.animation !== 'paused';
				if (pausada) html.dataset.animation = 'paused';
				else delete html.dataset.animation;
				document.dispatchEvent(new CustomEvent('animation', { detail: { pausada } }));
			});
			botao.hidden = false;
		}

		// O nome diz o que o próximo clique faz.
		document.addEventListener('animation', () => {
			const pausada = html.dataset.animation === 'paused';
			for (const botao of botoes) {
				botao.querySelector('[data-label]')!.textContent = pausada
					? botao.dataset.resume!
					: botao.dataset.pause!;
			}
		});
	});
</script>

<style>
	/* Uma página com o botão reserva-lhe o canto: o fim da página sobe acima dele e o elemento com
	   foco nunca fica por baixo (WCAG 2.4.11). Desde o início, e não só quando o botão aparece,
	   para a página não saltar. Num ecrã baixo, com o cabeçalho não sobraria espaço para o foco:
	   aí, o cabeçalho, que ocupa a largura toda, tem prioridade. */
	@media (prefers-reduced-motion: no-preference) {
		:global(body:has([data-pause-animation])) {
			padding-bottom: calc(3.5rem + env(safe-area-inset-bottom, 0px));
		}
	}
	@media (prefers-reduced-motion: no-preference) and (min-height: 20rem) {
		:global(html:has([data-pause-animation])) {
			scroll-padding-bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
		}
	}

	/* Duas barras; em pausa, um triângulo. */
	.icon {
		width: 10px;
		height: 12px;
		border-inline: 3px solid currentColor;
	}
	:global(:root[data-animation='paused']) .icon {
		width: 0;
		height: 0;
		border-inline: 0;
		border-left: 10px solid currentColor;
		border-block: 6px solid transparent;
	}
</style>
