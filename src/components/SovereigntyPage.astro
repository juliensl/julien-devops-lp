---
// The data sovereignty page: Julien's five sections, and the booking button at the end.
import type { Language } from '../config/site';
import { values } from '../config/values';
import { dictionaries } from '../i18n';
import Base from '../layouts/Base.astro';
import { withNonBreakingSpaces } from '../lib/spaces';
import BookingButton from './BookingButton';

interface Props {
	language: Language;
}

const { language } = Astro.props;
const page = dictionaries[language].sovereignty;
const last = page.sections.length - 1;
---

<Base language={language} title={`${page.name} · ${values.name}`} description={page.description}>
	<main class="page-width grid gap-20 pt-14 sm:pt-20">
		<div class="grid gap-5">
			<p class="label">{page.name}</p>
			<h1 class="max-w-[22ch] text-[clamp(2.25rem,5vw,4rem)] leading-[1.05]">
				{withNonBreakingSpaces(page.title)}
			</h1>
			<p class="max-w-2xl text-lg text-foreground-secondary">{withNonBreakingSpaces(page.intro)}</p>
		</div>

		{page.sections.map(({ title, text }, k) => (
			<section
				aria-labelledby={`sovereignty-${k + 1}`}
				class="grid gap-x-16 gap-y-4 border-t border-line-strong pt-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]"
			>
				<h2 id={`sovereignty-${k + 1}`} class="text-[clamp(1.6rem,3vw,2.2rem)] leading-[1.15]">
					{withNonBreakingSpaces(title)}
				</h2>
				<div class="grid content-start gap-6">
					<p class="text-foreground-secondary">{withNonBreakingSpaces(text)}</p>
					{k === last && (
						<div>
							<BookingButton text={page.cta} />
						</div>
					)}
				</div>
			</section>
		))}
	</main>
</Base>
