---
// A página principal: as secções pela ordem da #54, com o ticket que traz cada uma.
// Cada secção fica no seu lugar, separada das outras por uma linha em branco,
// para que os PR que acrescentam secções diferentes não entrem em conflito.
import { type Lingua } from '../config/site';
import { valores } from '../config/valores';
import { dicionarios } from '../i18n';
import Base from '../layouts/Base.astro';
import BotaoPausa from './BotaoPausa.astro';
import CtaFinal from './CtaFinal';
import Garantia from './Garantia';
import Hero from './Hero';
import HojeEDepois from './HojeEDepois';
import ParaQuem from './ParaQuem';
import Pontos from './Pontos.astro';
import Quem from './Quem.astro';

interface Props {
	lingua: Lingua;
}

const { lingua } = Astro.props;
const t = dicionarios[lingua];
---

<Base
	lingua={lingua}
	titulo={`${valores.nome} · ${t.designacao}`}
	descricao={t.paginaPrincipal.descricao}
>
	<main>
		{/* O botão de pausa é o primeiro foco depois do cabeçalho: para tudo antes de ler. */}
		<Pontos />
		<BotaoPausa {...t.animacao} />

		<Hero
			designacao={t.designacao}
			promessa={t.promessa}
			textoDoBotao={t.botaoMarcar}
			{...t.paginaPrincipal.hero}
		/>

		<ParaQuem textoDoBotao={t.botaoMarcar} {...t.paginaPrincipal.paraQuem} />

		<HojeEDepois {...t.paginaPrincipal.hojeEDepois} />

		{/* Serviços (#64) */}

		{/* Etapas (#65) */}

		<Garantia {...t.paginaPrincipal.garantia} />

		{/* Gráfico de fornecedores cloud (#66) */}

		<Quem designacao={t.designacao} {...t.paginaPrincipal.quem} />

		{/* Testemunhos (#67) */}

		{/* Ecologia (#68) */}

		{/* Perguntas (#70) */}

		<CtaFinal lingua={lingua} textoDoBotao={t.botaoMarcar} {...t.paginaPrincipal.ctaFinal} />
	</main>
</Base>
