---
// As 5 Etapas, da Conversa à Entrega e transferência: o que acontece depois de marcar.
// No computador, a secção fica presa enquanto o scroll passa pelas Etapas, cerca de meio ecrã
// cada uma. No telemóvel, com movimento reduzido e sem JS, é uma lista que se lê de seguida.
interface Props {
	title: string;
	steps: { name: string; sentence: string }[];
}

const { title, steps } = Astro.props;
---

<section
	aria-labelledby="steps-title"
	data-section="steps"
	data-steps
	style={`--step-count: ${steps.length}`}
>
	<div data-stage>
		<div class="page-width grid gap-12 py-[clamp(5rem,11vw,9rem)]">
			<h2 id="steps-title" class="text-[clamp(2.1rem,4.4vw,3.4rem)] leading-[1.06]">
				{title}
			</h2>
			{/* No telemóvel, uma Etapa por linha, com o número à esquerda. A partir de 961 px, cinco
			    colunas em degraus, cada uma um pouco mais abaixo do que a anterior. */}
			<ol class="grid gap-6 min-[961px]:grid-cols-5 min-[961px]:gap-8">
				{steps.map(({ name, sentence }, k) => (
					<li
						data-step
						style={`--k: ${k}`}
						class="grid grid-cols-[3rem_1fr] gap-x-4 gap-y-2 min-[961px]:grid-cols-1 min-[961px]:content-start min-[961px]:pt-[calc(var(--k)*1.25rem)]"
					>
						<span
							data-number
							class="row-span-2 font-heading text-[2.6rem] leading-none text-green min-[961px]:row-span-1"
						>
							{k + 1}
						</span>
						<strong class="font-semibold min-[961px]:border-t min-[961px]:border-line-strong min-[961px]:pt-3">
							{name}
						</strong>
						<span class="text-[0.9375rem] text-foreground-secondary">{sentence}</span>
					</li>
				))}
			</ol>
		</div>
	</div>
</section>

<script>
	import { afterLoad } from '../scripts/after-load';

	/** O computador, como nos Serviços (#54): mais de 960 px e sem movimento reduzido. */
	const DESKTOP = '(min-width: 961px) and (prefers-reduced-motion: no-preference)';

	afterLoad(() => {
		const desktop = matchMedia(DESKTOP);

		for (const section of document.querySelectorAll<HTMLElement>('[data-steps]')) {
			const stage = section.querySelector<HTMLElement>('[data-stage]')!;
			const steps = [...section.querySelectorAll<HTMLElement>('[data-step]')];
			let pendingFrame = 0;

			// Com a secção presa, o percurso vai de 0 (o palco prende) a 1 (solta). Cada Etapa tem
			// a sua fatia do percurso e chega a meio dela, em (k + 0,5) / 5: o número acende.
			// O ramo (#73) vai acender os números quando chega, com esta mesma conta; com a secção
			// solta (telemóvel, movimento reduzido, ecrã baixo), os números ficam sempre acesos.
			const lightUp = () => {
				pendingFrame = 0;
				if (!section.hasAttribute('data-pinned')) return;
				const { top, height } = section.getBoundingClientRect();
				const stageTop = parseFloat(getComputedStyle(stage).top);
				const progress = (stageTop - top) / (height - stage.offsetHeight);
				for (const [k, step] of steps.entries()) {
					step.toggleAttribute('data-reached', progress >= (k + 0.5) / steps.length);
				}
			};

			// Presa, as Etapas têm de caber no palco, por baixo do cabeçalho; num ecrã baixo ou com
			// zoom, não cabem, e a secção fica solta para nada ficar escondido.
			const pin = () => {
				section.toggleAttribute('data-pinned', desktop.matches);
				const content = stage.firstElementChild as HTMLElement;
				if (content.offsetHeight > stage.clientHeight) section.removeAttribute('data-pinned');
				lightUp();
			};

			desktop.addEventListener('change', pin);
			addEventListener('resize', pin);
			addEventListener('scroll', () => (pendingFrame ||= requestAnimationFrame(lightUp)), {
				passive: true,
			});
			pin();
		}
	});
</script>

<style>
	/* Presa: a secção ganha meio ecrã de altura por Etapa, e o palco fica parado por baixo do
	   cabeçalho enquanto ela passa. */
	[data-pinned] {
		height: calc(100svh - var(--header-height) + var(--step-count) * 50svh);
	}
	[data-pinned] [data-stage] {
		position: sticky;
		top: var(--header-height);
		display: grid;
		align-content: center;
		height: calc(100svh - var(--header-height));
	}
	/* O palco centra as Etapas: o espaço por cima e por baixo vem dele, não do padding. */
	[data-pinned] [data-stage] > * {
		padding-block: 0;
	}

	/* Presa, cada número fica apagado até a sua Etapa chegar. O cinzento das linhas fortes tem
	   3,5:1 com o fundo, que chega para um número deste tamanho (WCAG 1.4.3, texto grande). */
	[data-pinned] [data-number] {
		color: var(--color-line-strong);
		transition: color 0.35s ease;
	}
	[data-pinned] [data-reached] [data-number] {
		color: var(--color-green);
	}
</style>
