---
// The 5 Steps, from the Conversation to Delivery and handover: what happens after booking.
// On desktop, the section stays pinned while the scroll goes through the Steps, about half a screen
// each. On mobile, with reduced motion and without JS, it is a list read straight through.
interface Props {
	title: string;
	steps: { name: string; sentence: string }[];
}

const { title, steps } = Astro.props;
---

<section
	aria-labelledby="steps-title"
	data-section="steps"
	data-steps
	style={`--step-count: ${steps.length}`}
>
	<div data-stage>
		<div class="page-width grid gap-12 py-[clamp(5rem,11vw,9rem)]">
			<h2 id="steps-title" data-reveal class="text-[clamp(2.1rem,4.4vw,3.4rem)] leading-[1.06]">
				{title}
			</h2>
			{/* On mobile, one Step per row, with the number on the left. From 961 px, five
			    staggered columns, each one a little lower than the one before. */}
			<ol class="grid gap-6 min-[961px]:grid-cols-5 min-[961px]:gap-8">
				{steps.map(({ name, sentence }, k) => (
					<li
						data-step
						style={`--k: ${k}`}
						class="grid grid-cols-[3rem_1fr] gap-x-4 gap-y-2 min-[961px]:grid-cols-1 min-[961px]:content-start min-[961px]:pt-[calc(var(--k)*1.25rem)]"
					>
						<span
							data-number
							class="row-span-2 font-heading text-[2.6rem] leading-none text-green min-[961px]:row-span-1"
						>
							{k + 1}
						</span>
						<strong class="font-semibold min-[961px]:border-t min-[961px]:border-line-strong min-[961px]:pt-3">
							{name}
						</strong>
						<span class="text-[0.9375rem] text-foreground-secondary">{sentence}</span>
					</li>
				))}
			</ol>
		</div>
	</div>
</section>

<script>
	import { afterLoad } from '../scripts/after-load';
	import { DESKTOP } from '../scripts/desktop';
	import { GROWTH_LINE } from '../scripts/growth-line';

	afterLoad(() => {
		const desktop = matchMedia(DESKTOP);
		const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

		for (const section of document.querySelectorAll<HTMLElement>('[data-steps]')) {
			const stage = section.querySelector<HTMLElement>('[data-stage]')!;
			const steps = [...section.querySelectorAll<HTMLElement>('[data-step]')];
			const numbers = steps.map((step) => step.querySelector<HTMLElement>('[data-number]')!);
			let pendingFrame = 0;

			// Each Step shows once the branch reaches its node, and hides again when the branch shrinks back.
			// Pinned, the progress goes from 0 (the stage pins) to 1 (it unpins); each Step has its own slice
			// of it, and the branch reaches its node at the slice's middle, (k + 0.5) / 5. Unpinned, the node
			// is by its number, and the branch's tip follows the growth line. With reduced motion, the branch
			// is whole: every Step shows.
			const showReached = () => {
				pendingFrame = 0;
				let reached: boolean[];
				if (section.hasAttribute('data-pinned')) {
					const { top, height } = section.getBoundingClientRect();
					const stageTop = parseFloat(getComputedStyle(stage).top);
					const progress = (stageTop - top) / (height - stage.offsetHeight);
					reached = steps.map((_, k) => progress >= (k + 0.5) / steps.length);
				} else {
					const line = innerHeight * GROWTH_LINE;
					reached = numbers.map((number) => {
						const { top, height } = number.getBoundingClientRect();
						return reducedMotion.matches || top + height / 2 < line;
					});
				}
				for (const [k, step] of steps.entries()) step.toggleAttribute('data-pending', !reached[k]);
			};

			// When pinned, the Steps must fit in the stage, below the header; on a short screen or when
			// zoomed in, they do not fit, and the section stays unpinned so nothing is hidden.
			const pin = () => {
				section.toggleAttribute('data-pinned', desktop.matches);
				const content = stage.firstElementChild as HTMLElement;
				if (content.offsetHeight > stage.clientHeight) section.removeAttribute('data-pinned');
				showReached();
			};

			desktop.addEventListener('change', pin);
			reducedMotion.addEventListener('change', pin);
			addEventListener('resize', pin);
			addEventListener('scroll', () => (pendingFrame ||= requestAnimationFrame(showReached)), {
				passive: true,
			});
			pin();
		}
	});
</script>

<style>
	/* Pinned: the section gains half a screen of height per Step, and the stage stays still below the
	   header while the section scrolls past. */
	[data-pinned] {
		height: calc(100svh - var(--header-height) + var(--step-count) * 50svh);
	}
	[data-pinned] [data-stage] {
		position: sticky;
		top: var(--header-height);
		display: grid;
		align-content: center;
		height: calc(100svh - var(--header-height));
	}
	/* The stage centers the Steps: the space above and below comes from it, not from the padding. */
	[data-pinned] [data-stage] > * {
		padding-block: 0;
	}

	/* A Step fades in as the branch reaches it, and out as the branch shrinks back. */
	[data-step] {
		transition: opacity 0.6s ease;
	}
</style>
