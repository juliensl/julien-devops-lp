---
// O seletor de língua: FR · EN · PT, só com as línguas publicadas, gerado no build e sem JS.
// Cada ligação leva à mesma página na outra língua e diz o nome completo aos leitores de ecrã.
// A língua atual fica marcada e não é uma ligação. Sem bandeiras.
import { HTML_CODES, PHASE, LANGUAGE_NAMES, type Language } from '../config/site';
import { pathInLanguage } from '../lib/paths';

interface Props {
	language: Language;
	/** O nome do seletor, na língua da página. */
	label: string;
	/** No menu do telemóvel: letras e alvos de toque maiores. */
	large?: boolean;
	class?: string;
}

const { language, label, large = false, class: className } = Astro.props;
const path = Astro.url.pathname;
const tapTarget = large ? 'min-h-11 min-w-11' : 'min-h-7 min-w-7';
---

<nav aria-label={label} class={className}>
	<ul
		class:list={['flex items-center tracking-[0.06em]', large ? 'text-base' : 'text-[0.8125rem]']}
	>
		{PHASE.publishedLanguages.map((l, i) => (
			<li class="flex items-center">
				{i > 0 && (
					<span aria-hidden="true" class="px-0.5 text-foreground-secondary">
						·
					</span>
				)}
				{l === language ? (
					<span
						aria-current="true"
						lang={HTML_CODES[l]}
						class:list={[
							tapTarget,
							'inline-flex items-center justify-center text-foreground underline decoration-green decoration-2 underline-offset-4',
						]}
					>
						{l.toUpperCase()}
						<span class="sr-only">, {LANGUAGE_NAMES[l]}</span>
					</span>
				) : (
					<a
						href={pathInLanguage(path, language, l)}
						hreflang={l}
						lang={HTML_CODES[l]}
						class:list={[
							tapTarget,
							'inline-flex items-center justify-center rounded-md text-foreground-secondary transition-colors hover:bg-surface-2 hover:text-foreground',
						]}
					>
						{l.toUpperCase()}
						<span class="sr-only">, {LANGUAGE_NAMES[l]}</span>
					</a>
				)}
			</li>
		))}
	</ul>
</nav>
