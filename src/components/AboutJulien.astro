---
// "Quem é o Julien" (#63): the photo, the only image on the page, natural and in color, with the
// name and the Designation as visible text. No colored band: the branch (#73) goes halfway round
// the photo's top arch and runs down to the end of the section.
// It is an .astro component because `<Image>` optimizes the image at build time, and a TSX can't use it.
import { Image } from 'astro:assets';
import photo from '../../data/IMG_2030.png';
import { values } from '../config/values';
import { withNonBreakingSpaces } from '../lib/spaces';
import LinkedInLogo from './LinkedInLogo.astro';

interface Props {
	title: string;
	designation: string;
	/** Where and how he works: remotely, the languages, standard technologies and everything documented. */
	wayOfWorking: string;
	/** The text of the link to his LinkedIn profile. */
	linkedin: string;
}

const { title, designation, wayOfWorking, linkedin } = Astro.props;
---

<section
	aria-labelledby="about-title"
	data-section="about"
	class="page-width grid items-center gap-x-20 gap-y-12 py-[clamp(5rem,10vw,8rem)] lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)]"
>
	{/* Far from the top: it only loads when the Visitor gets there. */}
	<Image
		src={photo}
		alt={values.name}
		width={560}
		format="avif"
		quality={55}
		loading="lazy"
		decoding="async"
		class="aspect-4/5 w-full max-w-72 rounded-[999px_999px_14px_14px] object-cover lg:max-w-none"
	/>
	<div class="grid gap-6">
		<h2 id="about-title" class="label font-body">
			{title}
		</h2>
		<div class="grid gap-2">
			<p class="font-heading text-[clamp(2.1rem,4.4vw,3.4rem)] leading-[1.06]">{values.name}</p>
			<p class="text-lg text-purple">{designation}</p>
		</div>
		<p class="max-w-2xl font-heading text-[clamp(1.4rem,2.6vw,2rem)] leading-snug">
			{withNonBreakingSpaces(wayOfWorking)}
		</p>
		<a
			href={values.linkedin}
			class="inline-flex min-h-11 items-center gap-2 justify-self-start font-semibold text-purple underline-offset-3 hover:underline"
		>
			<LinkedInLogo size={18} />
			{linkedin}
		</a>
		{/* The proof (career, projects, clients) goes here once it exists (#54). */}
	</div>
</section>
