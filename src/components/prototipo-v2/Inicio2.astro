---
// PROTÓTIPO v2 · 2 «Painel aberto» (evolução da B). Cartões numa grelha de
// tamanhos variados que ocupa a largura toda; Hero em duas metades com as 5 etapas
// (o pull request saiu, a pedido do Julien); mini-diagramas animados nos blocos.
import { Image } from 'astro:assets';
import foto from '../../../data/IMG_2030.png';
import Folha from './Folha.astro';
import DiagramaBloco from './DiagramaBloco.astro';
import GraficoCloud from './GraficoCloud.astro';
import Garantia from './Garantia.astro';
import FaqResumo from './FaqResumo.astro';
import Testemunhos from './Testemunhos.astro';
import { calendly, textos, problemas, paraQuem, blocos, notaBlocos, etapas, type Modo } from './dados';
import { ligacao } from './temas';

interface Props {
	modo: Modo;
}
const { modo } = Astro.props;
const promessaH1 = textos.promessa.replace('entrego-te', '<span style="white-space:nowrap">entrego-te</span>');
---

<div class="i2">
	<section class="largura hero" id="p2-topo">
		<div class="hero-texto">
			<p class="chip-desig"><span class="ponto"></span>{textos.designacao}</p>
			<h1 set:html={promessaH1} />
			<p class="lead">{textos.subPromessa}</p>
			<div class="acao">
				<a class="botao grande" href={calendly}>{textos.cta}</a>
				<span class="nota">{textos.notaCta}</span>
			</div>
		</div>
		<div class="hero-lado">
			<ol class="cartao etapas-hero" aria-label="Como corre uma colaboração">
				{
					etapas.map((e, i) => (
						<li>
							<span class="n-etapa">{i + 1}</span>
							<span class="et-texto">
								<strong>{e.nome}</strong>
								<span>{e.texto}</span>
							</span>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="largura bento-topo">
		<article class="cartao para-quem">
			<p class="etiqueta">Para quem é</p>
			<ul>
				{paraQuem.map((x) => <li>{x}</li>)}
			</ul>
		</article>
		<article class="cartao problemas">
			<p class="etiqueta">O que costuma acontecer</p>
			<ul>
				{
					problemas.map((p) => (
						<li>
							<strong>{p.titulo}</strong> {p.texto}
						</li>
					))
				}
			</ul>
		</article>
		<article class="cartao numero">
			<p class="grande">30</p>
			<p>dias, no máximo, para qualquer combinação de blocos</p>
		</article>
	</section>

	<section class="largura servicos" id="p2-servicos">
		<div class="cab-seccao">
			<h2>Quatro blocos, os que precisares.</h2>
			<p class="intro">{notaBlocos}</p>
		</div>
		<div class="bento">
			{
				blocos.map((b) => (
					<article class={`cartao bloco b${b.n}`}>
						<DiagramaBloco n={b.n as 1 | 2 | 3 | 4} />
						<div class="bloco-texto">
							<p class="num">Bloco {b.n}</p>
							<h3>{b.nome}</h3>
							<p>{b.texto}</p>
							<p class="ferr">
								{b.ferramentas.map((f) => (
									<span>{f}</span>
								))}
							</p>
						</div>
					</article>
				))
			}
		</div>
	</section>


	<section class="largura" id="p2-garantia">
		<div class="cartao garantia">
			<Garantia formato="cartao" />
		</div>
	</section>

	<section class="largura">
		<GraficoCloud p={2} />
	</section>

	<section class="largura quem" id="p2-quem">
		<div class="cartao quem-cartao">
			<Image src={foto} alt={textos.fotoAlt} width={560} format="avif" quality={55} loading="lazy" class="foto" />
			<div class="quem-texto">
				<h2 class="h-pequeno">Quem é o Julien</h2>
				<p class="frase">{textos.quem}</p>
			</div>
		</div>
		<Testemunhos p={2} class="cartao" />
		<a class="cartao eco" href={ligacao(modo, 2, 'ecologia')}>
			<Folha tamanho={26} />
			<strong>Ecologia e infraestrutura</strong>
			<span>Estima a energia e as emissões de uma carga, conforme o país onde corre.</span>
		</a>
	</section>

	<section class="largura" id="p2-faq">
		<FaqResumo p={2} modo={modo} />
	</section>

	<section class="largura">
		<div class="cartao final">
			<h2>{textos.finalTitulo}</h2>
			<p class="intro">{textos.finalTexto}</p>
			<div class="acao">
				<a class="botao grande" href={calendly}>{textos.cta}</a>
				<span class="nota">{textos.notaLingua}</span>
			</div>
		</div>
	</section>
</div>


<style>
	.i2 > section {
		padding-block: 3.5rem 0;
	}
	h1 {
		font-size: clamp(2.3rem, 4.1vw, 3.6rem);
		line-height: 1.05;
	}
	h2 {
		font-size: clamp(2rem, 4vw, 2.8rem);
		line-height: 1.08;
	}
	.h-pequeno {
		font-size: clamp(1.6rem, 3vw, 2.1rem);
	}
	h3 {
		font-size: 1.35rem;
		line-height: 1.2;
	}
	.lead,
	.intro {
		color: var(--muted);
		max-width: 38rem;
	}
	.lead {
		font-size: 1.1875rem;
	}
	.nota {
		font-size: 0.875rem;
		color: var(--muted);
	}
	.cartao {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--raio);
		padding: 1.5rem;
		--fundo-ga: var(--surface);
	}
	.num {
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--acento);
	}
	/* Hero */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		gap: 3rem 4rem;
		align-items: center;
		padding-top: 4.5rem !important;
	}
	.hero-texto {
		display: grid;
		gap: 1.25rem;
		justify-items: start;
	}
	.chip-desig {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.85rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--surface);
		font-size: 0.875rem;
		color: var(--muted);
	}
	.ponto {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--verde);
	}
	.acao {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
	}
	.hero-lado {
		display: grid;
		gap: 0.75rem;
	}
	.etapas-hero {
		list-style: none;
		margin: 0;
		display: grid;
		gap: 0;
		padding: 0.5rem 1.25rem;
		counter-reset: etapa;
	}
	.etapas-hero li {
		display: grid;
		grid-template-columns: 32px 1fr;
		gap: 0.85rem;
		padding-block: 0.85rem;
		position: relative;
	}
	.etapas-hero li + li {
		border-top: 1px solid var(--line);
	}
	.n-etapa {
		width: 32px;
		height: 32px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		border: 1px solid var(--verde);
		color: var(--verde);
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
	}
	.etapas-hero li:nth-child(4) .n-etapa {
		background: var(--verde);
		color: var(--bg);
		font-weight: 600;
	}
	.et-texto {
		display: grid;
		gap: 0.1rem;
	}
	.et-texto span {
		font-size: 0.875rem;
		color: var(--muted);
	}
	/* Faixa de cartões */
	.bento-topo {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) minmax(0, 3fr);
		gap: 1rem;
	}
	.bento-topo ul {
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
	}
	.para-quem li::before {
		content: '';
		display: inline-block;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--verde);
		margin-right: 0.55rem;
		vertical-align: 0.1em;
	}
	.problemas ul {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem 1.5rem;
	}
	.problemas li {
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.problemas strong {
		display: block;
		color: var(--text);
		font-weight: 600;
	}
	.numero {
		background: var(--surface-verde);
		border-color: var(--verde-forte);
		display: grid;
		align-content: center;
		gap: 0.25rem;
	}
	.numero .grande {
		font: 400 4.5rem/1 var(--serif);
		color: var(--verde);
	}
	/* Serviços */
	.servicos {
		display: grid;
		gap: 1.75rem;
	}
	.cab-seccao {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 0.75rem 3rem;
		align-items: end;
	}
	.bento {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 1rem;
	}
	.bloco {
		display: grid;
		gap: 1rem;
		align-content: start;
	}
	.b1 {
		grid-column: span 4;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		align-items: center;
	}
	.b2 {
		grid-column: span 2;
	}
	.b3 {
		grid-column: span 2;
	}
	.b4 {
		grid-column: span 4;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		align-items: center;
	}
	.b4 :global(.diag) {
		order: 2;
	}
	.bloco-texto {
		display: grid;
		gap: 0.5rem;
	}
	.bloco-texto > p:not(.num):not(.ferr) {
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.ferr {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.25rem;
	}
	.ferr span {
		font-size: 0.8125rem;
		padding: 0.15rem 0.6rem;
		border-radius: 8px;
		background: var(--surface-2);
		color: var(--verde);
	}
	.garantia {
		padding: clamp(1.25rem, 3vw, 2.25rem);
	}
	/* Quem */
	.quem {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: 1rem;
	}
	.quem-cartao {
		grid-row: span 2;
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
		gap: 1.5rem;
		align-items: center;
	}
	.foto {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: calc(var(--raio) - 6px);
	}
	.quem-texto {
		display: grid;
		gap: 0.75rem;
	}
	.frase {
		font: 400 1.25rem/1.4 var(--serif);
	}
	.eco {
		display: grid;
		gap: 0.6rem;
		align-content: start;
		text-decoration: none;
		color: var(--verde);
		background: var(--surface-verde);
		border-color: var(--verde-forte);
		transition: transform 0.15s ease;
	}
	.eco:hover {
		transform: translateY(-3px);
	}
	.eco strong {
		font: 400 1.35rem/1.15 var(--serif);
		color: var(--text);
	}
	.eco span {
		color: var(--text);
		font-size: 0.9375rem;
	}
	/* Final */
	.final {
		display: grid;
		gap: 1.25rem;
		justify-items: start;
		padding: clamp(1.5rem, 5vw, 3.5rem);
		background:
			radial-gradient(circle at 85% 20%, rgb(146 214 173 / 0.14), transparent 45%),
			linear-gradient(140deg, var(--surface-2), var(--surface) 65%);
	}
	.final h2 {
		font-size: clamp(2.3rem, 5vw, 3.6rem);
	}
	@media (max-width: 1080px) {
		.bento-topo {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
		.problemas {
			grid-column: 1 / -1;
			grid-row: 1;
		}
		.quem {
			grid-template-columns: 1fr;
		}
		.quem-cartao {
			grid-row: auto;
		}
	}
	@media (max-width: 960px) {
		.hero,
		.cab-seccao {
			grid-template-columns: 1fr;
		}
		.bento {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
		.b1,
		.b4 {
			grid-column: 1 / -1;
		}
		.b2,
		.b3 {
			grid-column: span 1;
		}
	}
	@media (max-width: 640px) {
		.bento-topo,
		.bento,
		.quem,
		.quem-cartao,
		.problemas ul {
			grid-template-columns: 1fr;
		}
		.b1,
		.b4 {
			grid-template-columns: 1fr;
		}
		.b4 :global(.diag) {
			order: 0;
		}
		.foto {
			max-width: 18rem;
		}
	}
</style>
