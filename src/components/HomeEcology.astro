---
// The home page's Ecology section (#68): a short text and the link to the ecology page.
import type { Language } from '../config/site';
import { dictionaries } from '../i18n';
import { ecologyPath } from '../lib/paths';
import { withNonBreakingSpaces } from '../lib/spaces';
import FlowingLeaf from './FlowingLeaf.astro';
import Leaf from './Leaf.astro';

interface Props {
	language: Language;
}

const { language } = Astro.props;
const { link, home } = dictionaries[language].ecology;
---

<section
	aria-labelledby="ecology-title"
	class="page-width grid gap-x-16 gap-y-8 py-[clamp(5rem,10vw,8rem)] lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:items-center"
>
	<div class="grid justify-items-start gap-5">
		<p class="label flex items-center gap-2">
			<Leaf size={16} /> {link}
		</p>
		<h2 id="ecology-title" class="text-[clamp(2.1rem,4.4vw,3.4rem)] leading-[1.06]">
			{withNonBreakingSpaces(home.title)}
		</h2>
		<p class="max-w-[46rem] text-[1.0625rem] text-foreground-secondary">
			{withNonBreakingSpaces(home.text)}
		</p>
		<a
			href={ecologyPath(language)}
			class="inline-flex min-h-11 items-center gap-2 font-semibold text-green underline-offset-3 hover:underline"
		>
			<Leaf size={18} />
			{home.link}
		</a>
	</div>

	<FlowingLeaf class="max-w-80 justify-self-center" />
</section>
