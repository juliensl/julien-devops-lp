---
// PROTOTYPE (throwaway, branch prototype/dotted-logo): the dotted ∞ traced once by a pen, and three
// layouts of the name in Geist, switched with ?variant=A|B|C (see LogoPrototypeSwitcher.astro).
import { values } from '../config/values';

const [first, last] = values.name.split(' ');
---

<span data-logo class="inline-flex items-center gap-3">
	<canvas data-logo-infinity aria-hidden="true" class="aspect-2/1 h-10 lg:h-12"></canvas>

	{/* A: two lines, uppercase and spaced, like Julien's image. */}
	<span data-variant="A" class="flex flex-col gap-1 leading-none max-lg:sr-only">
		<span class="text-[0.9375rem] font-semibold tracking-[0.22em] text-foreground uppercase">{first}</span>
		<span class="text-[0.9375rem] font-normal tracking-[0.22em] text-purple uppercase">{last}</span>
	</span>

	{/* B: one line, as written. */}
	<span data-variant="B" class="text-[1.1875rem] leading-none font-semibold tracking-[-0.01em] max-lg:sr-only">
		<span class="text-foreground">{first}</span>{' '}
		<span class="font-normal text-foreground-secondary">{last}</span>
	</span>

	{/* C: one line, uppercase, small and widely spaced. */}
	<span data-variant="C" class="text-[0.8125rem] leading-none font-medium tracking-[0.3em] uppercase max-lg:sr-only">
		<span class="text-foreground">{first}</span>{' '}
		<span class="text-purple">{last}</span>
	</span>
</span>

<script is:inline>
	{
		const variant = new URLSearchParams(location.search).get('variant') ?? 'A';
		for (const name of document.querySelectorAll('[data-logo] [data-variant]')) {
			if (name.dataset.variant !== variant) name.remove();
		}
	}
</script>

<script>
	import { afterLoad } from '../scripts/after-load';
	import { glow } from '../scripts/glow';

	type Point = [x: number, y: number, z: number];

	const TAU = Math.PI * 2;
	const POINT_COUNT = 170;
	/** The pen starts where the two loops cross and runs one lap in this many seconds. */
	const START = Math.PI / 2;
	const DURATION = 1.8;
	/** How long a point takes to light up once the pen has passed it, in radians of the curve. */
	const FADE = 0.6;
	/** The Hero's resting tilt. */
	const PITCH = 0.5;
	const YAW = -0.4;

	afterLoad(() => {
		const canvas = document.querySelector<HTMLCanvasElement>('[data-logo-infinity]');
		if (canvas) start(canvas);
	});

	function start(canvas: HTMLCanvasElement) {
		const context = canvas.getContext('2d')!;
		const styles = getComputedStyle(canvas);
		const purpleLine = styles.getPropertyValue('--color-element-purple').trim();
		const greenLine = styles.getPropertyValue('--color-element-green').trim();
		const [purple, green, white] = [glow(purpleLine), glow(greenLine), glow('#ffffff')];
		const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const particles = Array.from({ length: POINT_COUNT }, (_, i) => ({
			// Offset from the pen's start, so a point lights up when the pen reaches it.
			along: (i / POINT_COUNT) * TAU,
			radius: Math.sqrt(Math.random()) * 0.08,
			phase: Math.random() * TAU,
			size: 0.55 + Math.random() * 0.95,
		}));

		let ratio = 1;
		let width = 0;
		let height = 0;
		let startedAt = 0;
		let pen = reducedMotion ? TAU : 0;

		const fit = () => {
			// The ∞ fills the box: its projected size at scale 1, with room for the glow.
			const xs: number[] = [];
			const ys: number[] = [];
			for (let i = 0; i < 200; i++) {
				const { x, y } = projected(curve((i / 200) * TAU));
				xs.push(x);
				ys.push(y);
			}
			const spanX = Math.max(...xs) - Math.min(...xs);
			const spanY = Math.max(...ys) - Math.min(...ys);
			const scale = Math.min(width / (spanX + 0.2), height / (spanY + 0.2));
			const centreX = width / 2 - ((Math.max(...xs) + Math.min(...xs)) / 2) * scale;
			const centreY = height / 2 - ((Math.max(...ys) + Math.min(...ys)) / 2) * scale;
			return { scale, project: (point: Point) => {
				const p = projected(point);
				return { x: centreX + p.x * scale, y: centreY + p.y * scale, depth: p.depth, perspective: p.perspective };
			} };
		};

		function draw() {
			context.setTransform(ratio, 0, 0, ratio, 0, 0);
			context.clearRect(0, 0, width, height);
			const { scale, project } = fit();

			// The faint line, drawn behind the pen.
			context.globalCompositeOperation = 'source-over';
			context.globalAlpha = 0.35;
			context.lineWidth = 0.9;
			const steps = Math.ceil((pen / TAU) * 160);
			let last = project(curve(START));
			for (let i = 1; i <= steps; i++) {
				const t = START + (i / steps) * pen;
				const next = project(curve(t));
				context.beginPath();
				context.moveTo(last.x, last.y);
				context.lineTo(next.x, next.y);
				context.strokeStyle = curve(t)[0] < 0 ? purpleLine : greenLine;
				context.stroke();
				last = next;
			}

			// The points the pen has passed, lighting up.
			context.globalCompositeOperation = 'lighter';
			const baseSize = scale * 0.065;
			for (const { along, radius, phase, size } of particles) {
				const lit = Math.min(Math.max((pen - along) / FADE, 0), 1);
				if (lit === 0) continue;
				const t = START + along;
				const [x, y, z] = curve(t);
				const ahead = curve(t + 0.002);
				const length = Math.hypot(ahead[0] - x, ahead[1] - y, ahead[2] - z) || 1;
				const [tx, ty, tz] = [(ahead[0] - x) / length, (ahead[1] - y) / length, (ahead[2] - z) / length];
				const flat = Math.hypot(tx, ty) || 1;
				const [nx, ny] = [-ty / flat, tx / flat];
				const along2 = Math.cos(phase) * radius;
				const across = Math.sin(phase) * radius;
				const p = project([
					x + along2 * nx - across * tz * ny,
					y + along2 * ny + across * tz * nx,
					z + across * (tx * ny - ty * nx),
				]);
				const nearness = Math.min(Math.max(0.3 + (p.depth + 1.2) * 0.32, 0.2), 1);
				// A point just reached is a little bigger, then settles.
				const r = baseSize * size * p.perspective * (1 + (1 - lit) * 0.8);
				const greenShare = Math.min(Math.max((x + 0.12) / 0.24, 0), 1);
				for (const [sprite, share] of [
					[purple, 1 - greenShare],
					[green, greenShare],
				] as const) {
					if (share < 0.02) continue;
					context.globalAlpha = nearness * share * lit;
					context.drawImage(sprite, p.x - r, p.y - r, r * 2, r * 2);
				}
			}

			// The pen's head, fading out once the lap is closed.
			const elapsed = startedAt ? (performance.now() - startedAt) / 1000 : Infinity;
			const headAlpha = pen < TAU ? 1 : Math.max(1 - (elapsed - DURATION) / 0.35, 0);
			if (headAlpha > 0 && !reducedMotion) {
				const head = project(curve(START + pen));
				const r = baseSize * 3.2;
				context.globalAlpha = headAlpha;
				context.drawImage(white, head.x - r, head.y - r, r * 2, r * 2);
			}
			context.globalAlpha = 1;
			return headAlpha > 0;
		}

		function frame(now: number) {
			const t = Math.min((now - startedAt) / 1000 / DURATION, 1);
			pen = TAU * (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
			const stillDrawing = draw();
			if (t < 1 || stillDrawing) requestAnimationFrame(frame);
		}

		function play() {
			if (reducedMotion) return draw();
			startedAt = performance.now();
			pen = 0;
			requestAnimationFrame(frame);
		}

		new ResizeObserver(() => {
			ratio = Math.min(devicePixelRatio || 1, 3);
			width = canvas.clientWidth;
			height = canvas.clientHeight;
			canvas.width = Math.round(width * ratio);
			canvas.height = Math.round(height * ratio);
			draw();
		}).observe(canvas);

		document.addEventListener('logo-replay', play);
		play();
	}

	/** The Hero's lemniscate of Bernoulli with depth. */
	function curve(t: number): Point {
		const sin = Math.sin(t);
		const cos = Math.cos(t);
		const d = 1 + sin * sin;
		return [cos / d, (sin * cos) / d, 0.3 * sin];
	}

	/** The Hero's projection, at its resting tilt. */
	function projected([x, y, z]: Point) {
		const turnedX = x * Math.cos(YAW) + z * Math.sin(YAW);
		const turnedZ = -x * Math.sin(YAW) + z * Math.cos(YAW);
		const tiltedY = y * Math.cos(PITCH) - turnedZ * Math.sin(PITCH);
		const depth = y * Math.sin(PITCH) + turnedZ * Math.cos(PITCH);
		const perspective = 3 / (3 - depth);
		return { x: turnedX * perspective, y: tiltedY * perspective, depth, perspective };
	}
</script>
