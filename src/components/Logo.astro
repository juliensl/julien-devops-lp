---
// The logo: the dotted ∞ and the name. On each page load a pen traces the ∞ once; without JS or with
// reduced motion it is already formed. A link around it takes its accessible name from the hidden text.
import { values } from '../config/values';
import { HEIGHT, PEN_SIZE, WIDTH, dots, lines } from '../scripts/logo-infinity';

const [first, last] = values.name.split(' ');
const [purpleLine, greenLine] = lines(Math.PI * 2);
// Each point in purple, green or both, as much of each as its place on the ∞ gives.
const circles = dots().flatMap(({ green, brightness, ...dot }) =>
	(
		[
			['purple', 1 - green],
			['green', green],
		] as const
	)
		.filter(([, share]) => share >= 0.02)
		.map(([color, share]) => ({
			...dot,
			color,
			opacity: Math.round(brightness * share * 100) / 100,
		})),
);
const GLOWS = [
	['purple', 'var(--color-element-purple)'],
	['green', 'var(--color-element-green)'],
	['white', '#fff'],
];
---

<span class="inline-flex items-center gap-3">
	<svg
		data-logo-infinity
		aria-hidden="true"
		viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
		width={WIDTH}
		height={HEIGHT}
		class="isolate h-8.5 w-auto overflow-visible lg:h-10"
	>
		<defs>
			{/* The Hero's glowing point: white at the centre. */}
			{GLOWS.map(([name, color]) => (
				<radialGradient id={`logo-${name}`}>
					<stop offset="0" stop-color="#fff" stop-opacity="0.95" />
					<stop offset="0.16" style={`stop-color: ${color}`} />
					<stop offset="0.42" style={`stop-color: ${color}`} stop-opacity="0.28" />
					<stop offset="1" style={`stop-color: ${color}`} stop-opacity="0" />
				</radialGradient>
			))}
		</defs>
		<g fill="none" stroke-opacity="0.35" stroke-width="0.9">
			<path d={purpleLine} class="stroke-element-purple" />
			<path d={greenLine} class="stroke-element-green" />
		</g>
		{/* The points add up their light where they overlap, like on the Hero's canvas. */}
		<g class="*:mix-blend-plus-lighter">
			{circles.map(({ along, x, y, r, color, opacity }) => (
				<circle
					data-along={along}
					cx={x}
					cy={y}
					r={r}
					opacity={opacity}
					fill={`url(#logo-${color})`}
				/>
			))}
			<circle data-pen r={PEN_SIZE} opacity="0" fill="url(#logo-white)" />
		</g>
	</svg>

	{/* Below lg the header has no room for the name: only the ∞. */}
	<span
		aria-hidden="true"
		class="flex flex-col gap-1 text-[0.9375rem] leading-none tracking-[0.22em] uppercase max-lg:hidden"
	>
		<span class="font-semibold text-foreground">{first}</span>
		<span class="text-purple">{last}</span>
	</span>
	<span class="sr-only">{values.name}</span>
</span>

<style is:global>
	/* The script traces the ∞ after the page loads: until then, it is not shown. */
	@media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
		[data-logo-infinity]:not([data-state]) {
			visibility: hidden;
		}
	}
</style>

<script>
	import { afterLoad } from '../scripts/after-load';
	import { curve } from '../scripts/infinity';
	import { START, lines, place } from '../scripts/logo-infinity';

	const TAU = Math.PI * 2;
	/** The pen runs one lap in this many seconds, then fades out. */
	const LAP = 1.8;
	const FADE_OUT = 0.35;
	/** How far behind the pen, in radians, a point reaches its full light. */
	const LIGHT_UP = 0.6;

	afterLoad(() => {
		const svg = document.querySelector<SVGSVGElement>('[data-logo-infinity]');
		if (!svg) return;
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) svg.dataset.state = 'formed';
		else trace(svg);
	});

	function trace(svg: SVGSVGElement) {
		const paths = [...svg.querySelectorAll('path')];
		const formedLines = paths.map((path) => path.getAttribute('d')!);
		const pen = svg.querySelector<SVGCircleElement>('[data-pen]')!;
		const dots = [...svg.querySelectorAll<SVGCircleElement>('circle[data-along]')].map(
			(circle) => ({
				circle,
				along: Number(circle.dataset.along),
				r: circle.getAttribute('r')!,
				opacity: Number(circle.getAttribute('opacity')),
			}),
		);
		let startedAt: number | undefined;
		let pendingFrame = 0;

		/** Draws the ∞ `lap` radians along, the points lighting up behind the pen. */
		function draw(lap: number, penOpacity: number) {
			lines(Math.min(lap, TAU)).forEach((d, i) => paths[i].setAttribute('d', d));
			for (const { circle, along, r, opacity } of dots) {
				const lit = Math.min(Math.max((lap - along) / LIGHT_UP, 0), 1);
				circle.style.opacity = String(opacity * lit);
				// A point just reached is a little bigger, then settles.
				circle.setAttribute('r', String(Number(r) * (1 + (1 - lit) * 0.8)));
			}
			const { x, y } = place(curve(START + Math.min(lap, TAU)));
			pen.setAttribute('cx', String(x));
			pen.setAttribute('cy', String(y));
			pen.setAttribute('opacity', String(penOpacity));
		}

		function frame(now: number) {
			startedAt ??= now;
			const time = (now - startedAt) / 1000;
			if (time < LAP) {
				const t = time / LAP;
				draw(TAU * (t < 0.5 ? 2 * t * t : 1 - (2 - 2 * t) ** 2 / 2), 1);
			} else if (time < LAP + FADE_OUT) {
				// The last points finish lighting up as the pen fades.
				const fade = (time - LAP) / FADE_OUT;
				draw(TAU + LIGHT_UP * fade, 1 - fade);
			} else return finish();
			pendingFrame = requestAnimationFrame(frame);
		}

		function finish() {
			cancelAnimationFrame(pendingFrame);
			document.removeEventListener('animation', onPause);
			formedLines.forEach((d, i) => paths[i].setAttribute('d', d));
			for (const { circle, r } of dots) {
				circle.style.removeProperty('opacity');
				circle.setAttribute('r', r);
			}
			pen.setAttribute('opacity', '0');
			svg.dataset.state = 'formed';
		}

		// The pause button forms it at once.
		const onPause = () => {
			if (document.documentElement.dataset.animation === 'paused') finish();
		};
		document.addEventListener('animation', onPause);

		draw(0, 1);
		svg.dataset.state = 'tracing';
		pendingFrame = requestAnimationFrame(frame);
	}
</script>
