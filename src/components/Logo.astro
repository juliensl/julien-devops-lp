---
// The logo: Julien's image, the ∞ and the name. The `alt` gives a link around it its accessible name.
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { values } from '../config/values';
---

{/* Below lg the header has no room for the name: the image is cropped to its left 9/4, the ∞. */}
<Image
	src={logo}
	alt={values.name}
	height={44}
	densities={[1, 2, 3]}
	loading="eager"
	class="h-9 w-auto max-lg:aspect-9/4 max-lg:object-cover max-lg:object-left lg:h-11"
/>
