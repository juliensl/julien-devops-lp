---
// The Services: the 4 Blocks, in the pitch's order, so the CTO sees what they hire.
// On desktop, the section stays pinned while the scroll makes the cards pass sideways, with a «1 / 4»
// counter and a progress bar. On mobile, the cards are one below the other; with reduced motion,
// without JS, or on a screen too short for them, they are in a grid.
import type { Dictionary } from '../i18n/fr';
import { withNonBreakingSpaces } from '../lib/spaces';
import BlockDiagram from './BlockDiagram.astro';

type Props = Dictionary['homePage']['services'];

const { label, title, note, blockLabel, toolsLabel, blocks, diagrams } = Astro.props;
---

<section aria-labelledby="services-title" data-section="services" data-services>
	<div data-stage>
		<div data-content class="grid gap-12 py-[clamp(5rem,11vw,9rem)]">
			<div class="page-width grid gap-x-16 gap-y-6 min-[961px]:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] min-[961px]:items-end">
				<div data-reveal class="grid gap-4">
					<div class="flex flex-wrap items-center gap-x-6 gap-y-2">
						<p class="label">{label}</p>
						{/* Where the cards are: only while pinned, and read by the eye only. */}
						<p
							data-counter
							aria-hidden="true"
							class="flex items-center gap-3 text-[0.8125rem] leading-none font-medium tracking-[0.08em] text-foreground-secondary tabular-nums"
						>
							<span data-position>1 / {blocks.length}</span>
							<span class="relative h-px w-32 bg-line-strong">
								<span data-progress class="absolute inset-x-0 -top-px h-0.5 bg-green"></span>
							</span>
						</p>
					</div>
					<h2 id="services-title" class="text-[clamp(2.1rem,4.4vw,3.4rem)] leading-[1.06]">
						{title}
					</h2>
				</div>
				<p data-note data-reveal class="max-w-[34rem] text-lg text-foreground-secondary">
					{withNonBreakingSpaces(note)}
				</p>
			</div>

			<ol data-track class="page-width grid gap-x-10 gap-y-14 md:grid-cols-2">
				{blocks.map(({ name, summary, text, tools, toolsAlternative }, k) => (
					<li data-card data-reveal class="grid content-start gap-3">
						<div class="mb-2">
							<BlockDiagram block={k + 1} words={diagrams} />
						</div>
						<p class="label text-purple">
							{blockLabel} {k + 1}
						</p>
						<h3 class="text-[1.65rem] leading-[1.15]">{name}</h3>
						<p class="text-[0.9375rem] text-green">{withNonBreakingSpaces(summary)}</p>
						<p data-text class="text-foreground-secondary">
							{withNonBreakingSpaces(text)}
						</p>
						<ul
							aria-label={toolsLabel}
							class="mt-1 flex flex-wrap items-center gap-2 text-[0.8125rem]"
						>
							{tools.map((tool) => (
								<li class="rounded-full border border-green-strong px-2.5 py-0.5 text-green">
									{tool}
								</li>
							))}
							{toolsAlternative && <li class="text-foreground-secondary">{toolsAlternative}</li>}
						</ul>
					</li>
				))}
			</ol>
		</div>
	</div>
</section>

<script>
	import { afterLoad } from '../scripts/after-load';
	import { DESKTOP } from '../scripts/desktop';

	/** The vertical scroll is 1.8 times the cards' sideways travel, so they pass slowly (prototype v3). */
	const SLOWNESS = 1.8;

	afterLoad(() => {
		const desktop = matchMedia(DESKTOP);

		for (const section of document.querySelectorAll<HTMLElement>('[data-services]')) {
			const stage = section.querySelector<HTMLElement>('[data-stage]')!;
			const content = section.querySelector<HTMLElement>('[data-content]')!;
			const track = section.querySelector<HTMLElement>('[data-track]')!;
			const position = section.querySelector<HTMLElement>('[data-position]')!;
			const bar = section.querySelector<HTMLElement>('[data-progress]')!;
			const count = track.children.length;
			let travel = 0;
			let pendingFrame = 0;

			// With the section pinned, the progress goes from 0 (the stage pins) to 1 (it unpins): the
			// cards move left by that share of their travel, and the counter shows the card in front.
			const move = () => {
				pendingFrame = 0;
				if (!section.hasAttribute('data-pinned')) return;
				const { top, height } = section.getBoundingClientRect();
				const stageTop = parseFloat(getComputedStyle(stage).top);
				const progress = Math.min(Math.max((stageTop - top) / (height - stage.offsetHeight), 0), 1);
				track.style.transform = `translate3d(${-progress * travel}px, 0, 0)`;
				position.textContent = `${Math.round(progress * (count - 1)) + 1} / ${count}`;
				bar.style.transform = `scaleX(${progress})`;
			};

			// When pinned, the cards must fit in the stage, below the header and above the pause button;
			// on a short screen or when zoomed in, they do not fit, and the section stays unpinned so
			// nothing is hidden. On a very wide screen, the 4 cards fit side by side: with nothing to
			// pass, it stays unpinned too.
			const pin = () => {
				section.toggleAttribute('data-pinned', desktop.matches);
				track.style.transform = '';
				const room = stage.clientHeight - parseFloat(getComputedStyle(stage).paddingBottom);
				const lastCard = track.lastElementChild!.getBoundingClientRect();
				if (content.offsetHeight > room || lastCard.right <= stage.getBoundingClientRect().right) {
					section.removeAttribute('data-pinned');
				}
				travel = Math.max(track.offsetWidth - stage.clientWidth, 0);
				section.style.setProperty('--travel', `${travel * SLOWNESS}px`);
				move();
			};

			desktop.addEventListener('change', pin);
			addEventListener('resize', pin);
			addEventListener('scroll', () => (pendingFrame ||= requestAnimationFrame(move)), {
				passive: true,
			});
			pin();
		}
	});
</script>

<style>
	/* Pinned: the section gains the scroll the cards need to pass, and the stage stays still below
	   the header while the section scrolls past. */
	[data-pinned] {
		height: calc(100svh - var(--header-height) + var(--travel));
	}
	[data-pinned] [data-stage] {
		position: sticky;
		top: var(--header-height);
		display: grid;
		align-content: center;
		height: calc(100svh - var(--header-height));
		/* The corner of the pause button (#62), which would cover the bottom of the first card. */
		padding-bottom: 3.5rem;
		/* The cards waiting on the right stay out of sight, without a horizontal scroll. `clip`,
		   unlike `hidden`, is not a scroll container: focus or a search never shifts the cards. */
		overflow-x: clip;
	}
	/* The stage centers the content: the space above and below comes from it, not from the padding.
	   The column keeps the page width, while the row of cards overflows it to the right. */
	[data-pinned] [data-content] {
		grid-template-columns: minmax(0, 1fr);
		padding-block: 0;
		gap: clamp(1.75rem, 5vh, 3rem);
	}

	/* Pinned, the cards are in a row that starts aligned with the page width. The padding, in % of
	   the stage, puts the first card under the title and leaves the last one the same margin. */
	[data-pinned] [data-track] {
		display: flex;
		justify-self: start;
		width: max-content;
		max-width: none;
		margin: 0;
		gap: 2.5rem;
		padding-inline: max(1.25rem, calc((100% - 76rem) / 2 + 1.25rem));
		will-change: transform;
	}
	/* Not narrower than 24rem: on a narrow laptop, narrower cards would wrap into lines that do not fit. */
	[data-pinned] [data-card] {
		width: clamp(24rem, 31vw, 27rem);
	}

	/* So the cards fit below the header on a laptop screen too (prototype v3): the diagrams follow
	   the screen height, and on a short screen the headings and the spacing get smaller. */
	[data-pinned] [data-card] :global(svg) {
		max-height: min(11rem, 18vh);
	}
	@media (max-height: 820px) {
		[data-pinned] [data-content] {
			gap: 1.25rem;
		}
		[data-pinned] h2 {
			font-size: clamp(1.9rem, 3.4vw, 2.6rem);
		}
		[data-pinned] [data-note] {
			font-size: 1rem;
		}
		[data-pinned] [data-card] {
			gap: 0.45rem;
		}
		[data-pinned] h3 {
			font-size: 1.4rem;
		}
		[data-pinned] [data-text] {
			font-size: 0.9375rem;
			line-height: 1.55;
		}
	}

	/* The counter and its bar only make sense while the cards pass. */
	[data-services]:not([data-pinned]) [data-counter] {
		display: none;
	}
	[data-progress] {
		transform: scaleX(0);
		transform-origin: left;
	}
</style>
