---
// PROTOTYPE (throwaway, branch prototype/dotted-logo): switches the logo variant and replays the pen.
// Only rendered by the dev server.
const VARIANTS = [
	['A', 'duas linhas'],
	['B', 'uma linha'],
	['C', 'uma linha, maiúsculas'],
];
---

<div
	data-logo-switcher
	data-variants={JSON.stringify(VARIANTS)}
	class="fixed bottom-18 left-1/2 z-50 flex -translate-x-1/2 items-center gap-1 rounded-full border-2 border-[#ffd84d] bg-black px-2 py-1.5 font-mono text-sm text-[#ffd84d] shadow-[0_8px_24px_rgb(0_0_0/0.6)]"
>
	<button type="button" data-step="-1" class="cursor-pointer rounded-full px-2.5 py-1 hover:bg-white/10">←</button>
	<span data-label class="min-w-36 text-center"></span>
	<button type="button" data-step="1" class="cursor-pointer rounded-full px-2.5 py-1 hover:bg-white/10">→</button>
	<button type="button" data-density class="cursor-pointer rounded-full border border-[#ffd84d]/50 px-2.5 py-1 hover:bg-white/10"></button>
	<button type="button" data-replay class="cursor-pointer rounded-full border border-[#ffd84d]/50 px-2.5 py-1 hover:bg-white/10">
		↻ Repetir
	</button>
</div>

<script>
	const bar = document.querySelector<HTMLElement>('[data-logo-switcher]')!;
	// The header's backdrop blur would hold a fixed child: the bar lives in the body.
	document.body.append(bar);
	const variants: [string, string][] = JSON.parse(bar.dataset.variants!);
	const current = new URLSearchParams(location.search).get('variant') ?? 'A';
	const index = Math.max(
		variants.findIndex(([key]) => key === current),
		0,
	);
	bar.querySelector('[data-label]')!.textContent = `${variants[index][0]} (${variants[index][1]})`;

	const go = (step: number) => {
		const url = new URL(location.href);
		url.searchParams.set('variant', variants[(index + step + variants.length) % variants.length][0]);
		location.href = url.href;
	};
	for (const button of bar.querySelectorAll<HTMLButtonElement>('[data-step]')) {
		button.addEventListener('click', () => go(Number(button.dataset.step)));
	}
	// Size presets: the ∞'s height from 1024 px (5/6 of it below), and how it is narrowed.
	const SIZES = [
		['48 px, como estava', { height: '48', squash: '1', yaw: '-0.4' }],
		['40 px', { height: '40', squash: '1', yaw: '-0.4' }],
		['40 px, apertado', { height: '40', squash: '0.8', yaw: '-0.4' }],
		['40 px, rodado', { height: '40', squash: '1', yaw: '-0.6' }],
		['36 px, apertado', { height: '36', squash: '0.8', yaw: '-0.4' }],
		['36 px, rodado', { height: '36', squash: '1', yaw: '-0.6' }],
	] as const;
	const search = new URLSearchParams(location.search);
	const size = Math.max(
		SIZES.findIndex(
			([, preset]) =>
				preset.height === (search.get('height') ?? '48') &&
				preset.squash === (search.get('squash') ?? '1') &&
				preset.yaw === (search.get('yaw') ?? '-0.4'),
		),
		0,
	);
	const sizeButton = bar.querySelector<HTMLButtonElement>('[data-density]')!;
	sizeButton.textContent = `∞ ${size + 1}/${SIZES.length}: ${SIZES[size][0]}`;
	sizeButton.addEventListener('click', () => {
		const url = new URL(location.href);
		for (const [key, value] of Object.entries(SIZES[(size + 1) % SIZES.length][1])) {
			url.searchParams.set(key, value);
		}
		location.href = url.href;
	});
	bar.querySelector('[data-replay]')!.addEventListener('click', () =>
		document.dispatchEvent(new Event('logo-replay')),
	);
	addEventListener('keydown', (event) => {
		const target = event.target as HTMLElement;
		if (target.closest('input, textarea, [contenteditable]')) return;
		if (event.key === 'ArrowLeft') go(-1);
		if (event.key === 'ArrowRight') go(1);
	});
</script>
