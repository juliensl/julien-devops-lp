---
// O cabeçalho fixo de todas as páginas: o logótipo, o seletor de língua e o botão.
// No telemóvel, as línguas passam para um menu <details>, que abre sem JS; o botão fica sempre à vista.
// Numa página sem equivalentes noutras línguas (a 404), o cabeçalho fica só com o logótipo e o botão,
// e o logótipo leva à página principal da primeira língua publicada.
// As partes que chegam com as páginas para onde levam têm o lugar marcado com o ticket.
import { PHASE, PREFIXES, type Language } from '../config/site';
import { dictionaries } from '../i18n';
import BookingButton from './BookingButton';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';

interface Props {
	language: Language;
	/** A página só existe nesta língua (a 404): não há seletor nem menu. */
	noEquivalents?: boolean;
}

const { language, noEquivalents = false } = Astro.props;
const t = dictionaries[language];
---

<header class="sticky top-0 z-20 border-b border-line bg-background/85 backdrop-blur-md">
	<div class="page-width flex h-(--header-height) items-center gap-2 md:gap-4">
		<a
			href={PREFIXES[noEquivalents ? PHASE.publishedLanguages[0] : language]}
			class="inline-flex min-h-11 shrink-0 items-center rounded-md text-[0.6875rem] min-[420px]:text-[0.8125rem] sm:text-[0.95rem]"
		>
			<Logo />
			<span class="sr-only">, {t.header.logoTarget}</span>
		</a>

		<div class="ml-auto flex items-center gap-4">
			{/* «Os teus desafios» e o submenu (#70) */}

			{/* 🍃 Ecologia (#68) */}

			{!noEquivalents && (
				<LanguageSwitcher language={language} label={t.header.languages} class="max-md:hidden" />
			)}
		</div>

		<BookingButton text={t.bookButton} compact />

		{!noEquivalents && (
			<details data-menu class="relative md:hidden">
				<summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-[10px] border border-line-strong text-foreground [&::-webkit-details-marker]:hidden">
					<svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
						<path
							d="M4 7h16M4 12h16M4 17h16"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
						></path>
					</svg>
					<span class="sr-only">{t.header.menu}</span>
				</summary>
				<div class="absolute top-[calc(100%+0.625rem)] right-0 grid w-[min(20rem,calc(100vw-2.5rem))] gap-2 rounded-xl border border-line bg-surface p-4 shadow-[0_18px_40px_rgb(0_0_0/0.5)]">
					{/* «Os teus desafios» (#70) */}

					{/* Ecologia (#68): abaixo de 360 px, fica só aqui */}

					<LanguageSwitcher language={language} label={t.header.languages} large />
				</div>
			</details>
		)}
	</div>
</header>

<script>
	// Os menus <details data-menu> abrem e fecham sem JS. O JS só os fecha também ao clicar fora,
	// com Escape e depois de escolher uma ligação.
	const openMenus = () => document.querySelectorAll<HTMLDetailsElement>('details[data-menu][open]');

	document.addEventListener('click', (event) => {
		const target = event.target as Element;
		for (const menu of openMenus()) {
			if (!menu.contains(target) || target.closest('a')) menu.open = false;
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		for (const menu of openMenus()) {
			const hadFocus = menu.contains(document.activeElement);
			menu.open = false;
			if (hadFocus) menu.querySelector('summary')?.focus();
		}
	});
</script>
