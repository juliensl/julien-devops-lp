---
// The sticky header of every page: the logo, «Os teus desafios» with its submenu of audiences,
// 🍃 Ecology, the language switcher, LinkedIn and the button.
// On mobile, the audiences, the languages and LinkedIn move into a `<details>` menu, which opens without JS; the
// button and the leaf always stay visible, the leaf without its word. Below 360 px, Ecology only lives
// in the menu.
// On a page with no equivalents in other languages (the 404), the header keeps only the logo and the button,
// and the logo leads to the home page of the first published language.
// The parts that arrive with the pages they lead to have their place marked with the ticket.
import { PHASE, PREFIXES, type Language } from '../config/site';
import { values } from '../config/values';
import { dictionaries } from '../i18n';
import { ecologyPath } from '../lib/paths';
import AudienceLinks from './AudienceLinks.astro';
import BookingButton from './BookingButton';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Leaf from './Leaf.astro';
import LinkedInLogo from './LinkedInLogo.astro';
import Logo from './Logo.astro';
import LogoPrototypeSwitcher from './LogoPrototypeSwitcher.astro';

interface Props {
	language: Language;
	/** The page only exists in this language (the 404): no switcher and no menu. */
	noEquivalents?: boolean;
}

const { language, noEquivalents = false } = Astro.props;
const t = dictionaries[language];
const ecology = ecologyPath(language);
const onEcology = Astro.url.pathname === ecology ? 'page' : undefined;
---

<header class="sticky top-0 z-20 border-b border-line bg-background/85 backdrop-blur-md">
	<div class="page-width flex h-(--header-height) items-center gap-2 md:gap-4">
		<a
			href={PREFIXES[noEquivalents ? PHASE.publishedLanguages[0] : language]}
			class="inline-flex min-h-11 shrink-0 items-center rounded-md"
		>
			<Logo />
			<span class="sr-only">, {t.header.logoTarget}</span>
		</a>
		{import.meta.env.DEV && <LogoPrototypeSwitcher />}

		<div class="ml-auto flex items-center gap-4">
			{!noEquivalents && (
				<nav aria-label={t.questions.menu} class="max-md:hidden">
					<details data-menu class="group relative">
						<summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-1.5 rounded-lg px-3 text-[0.9375rem] text-foreground-secondary transition-colors group-open:bg-surface group-open:text-foreground hover:bg-surface hover:text-foreground [&::-webkit-details-marker]:hidden">
							{t.questions.menu}
							<svg
								width="12"
								height="12"
								viewBox="0 0 12 12"
								aria-hidden="true"
								class="transition-transform group-open:rotate-180"
							>
								<path
									d="M2.5 4.5 6 8l3.5-3.5"
									fill="none"
									stroke="currentColor"
									stroke-width="1.6"
								></path>
							</svg>
						</summary>
						<AudienceLinks
							language={language}
							descriptions
							class="absolute top-[calc(100%+0.5rem)] right-0 grid w-[22rem] gap-0.5 rounded-xl border border-line bg-surface p-2 shadow-[0_18px_40px_rgb(0_0_0/0.45)]"
						/>
					</details>
				</nav>
			)}

			{!noEquivalents && (
				<a
					href={ecology}
					aria-current={onEcology}
					class="inline-flex min-h-11 items-center gap-1.5 rounded-full border border-green-strong px-3 text-[0.9rem] font-medium text-green transition-colors hover:bg-green/15 aria-[current]:bg-green/15 max-md:size-11 max-md:justify-center max-md:px-0 max-[360px]:hidden"
				>
					<Leaf size={18} />
					<span class="max-md:sr-only">{t.ecology.link}</span>
				</a>
			)}

			{!noEquivalents && (
				<LanguageSwitcher language={language} label={t.header.languages} class="max-md:hidden" />
			)}

			{!noEquivalents && (
				<a
					href={values.linkedin}
					class="inline-flex size-11 items-center justify-center rounded-md text-foreground-secondary transition-colors hover:text-foreground max-md:hidden"
				>
					<LinkedInLogo />
					<span class="sr-only">LinkedIn</span>
				</a>
			)}
		</div>

		<BookingButton text={t.bookButton} compact />

		{!noEquivalents && (
			<details data-menu class="relative md:hidden">
				<summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-[10px] border border-line-strong text-foreground [&::-webkit-details-marker]:hidden">
					<svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
						<path
							d="M4 7h16M4 12h16M4 17h16"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
						></path>
					</svg>
					<span class="sr-only">{t.header.menu}</span>
				</summary>
				<div class="absolute top-[calc(100%+0.625rem)] right-0 grid w-[min(20rem,calc(100vw-2.5rem))] gap-2 rounded-xl border border-line bg-surface p-4 shadow-[0_18px_40px_rgb(0_0_0/0.5)]">
					<nav aria-labelledby="menu-questions">
						<p
							id="menu-questions"
							class="px-2 text-[0.6875rem] tracking-[0.12em] text-foreground-secondary uppercase"
						>
							{t.questions.menu}
						</p>
						<AudienceLinks language={language} class="mt-1 grid" />
					</nav>

					<a
						href={ecology}
						aria-current={onEcology}
						class="flex min-h-11 items-center gap-2 rounded-[10px] bg-green/15 px-3 font-semibold text-green"
					>
						<Leaf size={18} />
						{t.ecology.link}
					</a>

					<LanguageSwitcher language={language} label={t.header.languages} large />

					<a
						href={values.linkedin}
						class="flex min-h-11 items-center gap-2 rounded-[10px] px-2 text-foreground-secondary hover:bg-surface-2 hover:text-foreground"
					>
						<LinkedInLogo size={18} />
						LinkedIn
					</a>
				</div>
			</details>
		)}
	</div>
</header>

<script>
	// The `<details data-menu>` menus open and close without JS. JS only adds closing them on a click
	// outside, on Escape and after a link is chosen.
	const openMenus = () => document.querySelectorAll<HTMLDetailsElement>('details[data-menu][open]');

	document.addEventListener('click', (event) => {
		const target = event.target as Element;
		for (const menu of openMenus()) {
			if (!menu.contains(target) || target.closest('a')) menu.open = false;
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		for (const menu of openMenus()) {
			const hadFocus = menu.contains(document.activeElement);
			menu.open = false;
			if (hadFocus) menu.querySelector('summary')?.focus();
		}
	});
</script>
