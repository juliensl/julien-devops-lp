---
// A página principal: as secções pela ordem da #54, com o ticket que traz cada uma.
// Cada secção fica no seu lugar, separada das outras por uma linha em branco,
// para que os PR que acrescentam secções diferentes não entrem em conflito.
import { type Language } from '../config/site';
import { values } from '../config/values';
import { dictionaries } from '../i18n';
import Base from '../layouts/Base.astro';
import AboutJulien from './AboutJulien.astro';
import FinalCta from './FinalCta';
import Guarantee from './Guarantee';
import Hero from './Hero';
import PauseButton from './PauseButton.astro';
import Steps from './Steps.astro';
import TodayAndAfter from './TodayAndAfter';
import TopDots from './TopDots.astro';
import WhoItsFor from './WhoItsFor';

interface Props {
	language: Language;
}

const { language } = Astro.props;
const t = dictionaries[language];
---

<Base
	language={language}
	title={`${values.name} · ${t.designation}`}
	description={t.homePage.description}
>
	<main>
		<TopDots />
		{/* O botão de pausa é o primeiro foco depois do cabeçalho: para tudo antes de ler. */}
		<PauseButton {...t.animation} />

		<Hero
			designation={t.designation}
			promise={t.promise}
			buttonText={t.bookButton}
			{...t.homePage.hero}
		/>

		<WhoItsFor buttonText={t.bookButton} {...t.homePage.whoItsFor} />

		<TodayAndAfter {...t.homePage.todayAndAfter} />

		{/* Serviços (#64) */}

		<Steps {...t.homePage.steps} />

		<Guarantee {...t.homePage.guarantee} />

		{/* Gráfico de fornecedores cloud (#66) */}

		<AboutJulien designation={t.designation} {...t.homePage.about} />

		{/* Testemunhos (#67) */}

		{/* Ecologia (#68) */}

		{/* Perguntas (#70) */}

		<FinalCta language={language} buttonText={t.bookButton} {...t.homePage.finalCta} />
	</main>
</Base>
