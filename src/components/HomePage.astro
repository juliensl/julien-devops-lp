---
// A página principal: as secções pela ordem da #54, com o ticket que traz cada uma.
// Cada secção fica no seu lugar, separada das outras por uma linha em branco,
// para que os PR que acrescentam secções diferentes não entrem em conflito.
import { type Lingua } from '../config/site';
import { valores } from '../config/values';
import { dicionarios } from '../i18n';
import Base from '../layouts/Base.astro';
import AboutJulien from './AboutJulien.astro';
import FinalCta from './FinalCta';
import Guarantee from './Guarantee';
import Hero from './Hero';
import PauseButton from './PauseButton.astro';
import Steps from './Steps.astro';
import TodayAndAfter from './TodayAndAfter';
import TopDots from './TopDots.astro';
import WhoItsFor from './WhoItsFor';

interface Props {
	lingua: Lingua;
}

const { lingua } = Astro.props;
const t = dicionarios[lingua];
---

<Base
	lingua={lingua}
	titulo={`${valores.nome} · ${t.designacao}`}
	descricao={t.paginaPrincipal.descricao}
>
	<main>
		<TopDots />
		{/* O botão de pausa é o primeiro foco depois do cabeçalho: para tudo antes de ler. */}
		<PauseButton {...t.animacao} />

		<Hero
			designacao={t.designacao}
			promessa={t.promessa}
			textoDoBotao={t.botaoMarcar}
			{...t.paginaPrincipal.hero}
		/>

		<WhoItsFor textoDoBotao={t.botaoMarcar} {...t.paginaPrincipal.paraQuem} />

		<TodayAndAfter {...t.paginaPrincipal.hojeEDepois} />

		{/* Serviços (#64) */}

		<Steps {...t.paginaPrincipal.etapas} />

		<Guarantee {...t.paginaPrincipal.garantia} />

		{/* Gráfico de fornecedores cloud (#66) */}

		<AboutJulien designacao={t.designacao} {...t.paginaPrincipal.quem} />

		{/* Testemunhos (#67) */}

		{/* Ecologia (#68) */}

		{/* Perguntas (#70) */}

		<FinalCta lingua={lingua} textoDoBotao={t.botaoMarcar} {...t.paginaPrincipal.ctaFinal} />
	</main>
</Base>
