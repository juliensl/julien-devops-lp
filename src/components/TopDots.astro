---
// The decorative dots at the top of the home page: small purple ones on a grid, and green ones,
// more spaced out, glowing. They stay fixed at the top of the screen, behind the content, and fade
// out downwards (prototype v3, "like the Arkoder ones"). They only animate `transform` and `opacity`,
// which the GPU composites without repainting the page.
---

<div class="dots" data-dots aria-hidden="true">
	<div class="layer purples"></div>
	<div class="layer greens"></div>
	<div class="layer greens others"></div>
</div>

<script>
	import { afterLoad } from '../scripts/after-load';

	afterLoad(() => {
		for (const dots of document.querySelectorAll<HTMLElement>('[data-dots]')) {
			dots.dataset.moving = '';
		}
	});
</script>

<style>
	/* Behind the content and the header; the layers, larger than the screen, are clipped. */
	.dots {
		position: fixed;
		inset: 0 0 auto;
		z-index: -1;
		height: 20rem;
		overflow: hidden;
		pointer-events: none;
		mask-image: linear-gradient(#000 35%, transparent);
	}
	.layer {
		position: absolute;
		inset: -200px;
		will-change: transform;
	}
	.purples {
		background-image: radial-gradient(
			circle,
			color-mix(in srgb, var(--color-purple) 30%, transparent) 1.1px,
			transparent 1.7px
		);
		background-size: 28px 28px;
	}
	.greens {
		background-image: radial-gradient(
			circle,
			color-mix(in srgb, var(--color-green) 85%, transparent) 1.7px,
			transparent 2.4px
		);
		background-size: 168px 140px;
		background-position: 42px 28px;
	}
	.others {
		background-position: 126px 98px;
	}

	/* With reduced motion, they stay still. */
	@media (prefers-reduced-motion: no-preference) {
		.purples {
			animation: drift-purples 22s linear infinite;
		}
		.greens {
			animation:
				drift-greens 40s linear infinite,
				glow 7s ease-in-out infinite;
		}
		/* The second green layer moves the other way and glows out of step with the first. */
		.others {
			animation-direction: reverse, normal;
			animation-delay:
				0s,
				-3.5s;
		}
	}
	@keyframes drift-purples {
		to {
			transform: translate3d(28px, 28px, 0);
		}
	}
	@keyframes drift-greens {
		to {
			transform: translate3d(-168px, 140px, 0);
		}
	}
	@keyframes glow {
		0%,
		100% {
			opacity: 0.25;
		}
		50% {
			opacity: 1;
		}
	}

	/* Paused until the script sets them moving, after load. Then they stop with the pause
	   button, which sets `<html data-animation="paused">`. */
	.layer {
		animation-play-state: paused;
	}
	:global(:root:not([data-animation='paused'])) [data-moving] .layer {
		animation-play-state: running;
	}
</style>
