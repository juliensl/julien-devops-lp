---
// Os pontos decorativos no topo da página principal: pequenos roxos numa grelha, e verdes, mais
// espaçados, a brilhar. Ficam fixos no topo do ecrã, por baixo do conteúdo, e desaparecem
// para baixo (protótipo v3, «como os da Arkoder»). Só mexem transform e opacity, que a GPU
// compõe sem redesenhar a página.
---

<div class="dots" data-dots aria-hidden="true">
	<div class="layer purples"></div>
	<div class="layer greens"></div>
	<div class="layer greens others"></div>
</div>

<script>
	import { depoisDoCarregamento } from '../scripts/after-load';

	depoisDoCarregamento(() => {
		for (const pontos of document.querySelectorAll<HTMLElement>('[data-dots]')) {
			pontos.dataset.moving = '';
		}
	});
</script>

<style>
	/* Por baixo do conteúdo e do cabeçalho; as camadas, maiores do que o ecrã, ficam cortadas. */
	.dots {
		position: fixed;
		inset: 0 0 auto;
		z-index: -1;
		height: 20rem;
		overflow: hidden;
		pointer-events: none;
		mask-image: linear-gradient(#000 35%, transparent);
	}
	.layer {
		position: absolute;
		inset: -200px;
		will-change: transform;
	}
	.purples {
		background-image: radial-gradient(
			circle,
			color-mix(in srgb, var(--color-purple) 30%, transparent) 1.1px,
			transparent 1.7px
		);
		background-size: 28px 28px;
	}
	.greens {
		background-image: radial-gradient(
			circle,
			color-mix(in srgb, var(--color-green) 85%, transparent) 1.7px,
			transparent 2.4px
		);
		background-size: 168px 140px;
		background-position: 42px 28px;
	}
	.others {
		background-position: 126px 98px;
	}

	/* Com movimento reduzido, ficam parados. */
	@media (prefers-reduced-motion: no-preference) {
		.purples {
			animation: drift-purples 22s linear infinite;
		}
		.greens {
			animation:
				drift-greens 40s linear infinite,
				glow 7s ease-in-out infinite;
		}
		/* A segunda camada verde anda ao contrário e brilha desencontrada da primeira. */
		.others {
			animation-direction: reverse, normal;
			animation-delay:
				0s,
				-3.5s;
		}
	}
	@keyframes drift-purples {
		to {
			transform: translate3d(28px, 28px, 0);
		}
	}
	@keyframes drift-greens {
		to {
			transform: translate3d(-168px, 140px, 0);
		}
	}
	@keyframes glow {
		0%,
		100% {
			opacity: 0.25;
		}
		50% {
			opacity: 1;
		}
	}

	/* Parados até o script os pôr a andar, depois do carregamento. Depois, param com o botão de
	   pausa, que põe <html data-animation="paused">. */
	.layer {
		animation-play-state: paused;
	}
	:global(:root:not([data-animation='paused'])) [data-moving] .layer {
		animation-play-state: running;
	}
</style>
