---
// The «Choisir son cloud» page: Julien's introduction, the cloud provider chart, and the button.
import type { Language } from '../config/site';
import { values } from '../config/values';
import { dictionaries } from '../i18n';
import Base from '../layouts/Base.astro';
import { withNonBreakingSpaces } from '../lib/spaces';
import BookingButton from './BookingButton';
import ScrollReveal from './ScrollReveal.astro';

interface Props {
	language: Language;
}

const { language } = Astro.props;
const t = dictionaries[language];
const { link, page } = t.cloud;
---

<Base language={language} title={`${link} · ${values.name}`} description={page.description}>
	<main>
		<div class="page-width grid gap-4 pt-14 sm:pt-20">
			<p class="label">{link}</p>
			<h1 class="max-w-4xl text-[clamp(2.4rem,5vw,4rem)] leading-[1.05]">
				{withNonBreakingSpaces(page.title)}
			</h1>
			<p class="max-w-2xl text-lg text-foreground-secondary">{withNonBreakingSpaces(page.intro)}</p>
		</div>

		<section aria-labelledby="cloud-cta-title" class="page-width pt-20">
			<div
				data-reveal
				class="flex flex-wrap items-center justify-between gap-6 border-t-2 border-green pt-10"
			>
				<div class="grid gap-2">
					<h2 id="cloud-cta-title" class="text-[clamp(1.7rem,3.2vw,2.3rem)] leading-[1.1]">
						{withNonBreakingSpaces(page.cta.title)}
					</h2>
					<p class="text-lg text-foreground-secondary">{withNonBreakingSpaces(page.cta.text)}</p>
				</div>
				<BookingButton text={t.bookButton} />
			</div>
		</section>

		<ScrollReveal />
	</main>
</Base>
