---
// PROTÓTIPO v3 · Elemento do Hero validado pelo Julien a 20/10/2026 («Que elemento gráfico 3D
// tem o Hero?», #53): o ∞ de pontos em 3D (metade roxo, metade verde) e, saindo da volta roxa,
// um ramo no mesmo estilo que cresce com o scroll até ao CTA final, com folhas de pontos verdes.
// Percurso (acertos do mesmo dia): margem esquerda; nos Serviços presos fica ao lado do título,
// com uma folha por cartão, e só volta a descer quando os cartões acabam, já pela direita; volta
// à esquerda antes das Etapas e segue os degraus, com um nó por etapa (com as Etapas presas,
// o scroll faz o ramo chegar a uma etapa de cada vez); desce pela direita na
// Garantia e volta à esquerda antes do gráfico; em «Quem é o Julien» só o traço roxo dá meia
// volta à fotografia e desce até ao fim da secção; volta à esquerda nos testemunhos.
// As cores do ∞ e do ramo são fixas (--elemento-*). Movimento contínuo, parado pelo botão de
// pausa da página (PausaAnimacao). Um só canvas fixo, feito à mão, sem biblioteca. Com
// prefers-reduced-motion fica uma imagem parada, com o ramo inteiro.
---

<canvas class="elemento" data-elemento aria-hidden="true"></canvas>

<script>
	type Pt = { x: number; y: number };
	type Amostra = Pt & { l: number };
	type Folha = Pt & { l: number; ang: number; tam: number; pino?: number };
	type No = Pt & { l: number };

	const TAU = Math.PI * 2;
	// Ponto da volta roxa de onde sai o ramo (em baixo, à esquerda).
	const T_SAIDA = (Math.PI * 5) / 4;
	const CABECALHO = 68;

	// Arranca depois de a página carregar, quando o navegador está livre, para não pesar no
	// carregamento (TBT).
	const arranca = () => {
		for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-elemento]')) inicia(canvas);
	};
	const livre = () => ('requestIdleCallback' in window ? requestIdleCallback(arranca, { timeout: 800 }) : setTimeout(arranca, 200));
	if (document.readyState === 'complete') livre();
	else addEventListener('load', livre, { once: true });

	function inicia(canvas: HTMLCanvasElement) {
		const raiz = canvas.closest<HTMLElement>('[data-hero-raiz]')!;
		const palco = raiz.querySelector<HTMLElement>('[data-palco]')!;
		const ctx = canvas.getContext('2d')!;
		const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const tokens = getComputedStyle(raiz);
		const roxo = tokens.getPropertyValue('--elemento-roxo').trim() || '#c3a6ff';
		const verde = tokens.getPropertyValue('--elemento-verde').trim() || '#86d9a8';
		const brilhos = [brilho(roxo), brilho(verde), brilho('#ffffff')];
		const pontos = Array.from({ length: 340 }, (_, i) => ({
			t: (i / 340) * TAU,
			r: Math.sqrt(Math.random()) * 0.08,
			a: Math.random() * TAU,
			v: 0.75 + Math.random() * 0.5,
			s: 0.55 + Math.random() * 0.95,
		}));

		// Geometria em coordenadas do bloco .inicio (px CSS), «recolhidas»: tudo o que vem depois
		// dos Serviços presos sobe o percurso que o scroll gasta com os cartões. Assim, enquanto a
		// secção está presa, o ramo também fica parado no ecrã.
		let inf = { x: 0, y: 0, escala: 0 };
		let lut: Amostra[] = [];
		let total = 0;
		let lenHero = 0;
		let folhas: Folha[] = [];
		let nos: No[] = [];
		let quem = { ini: Infinity, fim: -1 };
		let pino = { ini: 0, percurso: 0, lenTitulo: Infinity };
		// Etapas presas: as marcas ligam o progresso da passagem (0…1) ao comprimento do ramo.
		let pinoEt = { ini: 0, percurso: 0, marcas: [] as [number, number][] };
		let hastePts = { off: new Float32Array(0), fase: new Float32Array(0), cor: new Uint8Array(0), esp: 9 };

		let dpr = 1;
		let w = 0;
		let h = 0;
		let pequeno = false;
		let visivel = false;
		let pedido = 0;
		let antes = 0;
		let tempo = 0;
		let fase = 0;
		let fluxo = 0;
		let impulso = 0;
		let atual = 0;
		let intro = reduz ? 0 : -1;
		let ultimoScroll = scrollY;

		const corre = () => !reduz && document.documentElement.dataset.animacao !== 'pausada';
		// Scroll em coordenadas do bloco, sem o percurso gasto pelas secções presas (Serviços e Etapas).
		const gasto = (S: number, p: { ini: number; percurso: number }) => Math.min(Math.max(S - p.ini, 0), p.percurso);
		const scrollVirtual = (S: number) => S - gasto(S, pino) - gasto(S, pinoEt);
		const progressoPino = (S: number) => (pino.percurso ? Math.min(Math.max((S - pino.ini) / pino.percurso, 0), 1) : 1);
		const progressoEt = (S: number) => (pinoEt.percurso ? Math.min(Math.max((S - pinoEt.ini) / pinoEt.percurso, 0), 1) : 1);
		// Comprimento do ramo nas Etapas presas: linear entre as marcas (entrada, cada nó, saída).
		const emEtapas = (p: number) => {
			const m = pinoEt.marcas;
			for (let i = 1; i < m.length; i++) {
				if (p <= m[i][0]) return m[i - 1][1] + ((p - m[i - 1][0]) / (m[i][0] - m[i - 1][0] || 1)) * (m[i][1] - m[i - 1][1]);
			}
			return m[m.length - 1][1];
		};

		function geometria() {
			const base = raiz.getBoundingClientRect();
			const R = (e: Element) => {
				const r = e.getBoundingClientRect();
				return { x: r.left - base.left, y: r.top - base.top, w: r.width, h: r.height, b: r.bottom - base.top, d: r.right - base.left };
			};
			const q = (s: string, de: ParentNode = raiz) => de.querySelector<HTMLElement>(s)!;
			const larg = raiz.clientWidth;

			// Serviços: medidas em repouso (o palco preso pode estar deslocado) e percurso do pino.
			const servicos = q('[data-pista]');
			const fixa = servicos.hasAttribute('data-fixa');
			const sR = R(servicos);
			const palcoServ = q('.pista-palco', servicos);
			const percurso = fixa ? Number(servicos.dataset.percurso ?? 0) : 0;
			const desvio = fixa ? R(palcoServ).y - sR.y : 0;
			const fimServ = sR.y + sR.h;
			// Etapas: o mesmo, com a sua própria passagem presa.
			const etapasSec = q('[data-etapas]');
			const fixaEt = etapasSec.hasAttribute('data-fixa');
			const eR = R(etapasSec);
			const percursoEt = fixaEt ? Number(etapasSec.dataset.percurso ?? 0) : 0;
			const desvioEt = fixaEt ? R(q('.etapas-palco', etapasSec)).y - eR.y : 0;
			const fimEt = eR.y + eR.h;
			const C = (e: Element) => {
				const r = R(e);
				let d = r.y >= fimServ - 1 ? percurso : e !== servicos && servicos.contains(e) ? desvio : 0;
				d += r.y >= fimEt - 1 ? percursoEt : e !== etapasSec && etapasSec.contains(e) ? desvioEt : 0;
				return { ...r, y: r.y - d, b: r.b - d };
			};
			pino = { ini: sR.y - CABECALHO, percurso, lenTitulo: Infinity };
			pinoEt = { ini: eR.y - CABECALHO, percurso: percursoEt, marcas: [] };

			const pal = R(palco);
			const texto = R(q('.hero-texto'));
			const hero = R(q('section'));
			const mx = Math.max(9, texto.x - 34);
			const mxD = larg - mx;
			const tamFolha = mx < 40 ? 12 : 30;

			inf = { x: pal.x + pal.w / 2, y: pal.y + pal.h / 2, escala: pal.w * (pequeno ? 0.44 : 0.5) };
			const c = curva(T_SAIDA);
			const [sx, sy] = projeta(c[0], c[1], c[2], 0.5, -0.4);
			const saida = { x: inf.x + sx * inf.escala, y: inf.y + sy * inf.escala };

			const pts: Pt[] = [saida];
			const folhasPt: { pt: Pt; ang: number; tam: number; pino?: number }[] = [];
			const nosPt: Pt[] = [];
			if (pal.x > texto.x + texto.w * 0.5) {
				// Desce junto ao palco até passar o texto e só depois vira para a margem.
				const y = Math.max(texto.b, pal.b) + 30;
				pts.push({ x: pal.x + pal.w * 0.08, y: y - 14 });
				pts.push({ x: texto.x + texto.w * 0.5, y });
				pts.push({ x: mx + 40, y: y + 30 });
				pts.push({ x: mx, y: Math.max(y + 110, hero.b) });
			} else {
				pts.push({ x: mx + 40, y: pal.b + 30 });
				pts.push({ x: mx, y: pal.b + 100 });
			}
			const fimHero = pts[pts.length - 1];

			// Desce na vertical em x, com uma ligeira onda; cruza na horizontal para outro x.
			const onda = Math.min(7, mx - 4);
			const desce = (y: number, x = pts[pts.length - 1].x) => {
				const ult = pts[pts.length - 1];
				if (y - ult.y > 70) pts.push({ x: x + (pts.length % 2 ? onda : -onda), y: (ult.y + y) / 2 });
				const pt = { x, y };
				pts.push(pt);
				return pt;
			};
			const cruza = (y: number, x: number) => {
				const ult = pts[pts.length - 1];
				if (y - 40 > ult.y) desce(y - 40);
				const s = Math.sign(x - ult.x);
				pts.push({ x: ult.x + s * 50, y }, { x: x - s * 50, y }, { x, y: y + 40 });
			};
			const foraDaMargem = () => Math.abs(pts[pts.length - 1].x - mx) > 12;
			// Um par de folhas: uma para dentro e, se houver margem, outra para fora.
			const par = (pt: Pt) => {
				const d = pt.x > larg / 2;
				folhasPt.push({ pt, ang: d ? -142 : -38, tam: tamFolha });
				if (mx > 40) folhasPt.push({ pt, ang: d ? -32 : -148, tam: tamFolha * 0.8 });
			};

			const seccoes = [...raiz.querySelectorAll<HTMLElement>(':scope > section')].slice(1);
			const final = seccoes.pop()!;
			let lenTituloPt: Pt | null = null;
			let entradaEt: Pt | null = null;
			let saidaEt: Pt | null = null;
			let quemPts: Pt[] = [];
			let depoisGarantia = false;
			for (const s of seccoes) {
				const sC = C(s);
				const primeiro = C(s.firstElementChild ?? s);
				if (s === servicos) {
					if (fixa) {
						// Presos: o ramo fica ao lado do título, com uma folha por cartão (crescem com o
						// progresso dos cartões); quando a secção solta, atravessa por baixo do título e
						// desce pela direita, que é a margem livre no fim da passagem dos cartões.
						const titulo = C(q('.pista-titulo', s));
						for (let k = 0; k < 4; k++) {
							const pt = desce(titulo.y + 8 + (k * (titulo.h - 8)) / 3);
							folhasPt.push({ pt, ang: k % 2 ? -150 : -35, tam: tamFolha, pino: k });
						}
						lenTituloPt = pts[pts.length - 1];
						const cab = C(q('.pista-cab', s));
						const pista = C(q('.pista', s));
						cruza((cab.b + pista.y) / 2, mxD);
						desce(sR.y + palcoServ.offsetHeight - 20);
					} else {
						for (const cr of [...s.querySelectorAll('[data-cartao]')].map(C)) par(desce(cr.y + 20));
					}
					continue;
				}
				if (s.id.endsWith('-etapas')) {
					const h2 = C(q('h2', s));
					if (foraDaMargem()) cruza((sC.y + h2.y) / 2, mx);
					entradaEt = desce(h2.b + 14, mx);
					// Etapas: um nó por cima de cada número; no computador o ramo segue os degraus.
					const nums = [...s.querySelectorAll('.num-etapa')].map(C);
					const emLinha = nums[1].y < nums[0].y + nums[0].h;
					for (const n of nums) {
						const pt = emLinha ? { x: n.x + 8, y: n.y - 14 } : { x: mx, y: n.y + 22 };
						if (emLinha) pts.push(pt);
						else desce(pt.y);
						nosPt.push(pt);
					}
					if (emLinha) {
						const ult = nosPt[nosPt.length - 1];
						saidaEt = { x: ult.x + 90, y: ult.y + 6 };
						pts.push(saidaEt, { x: mxD, y: ult.y + 60 });
					}
					continue;
				}
				if (s.id.endsWith('-garantia')) {
					par(desce(primeiro.y + 12));
					depoisGarantia = true;
					continue;
				}
				if (depoisGarantia && foraDaMargem()) {
					// Volta à esquerda no espaço entre a Garantia e o gráfico.
					cruza(sC.y, mx);
					depoisGarantia = false;
				}
				if (s.classList.contains('quem')) {
					// Só o traço roxo: meia volta pelo arco de cima da fotografia, de ponta a ponta,
					// e depois desce junto à fotografia (ou pela margem direita, se o texto vier por baixo).
					const foto = C(q('.foto', s));
					const txt = C(q('.quem-texto', s));
					const raio = foto.w / 2 + 16;
					const cx = foto.x + foto.w / 2;
					const cy = foto.y + foto.w / 2;
					desce(cy, cx - raio);
					const ini = pts.length - 1;
					for (let a = 1; a <= 12; a++) {
						const t = Math.PI + (a / 12) * Math.PI;
						pts.push({ x: cx + raio * Math.cos(t), y: cy + raio * Math.sin(t) });
					}
					const xDesce = txt.y > foto.y + foto.h / 2 ? mxD : cx + raio;
					if (xDesce !== cx + raio) pts.push({ x: xDesce, y: cy + 60 });
					desce(sC.b - 30, xDesce);
					quemPts = [pts[ini], pts[pts.length - 1]];
					continue;
				}
				// Volta à margem esquerda no espaço antes da secção (p. ex. depois de «Quem é o Julien»).
				if (foraDaMargem()) cruza(sC.y, mx);
				par(desce(primeiro.y + 12));
			}
			const botao = C(q('.botao', final));
			if (foraDaMargem()) cruza(C(final).y, mx);
			const fim = desce(botao.y + botao.h / 2);
			folhasPt.push({ pt: fim, ang: -70, tam: tamFolha * 1.2 }, { pt: fim, ang: -15, tam: tamFolha }, { pt: fim, ang: -125, tam: tamFolha * 0.85 });

			lut = amostras(pts);
			total = lut[lut.length - 1].l;
			lenHero = comprimentoEm(fimHero);
			// Duas folhas no caminho do Hero, entre o ∞ e a margem.
			for (const [k, lado] of [
				[0.35, -40],
				[0.7, 40],
			]) {
				folhasPt.push({ pt: ponto(lenHero * k), ang: angulo(lenHero * k) + lado, tam: tamFolha });
			}
			folhas = folhasPt.map((f) => ({ ...f.pt, l: comprimentoEm(f.pt), ang: f.ang, tam: f.tam, pino: f.pino }));
			nos = nosPt.map((n) => ({ ...n, l: comprimentoEm(n) }));
			quem = quemPts.length ? { ini: comprimentoEm(quemPts[0]), fim: comprimentoEm(quemPts[1]) } : { ini: Infinity, fim: -1 };
			if (lenTituloPt) pino.lenTitulo = comprimentoEm(lenTituloPt);
			if (pinoEt.percurso && entradaEt && saidaEt && nos.length) {
				const N = nos.length;
				pinoEt.marcas = [
					[0, comprimentoEm(entradaEt)],
					...nos.map((nd, k) => [(k + 0.5) / N, nd.l] as [number, number]),
					[1, comprimentoEm(saidaEt)],
				];
			}

			const esp = pequeno ? 11 : 9;
			const n = Math.ceil(total / esp);
			hastePts = { off: new Float32Array(n), fase: new Float32Array(n), cor: new Uint8Array(n), esp };
			for (let i = 0; i < n; i++) {
				hastePts.off[i] = (Math.random() - 0.5) * 7;
				hastePts.fase[i] = Math.random() * TAU;
				hastePts.cor[i] = Math.random() < 0.2 ? 1 : 0;
			}
			if (reduz) atual = total;
		}

		function comprimentoEm(pt: Pt) {
			let melhor = 0;
			let dist = Infinity;
			for (const a of lut) {
				const d = Math.hypot(a.x - pt.x, a.y - pt.y);
				if (d < dist) {
					dist = d;
					melhor = a.l;
				}
			}
			return melhor;
		}

		// Ponto e direção da haste a um comprimento, por pesquisa binária nas amostras.
		const dir = { x: 0, y: 0 };
		function ponto(l: number): Pt {
			let a = 0;
			let b = lut.length - 1;
			while (b - a > 1) {
				const m = (a + b) >> 1;
				if (lut[m].l < l) a = m;
				else b = m;
			}
			const A = lut[a];
			const B = lut[b];
			const seg = B.l - A.l || 1;
			const k = Math.min(Math.max((l - A.l) / seg, 0), 1);
			dir.x = (B.x - A.x) / seg;
			dir.y = (B.y - A.y) / seg;
			return { x: A.x + (B.x - A.x) * k, y: A.y + (B.y - A.y) * k };
		}

		function angulo(l: number) {
			ponto(l);
			return (Math.atan2(dir.y, dir.x) * 180) / Math.PI;
		}

		// Até onde o ramo cresceu: até à linha a 62 % do ecrã (em coordenadas recolhidas). O caminho
		// do Hero aparece todo quando o palco está inteiro à vista; nos Serviços presos, o ramo para
		// ao lado do título até os cartões acabarem; no fundo da página, fica completo.
		function alvo(S: number, vS: number) {
			if (scrollY + innerHeight >= document.documentElement.scrollHeight - 2) return total;
			const linha = vS + innerHeight * 0.62;
			let len = 0;
			for (const a of lut) {
				if (a.y <= linha) len = a.l;
				else if (a.y > linha + 160) break;
			}
			if (pino.percurso && S < pino.ini + pino.percurso) len = Math.min(len, pino.lenTitulo);
			// Nas Etapas presas, o ramo avança com o progresso da passagem: uma etapa de cada vez.
			if (pinoEt.marcas.length && S < pinoEt.ini + pinoEt.percurso) len = Math.min(len, emEtapas(progressoEt(S)));
			const r = palco.getBoundingClientRect();
			return r.bottom <= innerHeight && r.top >= 0 ? Math.max(lenHero, len) : len;
		}

		function quadro(agora: number) {
			pedido = 0;
			if (!visivel || !lut.length) return;
			const dt = antes ? Math.min((agora - antes) / 1000, 0.05) : 0;
			antes = agora;
			const delta = scrollY - ultimoScroll;
			ultimoScroll = scrollY;
			const caixa = raiz.getBoundingClientRect();
			const S = -caixa.top;
			const vS = scrollVirtual(S);
			const destino = reduz ? total : alvo(S, vS);

			if (!reduz) {
				if (intro < 0) intro = agora;
				if (intro) {
					const k = Math.min((agora - intro) / 1800, 1);
					atual = destino * (1 - (1 - k) ** 3);
					if (k === 1) intro = 0;
				} else {
					atual += (destino - atual) * 0.14;
					if (Math.abs(destino - atual) < 0.5) atual = destino;
				}
				impulso += Math.abs(delta) * 0.003;
				impulso *= Math.pow(0.04, dt);
				if (corre()) {
					tempo += dt;
					fase += (0.22 + impulso) * dt;
					fluxo += (26 + impulso * 300) * dt;
				}
			}
			desenha(vS, caixa.left, progressoPino(S));
			if (corre() || intro || atual !== destino || impulso > 0.002) pedir();
			else antes = 0;
		}

		function desenha(vS: number, esq: number, pPino: number) {
			ctx.setTransform(dpr, 0, 0, dpr, esq * dpr, -vS * dpr);
			ctx.clearRect(-esq, vS, w / dpr, h / dpr);
			const vTopo = vS - 40;
			const vFim = vS + h / dpr + 40;
			const visto = (y: number) => y > vTopo && y < vFim;

			// O ramo: um traço fino e pontos que correm ao longo dele, em hélice.
			ctx.globalCompositeOperation = 'source-over';
			ctx.globalAlpha = 0.28;
			ctx.strokeStyle = roxo;
			ctx.lineWidth = 1.2;
			ctx.beginPath();
			let comecou = false;
			for (const a of lut) {
				if (a.l > atual) break;
				if (!visto(a.y)) {
					comecou = false;
					continue;
				}
				if (comecou) ctx.lineTo(a.x, a.y);
				else ctx.moveTo(a.x, a.y);
				comecou = true;
			}
			if (atual > 0 && comecou) {
				const p = ponto(atual);
				ctx.lineTo(p.x, p.y);
			}
			ctx.stroke();

			// Só as partículas do troço visível: o comprimento entre a primeira e a última amostra no ecrã.
			let lMin = Infinity;
			let lMax = -1;
			for (const a of lut) {
				if (a.l > atual) break;
				if (!visto(a.y)) continue;
				if (a.l < lMin) lMin = a.l;
				lMax = a.l;
			}
			ctx.globalCompositeOperation = 'lighter';
			const { off, fase: fs, cor, esp } = hastePts;
			const n = off.length;
			const fim = Math.min(lMax + esp, atual);
			for (let s = lMin - ((((lMin - fluxo) % esp) + esp) % esp); s <= fim; s += esp) {
				if (s < 0) continue;
				const i = ((Math.round((s - fluxo) / esp) % n) + n) % n;
				const p = ponto(s);
				if (!visto(p.y)) continue;
				const ang = fs[i] + s * 0.045 + tempo * 1.4;
				const prof = Math.sin(ang);
				const o = off[i] * Math.cos(ang);
				const x = p.x - dir.y * o;
				const y = p.y + dir.x * o;
				const entra = Math.min(s / 40, 1);
				const tam = (3 + prof * 1) * (pequeno ? 0.85 : 1);
				// Em «Quem é o Julien» o ramo é só roxo.
				const c = s > quem.ini && s < quem.fim ? 0 : cor[i];
				ctx.globalAlpha = (0.55 + prof * 0.35) * entra;
				ctx.drawImage(brilhos[c], x - tam, y - tam, tam * 2, tam * 2);
			}

			// Nós das Etapas: um ponto roxo mais forte em cada degrau, quando o ramo lá chega.
			for (const nd of nos) {
				if (nd.l > atual || !visto(nd.y)) continue;
				const g = Math.min((atual - nd.l) / 30, 1);
				ctx.globalAlpha = 0.95;
				ctx.drawImage(brilhos[0], nd.x - 12 * g, nd.y - 12 * g, 24 * g, 24 * g);
				ctx.drawImage(brilhos[2], nd.x - 3.5 * g, nd.y - 3.5 * g, 7 * g, 7 * g);
			}

			// As folhas, feitas de pontos verdes, crescem quando a ponta do ramo passa por elas; as
			// dos Serviços presos crescem com os cartões. As do fim abrem quando o ramo fica completo.
			for (const f of folhas) {
				if (f.l > atual || !visto(f.y)) continue;
				let g = atual >= total - 0.5 ? 1 : Math.min((atual - f.l) / 60, 1);
				if (f.pino !== undefined && pino.percurso) g = Math.min(Math.max((pPino - f.pino / 3) * 6 + 1, 0), 1);
				if (g > 0) desenhaFolha(f, 1 - (1 - g) ** 2);
			}

			// A ponta do ramo, enquanto cresce.
			if (atual > 0 && atual < total - 1) {
				const p = ponto(atual);
				ctx.globalAlpha = 0.9;
				ctx.drawImage(brilhos[1], p.x - 9, p.y - 9, 18, 18);
				ctx.drawImage(brilhos[2], p.x - 3, p.y - 3, 6, 6);
			}

			desenhaInfinito(vS);
			ctx.globalAlpha = 1;
		}

		function desenhaFolha(f: Folha, g: number) {
			const L = f.tam * g;
			const W = L * 0.32;
			const balanco = corre() ? Math.sin(tempo * 1.3 + f.l * 0.01) * 5 : 0;
			const a = ((f.ang + balanco) * Math.PI) / 180;
			ctx.save();
			ctx.translate(f.x, f.y);
			ctx.rotate(a);
			ctx.globalCompositeOperation = 'source-over';
			ctx.globalAlpha = 0.16;
			ctx.fillStyle = verde;
			ctx.beginPath();
			ctx.moveTo(0, 0);
			ctx.quadraticCurveTo(L / 2, -W * 1.4, L, 0);
			ctx.quadraticCurveTo(L / 2, W * 1.4, 0, 0);
			ctx.fill();
			ctx.globalCompositeOperation = 'lighter';
			const n = L > 20 ? 7 : 4;
			for (let k = 1; k <= n; k++) {
				const u = k / (n + 1);
				const y = W * Math.sin(Math.PI * u) ** 0.8;
				const x = u * L;
				const tam = L > 20 ? 2.4 : 1.8;
				ctx.globalAlpha = 0.8;
				ctx.drawImage(brilhos[1], x - tam, -y - tam, tam * 2, tam * 2);
				ctx.drawImage(brilhos[1], x - tam, y - tam, tam * 2, tam * 2);
				if (k % 2) {
					ctx.globalAlpha = 0.45;
					ctx.drawImage(brilhos[1], x - tam * 0.8, -tam * 0.8, tam * 1.6, tam * 1.6);
				}
			}
			ctx.globalAlpha = 0.9;
			ctx.drawImage(brilhos[1], L - 2.5, -2.5, 5, 5);
			ctx.restore();
		}

		function desenhaInfinito(vS: number) {
			const yEcra = inf.y - vS;
			if (yEcra < -inf.escala || yEcra > h / dpr + inf.escala) return;
			// Progresso do scroll: 0 enquanto o ∞ está no meio do ecrã ou abaixo.
			const p = reduz ? 0 : Math.min(Math.max((innerHeight / 2 - yEcra) / (innerHeight * 0.6), 0), 1);
			const ay = -0.4 + p * 0.6 + (corre() ? 0.12 * Math.sin(tempo * 0.35) : 0);
			const ax = 0.5 + p * 0.3;
			const E = inf.escala;

			ctx.globalCompositeOperation = 'source-over';
			ctx.lineWidth = 1;
			for (const [lado, cor] of [
				[-1, roxo],
				[1, verde],
			] as const) {
				ctx.beginPath();
				for (let i = 0; i <= 90; i++) {
					const t = (lado < 0 ? Math.PI / 2 : -Math.PI / 2) + (i / 90) * Math.PI;
					const c = curva(t);
					const [x, y] = projeta(c[0], c[1], c[2], ax, ay);
					if (i) ctx.lineTo(inf.x + x * E, inf.y + y * E);
					else ctx.moveTo(inf.x + x * E, inf.y + y * E);
				}
				ctx.strokeStyle = cor;
				ctx.globalAlpha = 0.22;
				ctx.stroke();
			}

			ctx.globalCompositeOperation = 'lighter';
			const base = E * 0.026;
			for (let i = 0; i < pontos.length; i++) {
				if (pequeno && i % 3 === 2) continue;
				const q = pontos[i];
				const t = q.t + fase * q.v;
				const c = curva(t);
				const d = curva(t + 0.002);
				// Tangente T e duas normais (n1 no plano, n2 = T × n1) para afastar o ponto do eixo.
				const tl = Math.hypot(d[0] - c[0], d[1] - c[1], d[2] - c[2]) || 1;
				const tx = (d[0] - c[0]) / tl;
				const ty = (d[1] - c[1]) / tl;
				const tz = (d[2] - c[2]) / tl;
				const nl = Math.hypot(tx, ty) || 1;
				const n1x = -ty / nl;
				const n1y = tx / nl;
				const ang = q.a + fase * 0.6;
				const ca = Math.cos(ang) * q.r;
				const sa = Math.sin(ang) * q.r;
				const [x, y, z, k] = projeta(
					c[0] + ca * n1x - sa * tz * n1y,
					c[1] + ca * n1y + sa * tz * n1x,
					c[2] + sa * (tx * n1y - ty * n1x),
					ax,
					ay,
				);
				const prof = Math.min(Math.max(0.3 + (z + 1.2) * 0.32, 0.2), 1);
				const tam = base * q.s * k;
				const m = Math.min(Math.max((c[0] + 0.12) / 0.24, 0), 1);
				const px = inf.x + x * E;
				const py = inf.y + y * E;
				if (m < 0.98) {
					ctx.globalAlpha = prof * (1 - m);
					ctx.drawImage(brilhos[0], px - tam, py - tam, tam * 2, tam * 2);
				}
				if (m > 0.02) {
					ctx.globalAlpha = prof * m;
					ctx.drawImage(brilhos[1], px - tam, py - tam, tam * 2, tam * 2);
				}
			}
		}

		function pedir() {
			if (!pedido) pedido = requestAnimationFrame(quadro);
		}

		addEventListener('scroll', pedir, { passive: true });
		document.addEventListener('animacao', () => {
			antes = 0;
			pedir();
		});
		new IntersectionObserver(([e]) => {
			visivel = e.isIntersecting;
			antes = 0;
			pedir();
		}).observe(raiz);
		let espera = 0;
		const redimensiona = () => {
			cancelAnimationFrame(espera);
			espera = requestAnimationFrame(() => {
				pequeno = innerWidth < 700;
				// O canvas cobre o ecrã todo: 1,5 chega para pontos com brilho e poupa muito trabalho.
				dpr = Math.min(devicePixelRatio || 1, 1.5);
				w = canvas.width = Math.round(canvas.clientWidth * dpr);
				h = canvas.height = Math.round(canvas.clientHeight * dpr);
				geometria();
				pedir();
			});
		};
		new ResizeObserver(redimensiona).observe(raiz);
		new ResizeObserver(redimensiona).observe(canvas);
	}

	// Lemniscata de Bernoulli com profundidade: as duas voltas cruzam-se a alturas diferentes.
	function curva(t: number) {
		const s = Math.sin(t);
		const c = Math.cos(t);
		const d = 1 + s * s;
		return [c / d, (s * c) / d, 0.3 * s];
	}

	// Roda em y e em x e projeta com perspetiva; devolve x, y (unidades do ∞), z e o fator k.
	function projeta(x: number, y: number, z: number, ax: number, ay: number) {
		const cy = Math.cos(ay);
		const sy = Math.sin(ay);
		const cx = Math.cos(ax);
		const sx = Math.sin(ax);
		const X = x * cy + z * sy;
		let Z = -x * sy + z * cy;
		const Y = y * cx - Z * sx;
		Z = y * sx + Z * cx;
		const k = 3 / (3 - Z);
		return [X * k, Y * k, Z, k];
	}

	// Curva suave (Catmull-Rom) pelos pontos, com tangentes limitadas a um terço de cada troço,
	// amostrada com o comprimento acumulado.
	function amostras(p: Pt[]) {
		const tan = (a: Pt, c: Pt, max: number) => {
			const x = (c.x - a.x) / 6;
			const y = (c.y - a.y) / 6;
			const k = Math.min(1, max / (Math.hypot(x, y) || 1));
			return { x: x * k, y: y * k };
		};
		const lut: Amostra[] = [{ ...p[0], l: 0 }];
		for (let i = 0; i < p.length - 1; i++) {
			const b = p[i];
			const c = p[i + 1];
			const max = Math.hypot(c.x - b.x, c.y - b.y) / 3;
			const t1 = tan(p[i - 1] ?? b, c, max);
			const t2 = tan(b, p[i + 2] ?? c, max);
			const c1 = { x: b.x + t1.x, y: b.y + t1.y };
			const c2 = { x: c.x - t2.x, y: c.y - t2.y };
			for (let k = 1; k <= 16; k++) {
				const t = k / 16;
				const u = 1 - t;
				const x = u * u * u * b.x + 3 * u * u * t * c1.x + 3 * u * t * t * c2.x + t * t * t * c.x;
				const y = u * u * u * b.y + 3 * u * u * t * c1.y + 3 * u * t * t * c2.y + t * t * t * c.y;
				const ant = lut[lut.length - 1];
				lut.push({ x, y, l: ant.l + Math.hypot(x - ant.x, y - ant.y) });
			}
		}
		return lut;
	}

	function brilho(cor: string) {
		const c = document.createElement('canvas');
		c.width = c.height = 64;
		const g = c.getContext('2d')!;
		const [r, v, a] = [1, 3, 5].map((i) => parseInt(cor.slice(i, i + 2), 16));
		const gr = g.createRadialGradient(32, 32, 0, 32, 32, 32);
		gr.addColorStop(0, 'rgba(255,255,255,0.95)');
		gr.addColorStop(0.16, `rgba(${r},${v},${a},1)`);
		gr.addColorStop(0.42, `rgba(${r},${v},${a},0.28)`);
		gr.addColorStop(1, `rgba(${r},${v},${a},0)`);
		g.fillStyle = gr;
		g.fillRect(0, 0, 64, 64);
		return c;
	}
</script>


<style>
	.elemento {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 2;
		pointer-events: none;
	}
</style>
