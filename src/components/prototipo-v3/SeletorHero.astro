---
// PROTÓTIPO v3 · Escolha do elemento do Hero na variante A (#53): ∞ contínuo, ∞ só com o
// scroll ou ramo. Fica por cima da barra do protótipo e não faz parte do design. A escolha
// vem de ?hero= no endereço ou da última escolha guardada neste navegador.
const opcoes = [
	{ id: 'inf-cont', nome: '∞ contínuo' },
	{ id: 'inf-scroll', nome: '∞ só scroll' },
	{ id: 'ramo', nome: 'Ramo' },
];
---

<div class="seletor-hero" role="group" aria-label="Protótipo: elemento do Hero" data-seletor-hero>
	<div class="linha">
		<span class="tag">Hero</span>
		{
			opcoes.map((o, i) => (
				<button type="button" data-hero-opcao={o.id} aria-pressed={i === 0 ? 'true' : 'false'}>
					{o.nome}
				</button>
			))
		}
	</div>
	<p class="desc" data-hero-desc aria-live="polite"></p>
</div>

<script>
	const descricoes: Record<string, string> = {
		'inf-cont': 'O fluxo corre sempre devagar; o scroll roda o ∞ e acelera-o. Tem botão de pausa.',
		'inf-scroll': 'Parado até a página descer; o fluxo segue o scroll, também para trás.',
		ramo: 'Cresce com o scroll do Hero às Etapas: um nó por secção, 4 ramos em Serviços, 5 nós nas Etapas.',
	};
	const CHAVE = 'prototipo-v3-hero';

	for (const sel of document.querySelectorAll<HTMLElement>('[data-seletor-hero]')) {
		const raiz = sel.closest<HTMLElement>('[data-hero-raiz]')!;
		const botoes = [...sel.querySelectorAll<HTMLButtonElement>('[data-hero-opcao]')];
		const desc = sel.querySelector<HTMLElement>('[data-hero-desc]')!;
		const aplica = (m: string) => {
			raiz.dataset.hero = m;
			for (const b of botoes) b.setAttribute('aria-pressed', String(b.dataset.heroOpcao === m));
			desc.textContent = descricoes[m];
			raiz.dispatchEvent(new CustomEvent('hero-muda'));
		};
		let guardado: string | null = null;
		try {
			guardado = localStorage.getItem(CHAVE);
		} catch {}
		const pedido = new URLSearchParams(location.search).get('hero') ?? guardado ?? 'inf-cont';
		aplica(pedido in descricoes ? pedido : 'inf-cont');
		for (const b of botoes) {
			b.addEventListener('click', () => {
				aplica(b.dataset.heroOpcao!);
				try {
					localStorage.setItem(CHAVE, b.dataset.heroOpcao!);
				} catch {}
			});
		}
	}
</script>

<style>
	.seletor-hero {
		position: fixed;
		left: 0;
		right: 0;
		margin-inline: auto;
		width: fit-content;
		max-width: calc(100vw - 24px);
		bottom: calc(68px + env(safe-area-inset-bottom, 0px));
		z-index: 60;
		display: grid;
		gap: 0.2rem;
		padding: 0.3rem 0.35rem 0.4rem;
		border-radius: 14px;
		background: #ffffff;
		color: #111111;
		box-shadow:
			0 8px 28px rgb(0 0 0 / 0.5),
			0 0 0 1px rgb(0 0 0 / 0.08);
		font: 500 0.8125rem/1.2 system-ui, -apple-system, 'Segoe UI', sans-serif;
	}
	.linha {
		display: flex;
		align-items: center;
		gap: 0.2rem;
	}
	.tag {
		font-size: 0.625rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.2rem 0.45rem;
		border-radius: 4px;
		background: #fff3c4;
		color: #5c4400;
		margin-inline: 0.2rem;
	}
	button {
		min-height: 34px;
		padding: 0 0.7rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: #111111;
		font: inherit;
		cursor: pointer;
		white-space: nowrap;
	}
	button:hover {
		background: #ececec;
	}
	button[aria-pressed='true'] {
		background: #111111;
		color: #ffffff;
	}
	button:focus-visible {
		outline: 2px solid #5b3fd1;
		outline-offset: 1px;
	}
	.desc {
		margin: 0;
		padding-inline: 0.5rem;
		/* O texto segue a largura dos botões em vez de alargar a barra. */
		width: 0;
		min-width: 100%;
		font-size: 0.75rem;
		font-weight: 400;
		color: #444444;
	}
</style>
