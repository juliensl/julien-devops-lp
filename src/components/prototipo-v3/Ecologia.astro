---
// PROTÓTIPO v3 · Página de ecologia (corpo), partilhada pelos três protótipos com o
// tema de cada um. Não mostra dados ambientais dos fornecedores (validado pelo Julien
// a 19/10/2026). Tem um estimador por país, com o método à vista: emissões da
// eletricidade, location-based, intensidade de ciclo de vida da Ember (2025).
// Distingue sempre dados publicados, hipóteses e cálculos.
import Folha from './Folha.astro';
import { regioes, coeficientes, utilizacaoCcf, pueSetor, fontesEco, nomesEstado, calendly, textos, type P, type Modo } from './dados';
import { ligacao } from './temas';

interface Props {
	p: P;
	modo: Modo;
}
const { p, modo } = Astro.props;
const dados = { regioes, coeficientes, pue: pueSetor };
const pre = `p${p}-eco`;
const inicial = 'fr';
const virgula = (n: number) => String(n).replace('.', ',');
---

<div class:list={['eco', `eco-p${p}`]} data-eco>
	<section class="largura eco-hero">
		<div class="eco-hero-texto">
			<p class="etiqueta"><Folha tamanho={16} /> Ecologia e infraestrutura</p>
			<h1>As escolhas de infraestrutura também têm consequências ambientais.</h1>
			<p class="lead">
				Onde a aplicação corre, quanto tempo corre e com que eficiência mudam a energia que consome e as emissões da
				eletricidade que usa. Aqui estimas uma carga, conforme o país onde corre, com o método e as fontes à vista.
			</p>
		</div>
		<ul class="legenda-estados" aria-label="Como ler os dados desta página">
			<li>
				<span class="selo publicado">{nomesEstado.publicado}</span> valor de uma base de dados ou de um estudo públicos, com ano e fonte
			</li>
			<li><span class="selo hipotese">{nomesEstado.hipotese}</span> pressuposto do cálculo, que podes mudar</li>
			<li><span class="selo calculado">{nomesEstado.calculado}</span> resultado dos dois anteriores</li>
		</ul>
	</section>

	<section class="largura bloco-eco" id={`${pre}-estimar`}>
		<div class="cab-bloco">
			<div>
				<p class="etiqueta">1 · Estimar uma carga</p>
				<h2>A mesma aplicação, em sítios diferentes.</h2>
			</div>
			<p class="intro">
				Escolhe o país, a carga e a eficiência do centro de dados. O cálculo segue o método aberto do Cloud Carbon
				Footprint: energia dos processadores × eficiência do centro de dados × intensidade carbónica da eletricidade.
			</p>
		</div>
		<div class="estimador">
			<form class="controlos" data-controlos>
				<div class="campo">
					<label for={`${pre}-regiao`}>País onde corre a infraestrutura</label>
					<select id={`${pre}-regiao`} name="regiao">
						{
							regioes.map((r) => (
								<option value={r.id} selected={r.id === inicial}>
									{r.nome}
								</option>
							))
						}
					</select>
				</div>
				<div class="campo">
					<label for={`${pre}-vcpu`}>Processadores virtuais (vCPU) <output data-o="vcpu">8</output></label>
					<input type="range" id={`${pre}-vcpu`} name="vcpu" min="1" max="64" step="1" value="8" />
				</div>
				<div class="campo">
					<label for={`${pre}-uso`}>Utilização média <output data-o="uso">{utilizacaoCcf} %</output></label>
					<input type="range" id={`${pre}-uso`} name="uso" min="5" max="100" step="5" value={utilizacaoCcf} />
					<span class="dica"
						><span class="selo hipotese">Hipótese</span> {utilizacaoCcf} % é o valor do CCF quando não se conhece a utilização</span
					>
				</div>
				<div class="campo">
					<label for={`${pre}-horas`}>Horas por dia <output data-o="horas">24 h</output></label>
					<input type="range" id={`${pre}-horas`} name="horas" min="1" max="24" step="1" value="24" />
				</div>
				<div class="campo">
					<label for={`${pre}-pue`}>Eficiência do centro de dados (PUE) <output data-o="pue">{virgula(pueSetor)}</output></label>
					<input type="range" id={`${pre}-pue`} name="pue" min="1" max="2" step="0.01" value={pueSetor} />
					<span class="dica"
						><span class="selo publicado">Publicado</span> {virgula(pueSetor)} é a média do setor em 2026 (Uptime Institute); o fornecedor
						pode indicar o do centro que usas</span
					>
				</div>
			</form>

			<div class="resultado" aria-live="polite">
				<div class="numeros">
					<p>
						<span class="selo calculado">Calculado</span>
						<span class="valor" data-r="kwh">0</span>
						<span class="unidade">kWh por mês</span>
					</p>
					<p>
						<span class="selo calculado">Calculado</span>
						<span class="valor" data-r="kg">0</span>
						<span class="unidade">kg CO2e por mês, location-based</span>
					</p>
				</div>
				<div class="pontos-co2" data-pontos aria-hidden="true"></div>
				<p class="escala-pontos" data-r="escala"></p>
				<details class="formula" open>
					<summary>Ver o cálculo</summary>
					<p data-r="formula"></p>
				</details>
			</div>
		</div>

		<div class="regioes">
			<p class="regioes-tit">A mesma carga em cada país <span class="selo calculado">Calculado</span></p>
			<ul data-regioes></ul>
		</div>
	</section>

	<section class="largura bloco-eco metodo" id={`${pre}-metodo`}>
		<div class="cab-bloco">
			<div>
				<p class="etiqueta">2 · Como se calcula</p>
				<h2>Um só método, explicado.</h2>
			</div>
		</div>
		<div class="cartoes-metodo">
			<div>
				<strong>Location-based</strong>
				<p>
					Usa a média anual da eletricidade produzida no país. Não conta contratos de energia renovável: isso seria o
					método market-based, que aqui não aparece porque precisa de dados contratuais que não temos.
				</p>
			</div>
			<div>
				<strong>Ciclo de vida</strong>
				<p>
					A intensidade da Ember inclui as emissões a montante (construção das centrais, extração e transporte do
					combustível). Por isso é mais alta do que contar só as emissões diretas da queima. Os dois tipos nunca se
					misturam nesta página.
				</p>
			</div>
			<div>
				<strong>Só os processadores</strong>
				<p>
					O estimador conta a energia dos vCPU e a eficiência do centro de dados. Memória, armazenamento, rede e
					fabrico dos servidores ficam de fora, por isso o valor real é maior.
				</p>
			</div>
		</div>
	</section>

	<section class="largura bloco-eco alavancas">
		<div class="cab-bloco">
			<div>
				<p class="etiqueta">3 · O que a infraestrutura pode mudar</p>
				<h2>Mais eficiência, mais visibilidade.</h2>
			</div>
		</div>
		<ul class="cartoes-alav">
			<li>
				<strong>Ajustar os recursos à carga</strong>
				<span>Com a infraestrutura escalável (bloco 3), os recursos acompanham a carga da aplicação.</span>
			</li>
			<li>
				<strong>Ver o que se consome</strong>
				<span>A observabilidade (bloco 4) dá visibilidade sobre a utilização dos recursos e os custos.</span>
			</li>
			<li>
				<strong>Escolher com informação</strong>
				<span>A intensidade carbónica da eletricidade muda de país para país, e o estimador mostra quanto.</span>
			</li>
			<li>
				<strong>Alojamento com menor impacto ambiental</strong>
				<span>Quando as necessidades e o orçamento o permitem, é uma das opções que proponho.</span>
			</li>
		</ul>
	</section>

	<section class="largura bloco-eco fontes" id={`${pre}-fontes`}>
		<h2 class="h-pequeno">Fontes e limites</h2>
		<ol class="lista-fontes">
			{
				fontesEco.map((f) => (
					<li>
						<span class="n">[{f.n}]</span> <a href={f.url}>{f.titulo}</a>
					</li>
				))
			}
		</ol>
		<ul class="limites">
			<li>Estimativa ilustrativa, não uma medição da tua infraestrutura.</li>
			<li>
				Os watts por vCPU são os do Cloud Carbon Footprint para um processador desconhecido; o servidor real pode
				consumir mais ou menos.
			</li>
			<li>A intensidade é uma média anual do país; a hora do dia muda o valor real.</li>
			<li>
				O PUE de {virgula(pueSetor)} é a média por centro de dados; ponderada pela capacidade, é 1,36. Os centros grandes,
				como os da cloud, costumam ter valores mais baixos.
			</li>
		</ul>
		<div class="volta">
			<a class="ligacao-seta" href={ligacao(modo, p, 'inicio')}>Voltar à página principal</a>
			<a class="botao" href={calendly}>{textos.cta}</a>
		</div>
	</section>

	<script type="application/json" data-dados-eco set:html={JSON.stringify(dados)} />
</div>

<script>
	type Regiao = { id: string; nome: string; g: number; estado: string; ano?: string; fonte?: string };
	type Dados = { regioes: Regiao[]; coeficientes: { wMin: number; wMax: number; nota: string }; pue: number };
	const nomeEstado: Record<string, string> = { publicado: 'Publicado', calculado: 'Calculado', hipotese: 'Hipótese' };
	const num = (n: number, casas = 1) => n.toLocaleString('pt-PT', { maximumFractionDigits: casas });
	const selo = (estado: string) => `<span class="selo ${estado}">${nomeEstado[estado] ?? estado}</span>`;

	for (const raiz of document.querySelectorAll<HTMLElement>('[data-eco]')) {
		const d: Dados = JSON.parse(raiz.querySelector('[data-dados-eco]')!.textContent!);
		const form = raiz.querySelector<HTMLFormElement>('[data-controlos]')!;
		const r = (k: string) => raiz.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
		const o = (k: string) => raiz.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
		const pontos = raiz.querySelector<HTMLElement>('[data-pontos]')!;
		const lista = raiz.querySelector<HTMLElement>('[data-regioes]')!;
		const c = d.coeficientes;

		function calcula() {
			const f = new FormData(form);
			const vcpu = Number(f.get('vcpu'));
			const uso = Number(f.get('uso'));
			const horas = Number(f.get('horas'));
			const pue = Number(f.get('pue'));
			const reg = d.regioes.find((x) => x.id === f.get('regiao'))!;
			o('vcpu').textContent = String(vcpu);
			o('uso').textContent = `${uso} %`;
			o('horas').textContent = `${horas} h`;
			o('pue').textContent = num(pue, 2);
			const w = c.wMin + (uso / 100) * (c.wMax - c.wMin);
			const kwh = (vcpu * w * horas * 30.4375 * pue) / 1000;
			const kg = (kwh * reg.g) / 1000;
			r('kwh').textContent = num(kwh, kwh < 10 ? 1 : 0);
			r('kg').textContent = num(kg, kg < 10 ? 1 : 0);
			// Pontos: cada ponto vale uma unidade escolhida para nunca passar de 200 pontos.
			const u = [0.1, 1, 10, 100, 1000].find((x) => kg / x <= 200) ?? 1000;
			const n = Math.max(1, Math.round(kg / u));
			pontos.innerHTML = '<i></i>'.repeat(n);
			r('escala').textContent = `Cada ponto vale cerca de ${num(u, 1)} kg CO2e (${n} pontos)`;
			r('formula').innerHTML =
				`${vcpu} vCPU × (${num(c.wMin, 2)} W + ${uso} % × (${num(c.wMax, 2)} − ${num(c.wMin, 2)}) W) ` +
				`${selo('hipotese')} <small>${c.nota}</small> × ${horas} h × 30,4 dias × PUE ${num(pue, 2)} ${selo(pue === d.pue ? 'publicado' : 'hipotese')} ` +
				`= ${num(kwh, 1)} kWh.<br>${num(kwh, 1)} kWh × ${num(reg.g, 1)} g/kWh (${reg.nome}, Ember ${reg.ano}, ciclo de vida) ` +
				`${selo(reg.estado)} = ${num(kg, 1)} kg CO2e ${selo('calculado')}`;
			const max = Math.max(...d.regioes.map((x) => x.g));
			lista.innerHTML = d.regioes
				.map((x) => {
					const v = (kwh * x.g) / 1000;
					return `<li class="${x.id === reg.id ? 'atual' : ''}"><span class="rg-nome">${x.nome} <small>${num(x.g, 0)} g/kWh</small></span>
					<span class="rg-pista"><span class="rg-barra" style="width:${Math.max(1, (x.g / max) * 100)}%"></span></span>
					<span class="rg-valor">${num(v, v < 10 ? 1 : 0)} kg</span></li>`;
				})
				.join('');
		}
		form.addEventListener('input', calcula);
		form.addEventListener('submit', (e) => e.preventDefault());
		calcula();
	}
</script>

<style>
	.eco > section {
		padding-block: 4rem 0;
	}
	h1 {
		font-size: clamp(2.4rem, 5vw, 4.2rem);
		line-height: 1.05;
		max-width: 20ch;
	}
	h2 {
		font-size: clamp(1.9rem, 3.6vw, 2.6rem);
		line-height: 1.1;
	}
	.h-pequeno {
		font-size: clamp(1.5rem, 3vw, 2rem);
	}
	.lead,
	.intro {
		color: var(--muted);
		max-width: 40rem;
	}
	.lead {
		font-size: 1.125rem;
	}
	.etiqueta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.eco-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		gap: 2rem 4rem;
		align-items: end;
		padding-top: 4.5rem !important;
	}
	.eco-hero-texto {
		display: grid;
		gap: 1.25rem;
	}
	.legenda-estados {
		list-style: none;
		margin: 0;
		padding: 0 0 0 1.5rem;
		display: grid;
		gap: 0.75rem;
		border-left: 2px solid var(--verde);
		font-size: 0.875rem;
		color: var(--muted);
	}
	.legenda-estados li {
		display: grid;
		grid-template-columns: 7.5rem 1fr;
		gap: 0.75rem;
		align-items: center;
	}
	.bloco-eco {
		display: grid;
		gap: 1.5rem;
	}
	.cab-bloco {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: end;
		gap: 1rem 3rem;
	}
	.cab-bloco > div {
		display: grid;
		gap: 0.5rem;
	}
	.estimador {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
		gap: 1.5rem;
	}
	.controlos {
		display: grid;
		gap: 1.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line-forte);
	}
	.campo {
		display: grid;
		gap: 0.4rem;
	}
	.campo label {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.9375rem;
	}
	.campo output {
		font-variant-numeric: tabular-nums;
		color: var(--verde);
		font-weight: 600;
	}
	.dica {
		font-size: 0.8125rem;
		color: var(--muted);
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
	}
	input[type='range'] {
		width: 100%;
		accent-color: var(--verde);
		min-height: 24px;
	}
	select {
		font: inherit;
		font-size: 0.9375rem;
		min-height: 44px;
		padding: 0 0.75rem;
		border-radius: 10px;
		border: 1px solid var(--line-forte);
		background: var(--bg);
		color: var(--text);
	}
	.resultado {
		display: grid;
		gap: 1rem;
		align-content: start;
		padding: 1.5rem 0 0 2rem;
		border-left: 2px solid var(--verde);
	}
	.numeros {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}
	.numeros p {
		display: grid;
		gap: 0.2rem;
		justify-items: start;
	}
	.valor {
		font: 400 clamp(2.2rem, 5vw, 3.2rem) / 1 var(--serif);
		color: var(--verde);
		font-variant-numeric: tabular-nums;
	}
	.unidade {
		font-size: 0.875rem;
		color: var(--muted);
	}
	.pontos-co2 {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		min-height: 24px;
	}
	.pontos-co2 :global(i) {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--verde);
		animation: surge 0.35s ease both;
	}
	@keyframes surge {
		from {
			transform: scale(0);
		}
	}
	.escala-pontos {
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.formula summary {
		cursor: pointer;
		color: var(--verde);
		font-weight: 600;
		min-height: 36px;
		display: inline-flex;
		align-items: center;
	}
	.formula p {
		font-size: 0.875rem;
		line-height: 1.9;
		color: var(--text);
	}
	.regioes {
		display: grid;
		gap: 0.75rem;
		padding-top: 2rem;
		border-top: 1px solid var(--line-forte);
	}
	.regioes-tit {
		display: flex;
		gap: 0.75rem;
		align-items: center;
		font-weight: 600;
	}
	.regioes ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.35rem;
	}
	.regioes :global(li) {
		display: grid;
		grid-template-columns: 11rem minmax(0, 1fr) 4.5rem;
		gap: 0.75rem;
		align-items: center;
		font-size: 0.875rem;
		padding: 0.15rem 0.35rem;
		border-radius: 6px;
	}
	.regioes :global(li.atual) {
		background: color-mix(in srgb, var(--verde) 14%, transparent);
		font-weight: 600;
	}
	.regioes :global(.rg-nome small) {
		color: var(--muted);
		font-size: 0.75rem;
	}
	.regioes :global(.rg-pista) {
		height: 10px;
		border-radius: 999px;
		background: var(--surface-2);
	}
	.regioes :global(.rg-barra) {
		display: block;
		height: 100%;
		border-radius: 999px;
		background: var(--verde);
		transition: width 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.regioes :global(.rg-valor) {
		text-align: right;
		font-variant-numeric: tabular-nums;
	}
	.cartoes-metodo {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	.cartoes-metodo > div {
		display: grid;
		gap: 0.5rem;
		align-content: start;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line-forte);
	}
	.cartoes-metodo strong {
		font: 400 1.25rem/1.2 var(--serif);
	}
	.cartoes-metodo p {
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.cartoes-alav {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
	}
	.cartoes-alav li {
		display: grid;
		gap: 0.5rem;
		align-content: start;
		padding-top: 1.25rem;
		border-top: 2px solid var(--verde);
	}
	.cartoes-alav strong {
		font: 400 1.25rem/1.2 var(--serif);
	}
	.cartoes-alav span {
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.lista-fontes {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.35rem;
		font-size: 0.875rem;
		color: var(--muted);
	}
	.lista-fontes a {
		color: var(--verde);
	}
	.limites {
		margin: 0;
		padding-left: 1.25rem;
		display: grid;
		gap: 0.35rem;
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.volta {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		align-items: center;
		margin-top: 1rem;
	}
	@media (max-width: 960px) {
		.eco-hero,
		.estimador,
		.cartoes-metodo {
			grid-template-columns: 1fr;
		}
		.cartoes-alav {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.legenda-estados li {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
		.cartoes-alav,
		.numeros {
			grid-template-columns: 1fr;
		}
		.regioes :global(li) {
			grid-template-columns: 7.5rem minmax(0, 1fr) 3.75rem;
		}
	}
</style>
