---
// PROTÓTIPO v3 · Página principal, só com o fundo escuro (decisão do Julien a 20/10/2026).
// Estrutura do protótipo 3, mais aberta: uma ideia por secção, sem cartões, mais espaço.
// O Hero tem o texto e o ∞ do qual sai o ramo que desce pela página («Que elemento gráfico
// 3D tem o Hero?», #53). Serviços: os 4 blocos abertos em cartões que passam na horizontal
// com o scroll, como na Expertise By Me.
import { Image } from 'astro:assets';
import foto from '../../../data/IMG_2030.png';
import Folha from './Folha.astro';
import HeroElemento from './HeroElemento.astro';
import FolhaFluxo from './FolhaFluxo.astro';
import GraficoCloud from './GraficoCloud.astro';
import Garantia from './Garantia.astro';
import DiagramaBloco from './DiagramaBloco.astro';
import FaqResumo from './FaqResumo.astro';
import Testemunhos from './Testemunhos.astro';
import { calendly, textos, problemas, depois, paraQuem, blocos, notaBlocos, etapas, type P, type Modo } from './dados';
import { ligacao } from './temas';

interface Props {
	p: P;
	modo: Modo;
}
const { p, modo } = Astro.props;
const id = (s: string) => `p${p}-${s}`;
const promessaH1 = textos.promessa.replace('entrego-te', '<span style="white-space:nowrap">entrego-te</span>');
const resumos = [
	'Os bugs ficam no pull request.',
	'A aplicação corre igual em todo o lado.',
	'A infraestrutura acompanha a carga.',
	'Vês os problemas antes dos clientes.',
];
---

<div class="inicio" data-hero-raiz>
	<HeroElemento />
	<section class="hero" id={id('topo')}>
		<div class="largura hero-dentro">
			<div class="hero-texto">
				<p class="etiqueta">{textos.designacao}</p>
				<h1 set:html={promessaH1} />
				<p class="lead">{textos.subPromessa}</p>
				<div class="acao">
					<a class="botao grande" href={calendly}>{textos.cta}</a>
					<span class="nota">{textos.notaCta}</span>
				</div>
			</div>
			<div class="palco" data-palco></div>
		</div>
	</section>

	<section class="largura seccao para-quem" id={id('para-quem')}>
		<p class="etiqueta">Para quem é</p>
		<ul>
			{paraQuem.map((x) => <li>{x}</li>)}
		</ul>
	</section>

	<section class="largura seccao caminhos" id={id('problema')}>
		<h2>Hoje, e depois.</h2>
		<div class="dois">
			<div>
				<p class="etiqueta muted">Hoje</p>
				<ul class="lista">
					{
						problemas.map((x) => (
							<li>
								<strong>{x.titulo}</strong> {x.texto}
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<p class="etiqueta">Depois</p>
				<ul class="lista depois">
					{depois.map((d) => <li>{d}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<section class="seccao servicos" id={id('servicos')} data-pista>
		<div class="pista-palco">
			<div class="largura pista-cab">
				<div class="pista-titulo">
					<p class="etiqueta">Serviços</p>
					<h2>Quatro camadas da tua infraestrutura.</h2>
				</div>
				<div class="pista-lado">
					<p class="intro">{notaBlocos}</p>
					<p class="contador" aria-hidden="true">
						<span data-pista-n>1</span> / {blocos.length}
						<span class="barra"><span data-pista-barra></span></span>
					</p>
				</div>
			</div>
			<ol class="pista" data-pista-cartoes>
				{
					blocos.map((b, i) => (
						<li class="cartao" data-cartao>
							<div class="diag-caixa">
								<DiagramaBloco n={b.n as 1 | 2 | 3 | 4} />
							</div>
							<p class="num">Bloco {b.n}</p>
							<h3>{b.nome}</h3>
							<p class="resumo">{resumos[i]}</p>
							<p class="txt">{b.texto}</p>
							<p class="ferr">
								{b.ferramentas.map((f) => (
									<span>{f}</span>
								))}
							</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="seccao etapas" id={id('etapas')} data-etapas>
		<div class="largura etapas-palco">
			<h2>Cinco etapas, sempre pela mesma ordem.</h2>
			<ol>
				{
					etapas.map((e, i) => (
						<li style={`--i:${i}`} data-etapa>
							<span class="num-etapa">{i + 1}</span>
							<strong>{e.nome}</strong>
							<span class="txt">{e.texto}</span>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="largura seccao" id={id('garantia')}>
		<Garantia formato="faixa" />
	</section>

	<section class="largura seccao">
		<GraficoCloud p={p} />
	</section>

	<section class="quem" id={id('quem')}>
		<div class="largura quem-dentro">
			<Image src={foto} alt={textos.fotoAlt} width={560} format="avif" quality={55} loading="lazy" class="foto" />
			<div class="quem-texto">
				<p class="etiqueta">Quem é o Julien</p>
				<p class="frase">{textos.quem}</p>
			</div>
		</div>
	</section>

	<section class="largura seccao testemunhos-seccao" id={id('testemunhos')}>
		<p class="etiqueta">O que dizem os clientes</p>
		<Testemunhos p={p} />
	</section>

	<section class="largura seccao eco" id={id('eco')}>
		<div class="eco-texto">
			<p class="etiqueta"><Folha tamanho={16} /> Ecologia</p>
			<h2>A infraestrutura também tem pegada.</h2>
			<p>
				Onde a aplicação corre, quanto corre e com que eficiência mudam o impacto ambiental. A página de ecologia deixa-te
				estimar uma carga conforme o país onde corre, separando dados publicados, hipóteses e cálculos.
			</p>
			<a class="ligacao-seta" href={ligacao(modo, p, 'ecologia')}><Folha tamanho={18} /> Abrir a página de ecologia</a>
		</div>
		<FolhaFluxo tamanho="20rem" />
	</section>

	<section class="largura seccao" id={id('faq')}>
		<FaqResumo p={p} modo={modo} />
	</section>

	<section class="largura seccao final">
		<h2>{textos.finalTitulo}</h2>
		<p class="intro">{textos.finalTexto}</p>
		<a class="botao grande" href={calendly}>{textos.cta}</a>
		<p class="nota">{textos.notaLingua}</p>
	</section>
</div>

<script>
	// Serviços: no computador, a secção fica presa enquanto o scroll faz passar os cartões na
	// horizontal; depois a página continua. No telemóvel e com movimento reduzido, não fica presa.
	const CABECALHO = 68;
	for (const sec of document.querySelectorAll<HTMLElement>('[data-pista]')) {
		const palco = sec.querySelector<HTMLElement>('.pista-palco')!;
		const pista = sec.querySelector<HTMLElement>('[data-pista-cartoes]')!;
		const n = sec.querySelector<HTMLElement>('[data-pista-n]')!;
		const barra = sec.querySelector<HTMLElement>('[data-pista-barra]')!;
		const total = pista.children.length;
		const largo = matchMedia('(min-width: 961px) and (prefers-reduced-motion: no-preference)');
		// O scroll vertical percorre 1,8 vezes o deslocamento horizontal: os cartões passam devagar.
		const VAGAR = 1.8;
		let desloc = 0;
		let pedido = 0;
		const mede = () => {
			sec.toggleAttribute('data-fixa', largo.matches);
			if (!largo.matches) {
				sec.style.height = '';
				pista.style.transform = '';
				delete sec.dataset.percurso;
				return;
			}
			desloc = Math.max(pista.scrollWidth - document.documentElement.clientWidth, 0);
			sec.dataset.percurso = String(desloc * VAGAR);
			sec.style.height = `${palco.offsetHeight + desloc * VAGAR}px`;
			move();
		};
		const move = () => {
			pedido = 0;
			if (!largo.matches) return;
			const r = sec.getBoundingClientRect();
			const p = Math.min(Math.max((CABECALHO - r.top) / (r.height - palco.offsetHeight || 1), 0), 1);
			pista.style.transform = `translate3d(${-p * desloc}px, 0, 0)`;
			n.textContent = String(Math.round(p * (total - 1)) + 1);
			barra.style.width = `${p * 100}%`;
		};
		addEventListener('scroll', () => pedido || (pedido = requestAnimationFrame(move)), { passive: true });
		addEventListener('resize', mede);
		largo.addEventListener('change', mede);
		new ResizeObserver(mede).observe(pista);
		mede();
	}

	// Etapas: no computador, a secção fica presa e o scroll faz o ramo passar uma etapa de cada
	// vez (pedido do Julien a 20/10/2026: antes passava pelas cinco quase de uma vez). A etapa k
	// chega a meio da sua fatia do percurso, (k + 0,5) / 5; o ramo usa a mesma conta
	// (HeroElemento). No telemóvel e com movimento reduzido, não fica presa.
	for (const sec of document.querySelectorAll<HTMLElement>('[data-etapas]')) {
		const palco = sec.querySelector<HTMLElement>('.etapas-palco')!;
		const itens = [...sec.querySelectorAll<HTMLElement>('[data-etapa]')];
		const largo = matchMedia('(min-width: 961px) and (prefers-reduced-motion: no-preference)');
		// Quanto scroll gasta cada etapa, em fração da altura do ecrã.
		const POR_ETAPA = 0.45;
		let pedido = 0;
		const mede = () => {
			sec.toggleAttribute('data-fixa', largo.matches);
			if (!largo.matches) {
				sec.style.height = '';
				delete sec.dataset.percurso;
				itens.forEach((li) => li.classList.remove('chegou', 'atual'));
				return;
			}
			const percurso = Math.round(innerHeight * POR_ETAPA * itens.length);
			sec.dataset.percurso = String(percurso);
			sec.style.height = `${palco.offsetHeight + percurso}px`;
			move();
		};
		const move = () => {
			pedido = 0;
			if (!largo.matches) return;
			const r = sec.getBoundingClientRect();
			const p = Math.min(Math.max((CABECALHO - r.top) / (r.height - palco.offsetHeight || 1), 0), 1);
			const chegaram = itens.filter((_, k) => p >= (k + 0.5) / itens.length).length;
			itens.forEach((li, k) => {
				li.classList.toggle('chegou', k < chegaram);
				li.classList.toggle('atual', k === chegaram - 1);
			});
		};
		addEventListener('scroll', () => pedido || (pedido = requestAnimationFrame(move)), { passive: true });
		addEventListener('resize', mede);
		largo.addEventListener('change', mede);
		mede();
	}
</script>

<style>
	/* O canvas do ∞ e do ramo vive dentro deste bloco. */
	.inicio {
		position: relative;
		isolation: isolate;
	}
	.seccao {
		padding-block: clamp(5rem, 11vw, 9rem);
	}
	h1 {
		font-size: clamp(2.5rem, 4.4vw, 4.1rem);
		line-height: 1.05;
		letter-spacing: -0.012em;
	}
	h2 {
		font-size: clamp(2.1rem, 4.4vw, 3.4rem);
		line-height: 1.06;
	}
	.lead,
	.intro {
		color: var(--muted);
		max-width: 38rem;
	}
	.lead {
		font-size: 1.1875rem;
	}
	.nota {
		font-size: 0.875rem;
		color: var(--muted);
	}
	.etiqueta.muted {
		color: var(--muted);
	}
	/* Hero: o texto e o palco do elemento 3D */
	.hero-dentro {
		min-height: calc(100svh - 68px);
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
		gap: 3rem 4rem;
		align-items: center;
		padding-block: 4rem;
	}
	.hero-texto {
		display: grid;
		gap: 1.5rem;
		justify-items: start;
	}
	.acao {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
	}
	.palco {
		width: min(100%, 30rem);
		aspect-ratio: 5 / 4;
		justify-self: center;
	}
	/* Para quem é: três afirmações grandes, sem caixas */
	.para-quem {
		display: grid;
		gap: 2rem;
	}
	.para-quem ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem 3rem;
	}
	.para-quem li {
		font: 400 clamp(1.5rem, 2.6vw, 2rem) / 1.25 var(--serif);
		padding-top: 1.25rem;
		border-top: 2px solid var(--verde);
	}
	/* Hoje e depois */
	.caminhos {
		display: grid;
		gap: 3rem;
	}
	.dois {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 3rem 5rem;
	}
	.dois > div {
		display: grid;
		gap: 1rem;
		align-content: start;
	}
	.lista {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
	}
	.lista li {
		padding-block: 1.1rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 1.0625rem;
	}
	.lista strong {
		color: var(--text);
		font-weight: 600;
	}
	.depois li {
		color: var(--text);
	}
	.depois li::before {
		content: '';
		display: inline-block;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--verde);
		margin-right: 0.7rem;
		vertical-align: 0.12em;
	}
	/* Serviços: os 4 blocos abertos, em cartões. Por omissão em grelha (telemóvel e movimento
	   reduzido); com data-fixa (computador), a secção fica presa e os cartões passam na
	   horizontal com o scroll. */
	.pista-palco {
		display: grid;
		gap: 3rem;
	}
	.pista-cab {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		gap: 1.5rem 4rem;
		align-items: end;
	}
	.pista-titulo,
	.pista-lado {
		display: grid;
		gap: 1.25rem;
	}
	.contador {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font: 500 0.8125rem/1 var(--sans);
		letter-spacing: 0.08em;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	.barra {
		position: relative;
		width: 8rem;
		height: 1px;
		background: var(--line-forte);
	}
	.barra span {
		position: absolute;
		left: 0;
		top: -0.5px;
		height: 2px;
		width: 0;
		background: var(--verde);
	}
	.pista {
		list-style: none;
		margin: 0 auto;
		max-width: 76rem;
		padding-inline: max(20px, env(safe-area-inset-left, 0px)) max(20px, env(safe-area-inset-right, 0px));
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 3.5rem 2.5rem;
	}
	.cartao {
		display: grid;
		gap: 0.7rem;
		align-content: start;
	}
	.diag-caixa {
		padding: 1rem 1.25rem;
		margin-bottom: 0.6rem;
		border-radius: var(--raio);
		background: var(--surface);
		border: 1px solid var(--line);
	}
	.cartao .num {
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--acento);
	}
	.cartao h3 {
		font-size: 1.65rem;
		line-height: 1.15;
	}
	.resumo {
		color: var(--verde);
		font-size: 0.9375rem;
	}
	.cartao .txt {
		color: var(--muted);
	}
	.servicos[data-fixa] {
		padding-block: 0;
	}
	[data-fixa] .pista-palco {
		position: sticky;
		top: 68px;
		height: calc(100vh - 68px);
		grid-template-columns: minmax(0, 1fr);
		align-content: center;
		gap: clamp(1.75rem, 5vh, 3.5rem);
		overflow: hidden;
	}
	[data-fixa] .pista {
		display: flex;
		width: max-content;
		max-width: none;
		margin: 0;
		gap: 2.5rem;
		padding-inline: max(20px, calc((100vw - 76rem) / 2 + 20px));
		justify-self: start;
		will-change: transform;
	}
	[data-fixa] .cartao {
		width: clamp(21rem, 31vw, 27rem);
	}
	/* Ecrãs baixos: diagramas e títulos mais pequenos, para tudo caber com a secção presa. */
	[data-fixa] .diag-caixa :global(svg) {
		display: block;
		width: 100%;
		max-height: min(11rem, 19vh);
	}
	@media (max-height: 820px) {
		[data-fixa] .pista-palco {
			gap: 1.25rem;
		}
		[data-fixa] .pista-cab h2 {
			font-size: clamp(1.9rem, 3.4vw, 2.6rem);
		}
		[data-fixa] .cartao {
			gap: 0.45rem;
		}
		[data-fixa] .cartao h3 {
			font-size: 1.4rem;
		}
	}
	.ferr {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.ferr span {
		font-size: 0.8125rem;
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		border: 1px solid var(--verde-forte);
		color: var(--verde);
	}
	/* Etapas: cinco colunas abertas. Com data-fixa (computador), a secção fica presa e as etapas
	   acendem uma a uma, à medida que o ramo chega. */
	.etapas-palco {
		display: grid;
		gap: 3rem;
	}
	.etapas[data-fixa] {
		padding-block: 0;
	}
	[data-fixa] .etapas-palco {
		position: sticky;
		top: 68px;
		height: calc(100vh - 68px);
		align-content: center;
	}
	[data-fixa] .num-etapa {
		color: var(--line-forte);
		transition: color 0.35s ease;
	}
	[data-fixa] li.chegou .num-etapa {
		color: var(--verde);
	}
	[data-fixa] li strong {
		transition: border-color 0.35s ease;
	}
	[data-fixa] li.atual strong {
		border-top-color: var(--verde);
	}
	.etapas ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 2rem;
	}
	.etapas li {
		display: grid;
		gap: 0.5rem;
		align-content: start;
		padding-top: calc(var(--i) * 1.25rem);
	}
	.num-etapa {
		font: 400 2.6rem/1 var(--serif);
		color: var(--verde);
	}
	.etapas strong {
		font-weight: 600;
		padding-top: 0.75rem;
		border-top: 1px solid var(--line-forte);
	}
	.etapas .txt {
		color: var(--muted);
		font-size: 0.9375rem;
	}
	/* Quem é o Julien: faixa de cor */
	/* Sem faixa de cor desde 20/10/2026: o ramo dá meia volta à fotografia. */
	.quem {
		padding-block: clamp(5rem, 10vw, 8rem);
	}
	.quem-dentro {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
		gap: 3rem 5rem;
		align-items: center;
	}
	.foto {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 999px 999px 14px 14px;
	}
	.quem-texto {
		display: grid;
		gap: 1.5rem;
	}
	.frase {
		font: 400 clamp(1.6rem, 3vw, 2.3rem) / 1.3 var(--serif);
	}
	.testemunhos-seccao {
		display: grid;
		gap: 2rem;
	}
	/* Ecologia: o texto e a folha de pontos em fluxo */
	.eco {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
		gap: 2rem 4rem;
		align-items: center;
	}
	.eco :global(.folha-fluxo) {
		justify-self: center;
	}
	.eco-texto {
		display: grid;
		gap: 1.25rem;
		justify-items: start;
		max-width: 46rem;
	}
	.eco-texto .etiqueta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.eco-texto > p:not(.etiqueta) {
		color: var(--muted);
		font-size: 1.0625rem;
	}
	.final {
		display: grid;
		gap: 1.5rem;
		justify-items: start;
		min-height: 70svh;
		align-content: center;
	}
	.final h2 {
		font-size: clamp(2.6rem, 6.5vw, 5rem);
	}
	.final .intro {
		max-width: 42rem;
	}
	@media (max-width: 960px) {
		.hero-dentro,
		.eco,
