---
// PROTÓTIPO v3 · Os 3 testemunhos num carrossel, um de cada vez (a decisão de #51 era os 3
// visíveis ao mesmo tempo). Desde 20/10/2026 passa sozinho, a pedido do Julien: cada testemunho
// fica o tempo de o ler e depois passa ao seguinte. Sem JavaScript, a faixa desliza; o script
// acrescenta as setas, o indicador «1 de 3», a barra do tempo e a passagem automática.
import { testemunhos, type P } from './dados';

interface Props {
	p: P;
	class?: string;
}
// O resto leva o atributo data-astro-cid-* de quem chama, para os estilos dele (p. ex. .cartao) se aplicarem.
const { p, class: classe, ...resto } = Astro.props;
const total = testemunhos.length;
---

<div class:list={['testemunhos', `t${p}`, classe]} {...resto}>
	<p class="nota-proto">
		Passa sozinho: cada testemunho fica o tempo de o ler (cerca de 200 palavras por minuto, pelo menos 8 s). Para com
		o rato ou o foco em cima e com o botão de pausa. Testemunhos reais do Malt, já autorizados; a tradução é a rever
		pela estagiária e a aprovar por cada autor.
	</p>
	<section class="carrossel" aria-roledescription="carrossel" aria-label="Testemunhos" data-carrossel>
		<div class="controlos" hidden data-controlos>
			<button type="button" class="seta" aria-label="Testemunho anterior" data-anterior>←</button>
			<span class="indicador" aria-live="polite" data-indicador>1 de {total}</span>
			<button type="button" class="seta" aria-label="Testemunho seguinte" data-seguinte>→</button>
			<span class="tempo" aria-hidden="true"><span data-tempo></span></span>
		</div>
		<div class="faixa" tabindex="0" role="group" aria-label="Faixa de testemunhos: desliza para ver os outros">
			{
				testemunhos.map((t, i) => (
					<figure class="testemunho" aria-roledescription="testemunho" aria-label={`${i + 1} de ${total}`}>
						<blockquote>
							{t.traducao.map((par) => (
								<p>{par}</p>
							))}
						</blockquote>
						<figcaption>
							<strong>{t.nome}</strong> · {t.cargo} · {t.empresa}
						</figcaption>
						<p class="traduzido">Traduzido do francês</p>
					</figure>
				))
			}
		</div>
	</section>
</div>

<script>
	// Setas, indicador e passagem automática. As setas dão a volta (do 3.º para o 1.º) para o foco
	// nunca ficar num botão desativado. Cada testemunho fica o tempo de o ler (cerca de 200 palavras
	// por minuto, pelo menos 8 s): a barra do tempo é uma animação CSS e, quando acaba, passa ao
	// seguinte. A barra para com o rato ou o foco no carrossel, fora do ecrã e com o botão de pausa
	// da página (WCAG 2.2.2); com prefers-reduced-motion não anima, por isso só há as setas.
	for (const raiz of document.querySelectorAll<HTMLElement>('[data-carrossel]')) {
		const faixa = raiz.querySelector<HTMLElement>('.faixa')!;
		const slides = [...faixa.children] as HTMLElement[];
		const indicador = raiz.querySelector<HTMLElement>('[data-indicador]')!;
		const barra = raiz.querySelector<HTMLElement>('[data-tempo]')!;
		const tempos = slides.map((s) => Math.max(8, (s.textContent!.trim().split(/\s+/).length / 200) * 60 + 2));
		const posicao = (el: HTMLElement) => el.offsetLeft - slides[0].offsetLeft;
		const atual = () => {
			let melhor = 0;
			slides.forEach((s, i) => {
				if (Math.abs(posicao(s) - faixa.scrollLeft) < Math.abs(posicao(slides[melhor]) - faixa.scrollLeft)) melhor = i;
			});
			return melhor;
		};
		let mostrado = 0;
		let visivel = false;
		let dentro = false;
		const ir = (i: number) => {
			const alvo = (i + slides.length) % slides.length;
			faixa.scrollTo({ left: posicao(slides[alvo]), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
		};
		// Recomeça a barra do testemunho i.
		const recomeca = (i: number) => {
			barra.classList.remove('a-contar');
			barra.style.animationDuration = `${tempos[i]}s`;
			void barra.offsetWidth;
			barra.classList.add('a-contar');
		};
		const estado = () => {
			const parado = document.documentElement.dataset.animacao === 'pausada' || !visivel || dentro || document.hidden;
			barra.style.animationPlayState = parado ? 'paused' : 'running';
			// Enquanto passa sozinho, o indicador não é anunciado a cada troca.
			indicador.setAttribute('aria-live', parado ? 'polite' : 'off');
		};
		barra.addEventListener('animationend', () => ir(atual() + 1));
		raiz.querySelector('[data-anterior]')!.addEventListener('click', () => ir(atual() - 1));
		raiz.querySelector('[data-seguinte]')!.addEventListener('click', () => ir(atual() + 1));
		let espera = 0;
		faixa.addEventListener('scroll', () => {
			clearTimeout(espera);
			espera = window.setTimeout(() => {
				const i = atual();
				if (i !== mostrado) {
					mostrado = i;
					recomeca(i);
				}
				indicador.textContent = `${i + 1} de ${slides.length}`;
			}, 80);
		});
		raiz.addEventListener('pointerenter', () => {
			dentro = true;
			estado();
		});
		raiz.addEventListener('pointerleave', () => {
			dentro = raiz.contains(document.activeElement);
			estado();
		});
		raiz.addEventListener('focusin', () => {
			dentro = true;
			estado();
		});
		raiz.addEventListener('focusout', (e) => {
			dentro = raiz.contains(e.relatedTarget as Node) || raiz.matches(':hover');
			estado();
		});
		new IntersectionObserver(
			([e]) => {
				visivel = e.isIntersecting;
				estado();
			},
			{ threshold: 0.5 },
		).observe(raiz);
		document.addEventListener('animacao', estado);
		document.addEventListener('visibilitychange', estado);
		recomeca(0);
		estado();
		raiz.querySelector<HTMLElement>('[data-controlos]')!.hidden = false;
		raiz.classList.add('com-js');
	}
</script>

<style>
	.testemunhos {
		display: grid;
		gap: 1rem;
		min-width: 0;
		align-content: start;
	}
	.carrossel {
		display: grid;
		gap: 0.75rem;
		min-width: 0;
	}
	/* Um testemunho de cada vez; a faixa tem a altura do mais longo, para a página não saltar.
	   Cada cartão ajusta-se ao seu texto, e as setas ficam por cima, longe do espaço que sobra. */
	.faixa {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 100%;
		align-items: start;
		gap: 1rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		overscroll-behavior-x: contain;
	}
	.com-js .faixa {
		scrollbar-width: none;
	}
	.com-js .faixa::-webkit-scrollbar {
		display: none;
	}
	.faixa:focus-visible,
	.seta:focus-visible {
		outline: 2px solid var(--acento);
		outline-offset: 3px;
	}
	.testemunho {
		margin: 0;
		scroll-snap-align: start;
		display: grid;
		gap: 0.75rem;
		align-content: start;
	}
	blockquote {
		margin: 0;
		display: grid;
		gap: 0.6rem;
	}
	blockquote p {
		margin: 0;
	}
	figcaption {
		font-size: 0.875rem;
		color: var(--muted);
	}
	figcaption strong {
		color: var(--text);
	}
	.traduzido {
		margin: 0;
		font-size: 0.75rem;
		color: var(--muted);
	}
	.controlos {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.controlos[hidden] {
		display: none;
	}
	.seta {
		width: 44px;
		height: 44px;
		display: grid;
		place-items: center;
		border-radius: 999px;
		border: 1px solid var(--line-forte);
		background: transparent;
		color: var(--text);
		font: 500 1.1rem/1 var(--sans);
		cursor: pointer;
	}
	.seta:hover {
		border-color: var(--acento);
	}
	/* Barra do tempo de leitura do testemunho atual. */
	.tempo {
		position: relative;
		width: 6rem;
		height: 2px;
		background: var(--line-forte);
	}
	.tempo span {
		position: absolute;
		inset: 0;
		background: var(--verde);
		transform: scaleX(0);
		transform-origin: left;
	}
	.tempo .a-contar {
		animation: enche linear forwards paused;
	}
	@keyframes enche {
		to {
			transform: scaleX(1);
		}
	}
	.indicador {
		min-width: 4.5ch;
		text-align: center;
		font-size: 0.875rem;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	/* v3: aberto, sem cartão: a citação em serifa grande e um filete da cor de destaque por cima. */
	.testemunho {
		padding-top: 1.5rem;
		border-top: 2px solid var(--verde);
		max-width: 56rem;
	}
	blockquote {
		font: 400 clamp(1.25rem, 2.2vw, 1.6rem) / 1.45 var(--serif);
	}
</style>
