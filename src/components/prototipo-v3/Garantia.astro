---
// PROTÓTIPO v3 · A Garantia como foi validada: pelo menos 99 % em cada mês, nos 3 meses
// seguintes à entrega, sem equivalência anual nem horas por mês (validado a 19/10/2026).
// A 20/10/2026 o Julien escolheu, entre três propostas, o número grande e uma barra da largura
// da página em que só a ponta (1 %) muda de cor. Só aparecem números validados: 99 % e 3 meses.
import { textos } from './dados';

interface Props {
	formato?: string;
}
---

<div class="ga" data-garantia>
	<div class="ga-texto">
		<div class="ga-titulo">
			<p class="etiqueta">A garantia</p>
			<h2>Disponível pelo menos 99&nbsp;% do tempo, em cada mês.</h2>
		</div>
		<div class="ga-lado">
			<p class="ga-compromisso">{textos.garantia}</p>
			<p class="ga-condicao">{textos.garantiaCondicao}</p>
		</div>
	</div>


	<figure class="ga-vis numero">
		<p class="grande">99&nbsp;%</p>
		<p class="sub">do tempo, em cada mês</p>
		<div class="barra-1" aria-hidden="true"><span class="com"></span><span class="sem"></span></div>
		<div class="barra-legenda">
			<span>com serviço</span>
			<span>no máximo 1&nbsp;% sem serviço</span>
		</div>
		<figcaption>Nos 3 meses seguintes à entrega.</figcaption>
	</figure>
</div>

<script>
	// Em repouso a barra está cheia; com movimento, enche quando a Garantia chega ao ecrã.
	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		for (const raiz of document.querySelectorAll<HTMLElement>('[data-garantia]')) {
			raiz.classList.add('anima');
			new IntersectionObserver(
				(es) => {
					for (const e of es) if (e.isIntersecting) (e.target as HTMLElement).classList.add('em-vista');
				},
				{ threshold: 0.4 },
			).observe(raiz);
		}
	}
</script>

<style>
	.ga {
		display: grid;
		gap: 3rem;
	}
	.ga-texto {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: 2rem 4rem;
		align-items: end;
	}
	.ga-titulo,
	.ga-lado {
		display: grid;
		gap: 1rem;
	}
	.ga h2 {
		font-size: clamp(2.1rem, 4.4vw, 3.4rem);
		line-height: 1.06;
	}
	.ga-compromisso {
		color: var(--muted);
		max-width: 34rem;
	}
	.ga-condicao {
		font-size: 0.9375rem;
		color: var(--acento);
	}
	.ga-vis {
		margin: 0;
		display: grid;
		gap: 1.5rem;
	}
	.ga-vis figcaption {
		color: var(--muted);
		font-size: 0.9375rem;
		max-width: 44rem;
	}
	/* Número grande e barra de 1 % */
	.numero {
		gap: 1rem;
	}
	.grande {
		font: 400 clamp(5rem, 16vw, 11rem) / 0.9 var(--serif);
		background: linear-gradient(90deg, var(--elemento-roxo, #c3a6ff), var(--elemento-verde, #86d9a8));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.sub {
		font-size: 1.125rem;
		margin-bottom: 1.5rem !important;
	}
	.barra-1 {
		display: flex;
		height: 14px;
		gap: 3px;
	}
	.barra-1 .com {
		flex: 0 0 calc(99% - 3px);
		border-radius: 999px 0 0 999px;
		background: linear-gradient(90deg, var(--elemento-roxo, #c3a6ff), var(--elemento-verde, #86d9a8));
		transform-origin: left;
	}
	.barra-1 .sem {
		flex: 1;
		min-width: 6px;
		border-radius: 0 999px 999px 0;
		background: var(--s3);
	}
	.barra-legenda {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.875rem;
		color: var(--muted);
	}
	.barra-legenda span:last-child {
		color: var(--s3);
		text-align: right;
	}
	/* Com movimento: a barra enche quando a Garantia chega ao ecrã. */
	.anima .com {
		transform: scaleX(0);
		transition: transform 1.4s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.anima.em-vista .com {
		transform: none;
	}
	@media (max-width: 960px) {
		.ga-texto {
			grid-template-columns: 1fr;
		}
	}
</style>
