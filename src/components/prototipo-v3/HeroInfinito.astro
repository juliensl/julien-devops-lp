---
// PROTÓTIPO v3 · Ideia 1 do Julien para o Hero («Que elemento gráfico 3D tem o Hero?»,
// #53): um ∞ em 3D feito de pontos que correm ao longo do laço, metade roxo e metade
// verde (dev ↔ ops); cada ponto muda de cor no cruzamento. O scroll roda o ∞ e encolhe-o
// à saída do Hero. Dois modos para comparar: «contínuo» (fluxo lento sempre, acelerado
// pelo scroll, com botão de pausa por causa da WCAG 2.2.2) e «só scroll» (o fluxo segue o
// scroll, também para trás). Canvas 2D feito à mão, sem biblioteca; só desenha quando o
// Hero está à vista. Com prefers-reduced-motion fica uma imagem parada.
---

<div class="palco-inf" data-palco>
	<canvas data-infinito aria-hidden="true"></canvas>
</div>
<button type="button" class="pausa" data-infinito-pausa>Pausar a animação</button>

<script>
	type Ponto = { t: number; r: number; a: number; v: number; s: number };

	for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-infinito]')) inicia(canvas);

	function inicia(canvas: HTMLCanvasElement) {
		const raiz = canvas.closest<HTMLElement>('[data-hero-raiz]')!;
		const pausa = raiz.querySelector<HTMLButtonElement>('[data-infinito-pausa]')!;
		const ctx = canvas.getContext('2d')!;
		const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const tokens = getComputedStyle(raiz);
		const roxo = tokens.getPropertyValue('--acento').trim() || '#c3a6ff';
		const verde = tokens.getPropertyValue('--verde').trim() || '#86d9a8';
		const sprites = [brilho(roxo), brilho(verde)];
		const pontos: Ponto[] = Array.from({ length: 340 }, (_, i) => ({
			t: (i / 340) * Math.PI * 2,
			r: Math.sqrt(Math.random()) * 0.08,
			a: Math.random() * Math.PI * 2,
			v: 0.75 + Math.random() * 0.5,
			s: 0.55 + Math.random() * 0.95,
		}));

		let modo = raiz.dataset.hero ?? 'inf-cont';
		let pausado = false;
		let visivel = false;
		let pedido = 0;
		let fase = 0;
		let impulso = 0;
		let tempo = 0;
		let antes = 0;
		let ultimoScroll = scrollY;
		let w = 0;
		let h = 0;
		let pequeno = false;

		const ativo = () => modo.startsWith('inf');
		const corre = () => modo === 'inf-cont' && !pausado && !reduz;

		function pedir() {
			if (!pedido) pedido = requestAnimationFrame(quadro);
		}

		function quadro(agora: number) {
			pedido = 0;
			if (!visivel || !ativo()) return;
			const dt = antes ? Math.min((agora - antes) / 1000, 0.05) : 0;
			antes = agora;
			const delta = reduz ? 0 : scrollY - ultimoScroll;
			ultimoScroll = scrollY;
			if (corre()) {
				tempo += dt;
				impulso += Math.abs(delta) * 0.003;
				fase += (0.22 + impulso) * dt;
			} else {
				fase += delta * 0.004;
			}
			impulso *= Math.pow(0.04, dt);
			desenha();
			if (corre() || impulso > 0.002 || delta !== 0) pedir();
			else antes = 0;
		}

		function desenha() {
			// Progresso do scroll: 0 enquanto o ∞ está no meio do ecrã ou abaixo, 1 quando sobe 60 % do ecrã.
			const r = canvas.getBoundingClientRect();
			const p = reduz ? 0 : Math.min(Math.max((innerHeight / 2 - r.top - r.height / 2) / (innerHeight * 0.6), 0), 1);
			const ay = -0.4 + p * 1.9 + (corre() ? 0.12 * Math.sin(tempo * 0.35) : 0);
			const ax = 0.5 + p * 0.65;
			const escala = w * 0.42 * (1 - 0.3 * p);
			const cx = Math.cos(ax);
			const sx = Math.sin(ax);
			const cy = Math.cos(ay);
			const sy = Math.sin(ay);
			const proj = (x: number, y: number, z: number) => {
				const X = x * cy + z * sy;
				let Z = -x * sy + z * cy;
				const Y = y * cx - Z * sx;
				Z = y * sx + Z * cx;
				const k = 3 / (3 - Z);
				return [w / 2 + X * k * escala, h / 2 + Y * k * escala, Z, k];
			};

			ctx.clearRect(0, 0, w, h);
			canvas.style.opacity = String(1 - p * p * 0.85);

			// O laço, fino, para dar a forma: metade roxo, metade verde.
			ctx.globalCompositeOperation = 'source-over';
			ctx.lineWidth = Math.max(1, w / 480);
			for (const [lado, cor] of [
				[-1, roxo],
				[1, verde],
			] as const) {
				ctx.beginPath();
				for (let i = 0; i <= 90; i++) {
					const t = lado < 0 ? Math.PI / 2 + (i / 90) * Math.PI : -Math.PI / 2 + (i / 90) * Math.PI;
					const c = curva(t);
					const [x, y] = proj(c[0], c[1], c[2]);
					if (i) ctx.lineTo(x, y);
					else ctx.moveTo(x, y);
				}
				ctx.strokeStyle = cor;
				ctx.globalAlpha = 0.22;
				ctx.stroke();
			}

			// Os pontos que correm ao longo do laço, como num tubo.
			ctx.globalCompositeOperation = 'lighter';
			const base = w * 0.013;
			for (let i = 0; i < pontos.length; i++) {
				// Num ecrã pequeno desenha 2 em cada 3 pontos, para poupar o telemóvel.
				if (pequeno && i % 3 === 2) continue;
				const q = pontos[i];
				const t = q.t + fase * q.v;
				const c = curva(t);
				const d = curva(t + 0.002);
				// Tangente T e duas normais (n1 no plano, n2 = T × n1) para afastar o ponto do eixo.
				const tl = Math.hypot(d[0] - c[0], d[1] - c[1], d[2] - c[2]) || 1;
				const tx = (d[0] - c[0]) / tl;
				const ty = (d[1] - c[1]) / tl;
				const tz = (d[2] - c[2]) / tl;
				const nl = Math.hypot(tx, ty) || 1;
				const n1x = -ty / nl;
				const n1y = tx / nl;
				const ang = q.a + fase * 0.6;
				const ca = Math.cos(ang) * q.r;
				const sa = Math.sin(ang) * q.r;
				const ox = ca * n1x - sa * tz * n1y;
				const oy = ca * n1y + sa * tz * n1x;
				const oz = sa * (tx * n1y - ty * n1x);
				const [x, y, z, k] = proj(c[0] + ox, c[1] + oy, c[2] + oz);
				const prof = Math.min(Math.max(0.3 + (z + 1.2) * 0.32, 0.2), 1);
				const tam = base * q.s * k;
				const m = Math.min(Math.max((c[0] + 0.12) / 0.24, 0), 1);
				if (m < 0.98) {
					ctx.globalAlpha = prof * (1 - m);
					ctx.drawImage(sprites[0], x - tam, y - tam, tam * 2, tam * 2);
				}
				if (m > 0.02) {
					ctx.globalAlpha = prof * m;
					ctx.drawImage(sprites[1], x - tam, y - tam, tam * 2, tam * 2);
				}
			}
			ctx.globalAlpha = 1;
		}

		function muda() {
			modo = raiz.dataset.hero ?? 'inf-cont';
			canvas.hidden = !ativo();
			pausa.classList.toggle('escondida', modo !== 'inf-cont' || reduz);
			antes = 0;
			ultimoScroll = scrollY;
			pedir();
		}

		pausa.addEventListener('click', () => {
			pausado = !pausado;
			pausa.textContent = pausado ? 'Retomar a animação' : 'Pausar a animação';
			antes = 0;
			pedir();
		});
		raiz.addEventListener('hero-muda', muda);
		addEventListener('scroll', () => !reduz && pedir(), { passive: true });
		new IntersectionObserver(([e]) => {
			visivel = e.isIntersecting;
			antes = 0;
			pedir();
		}).observe(canvas);
		new ResizeObserver(() => {
			pequeno = canvas.clientWidth < 500;
			const dpr = Math.min(devicePixelRatio || 1, pequeno ? 1.5 : 2);
			w = canvas.width = Math.round(canvas.clientWidth * dpr);
			h = canvas.height = Math.round(canvas.clientHeight * dpr);
			if (visivel && ativo()) desenha();
		}).observe(canvas);
		muda();
	}

	// Lemniscata de Bernoulli com profundidade: as duas voltas cruzam-se a alturas diferentes.
	function curva(t: number) {
		const s = Math.sin(t);
		const c = Math.cos(t);
		const d = 1 + s * s;
		return [c / d, (s * c) / d, 0.3 * s];
	}

	function brilho(cor: string) {
		const c = document.createElement('canvas');
		c.width = c.height = 64;
		const g = c.getContext('2d')!;
		const [r, v, a] = [1, 3, 5].map((i) => parseInt(cor.slice(i, i + 2), 16));
		const gr = g.createRadialGradient(32, 32, 0, 32, 32, 32);
		gr.addColorStop(0, 'rgba(255,255,255,0.95)');
		gr.addColorStop(0.16, `rgba(${r},${v},${a},1)`);
		gr.addColorStop(0.42, `rgba(${r},${v},${a},0.28)`);
		gr.addColorStop(1, `rgba(${r},${v},${a},0)`);
		g.fillStyle = gr;
		g.fillRect(0, 0, 64, 64);
		return c;
	}
</script>

<style>
	.palco-inf {
		position: relative;
		width: min(100%, 30rem);
		aspect-ratio: 5 / 4;
	}
	canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
	.pausa {
		min-height: 36px;
		padding: 0 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--line-forte);
		background: transparent;
		color: var(--muted);
		font: 500 0.8125rem/1 var(--sans);
		cursor: pointer;
	}
	.pausa:hover {
		color: var(--text);
		border-color: var(--text);
	}
	.pausa.escondida {
		visibility: hidden;
	}
	@media (max-width: 960px) {
		.palco-inf {
			width: min(100%, 22rem);
		}
	}
</style>
