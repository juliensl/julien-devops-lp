---
// PROTÓTIPO v3 · Barra do protótipo: muda de página e abre a ficha do tema. Desde 20/10/2026
// só há a variante escura, por isso deixou de mudar de variante.
import { contraste, type P, type Pagina, type Modo } from './dados';
import { temas, nomesPagina, ligacao } from './temas';

interface Props {
	p: P;
	pagina: Pagina;
	modo: Modo;
}
const { p, pagina, modo } = Astro.props;
const tema = temas.find((t) => t.p === p)!;
const num = (n: number) => n.toLocaleString('pt-PT', { maximumFractionDigits: 1 });
const total = num(tema.fontes.reduce((s, f) => s + f.kb, 0));
const paginas: Pagina[] = ['inicio', 'ecologia', 'perguntas'];
const curto: Record<Pagina, string> = { ...nomesPagina, inicio: 'Início' };
const idFicha = `ficha-p${p}-${pagina}`;
---

<div class="comutador" role="region" aria-label="Protótipo: páginas" data-comutador>
	<span class="tag">Protótipo</span>
	<ul class="paginas">
		{
			paginas.map((pg) => (
				<li>
					<a href={ligacao(modo, p, pg)} aria-current={pg === pagina ? 'page' : undefined}>
						{curto[pg]}
					</a>
				</li>
			))
		}
	</ul>
	<details class="ficha" data-fecha>
		<summary>Ficha</summary>
		<div class="ficha-painel" id={idFicha}>
			<h2>{tema.letra} · {tema.nome}</h2>
			<p>{tema.resumo}</p>
			<p>
				<strong>Fontes:</strong>
				{tema.fontes.map((f) => `${f.nome} (${f.uso}, ${num(f.kb)} KB)`).join(' + ')} = {total} KB
			</p>
			<ul class="cores">
				{
					tema.cores.map((c) => (
						<li>
							<span class="amostra" style={`background:${c.hex}`} />
							<span>
								{c.nome} <code>{c.hex}</code>
								{c.hex !== tema.fundo && !c.fundo && (
									<small> · {num(contraste(c.hex, c.sobre ?? tema.fundo))}:1</small>
								)}
							</span>
						</li>
					))
				}
			</ul>
			<p><strong>Decisões</strong></p>
			<ul class="decisoes">
				{tema.decisoes.map((d) => <li>{d}</li>)}
			</ul>
			<p class="pe">Contraste sobre o fundo. AA: 4,5:1 texto normal, 3:1 texto grande e componentes.</p>
		</div>
	</details>
</div>


<style>
	.comutador {
		position: fixed;
		left: 0;
		right: 0;
		margin-inline: auto;
		width: fit-content;
		bottom: calc(14px + env(safe-area-inset-bottom, 0px));
		z-index: 60;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.3rem 0.35rem;
		border-radius: 999px;
		background: #ffffff;
		color: #111111;
		box-shadow:
			0 8px 28px rgb(0 0 0 / 0.5),
			0 0 0 1px rgb(0 0 0 / 0.08);
		font: 500 0.8125rem/1.2 system-ui, -apple-system, 'Segoe UI', sans-serif;
		max-width: calc(100vw - 24px);
	}
	.comutador ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 0.15rem;
	}
	.tag {
		font-size: 0.625rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.2rem 0.45rem;
		border-radius: 4px;
		background: #fff3c4;
		color: #5c4400;
		margin-inline: 0.2rem;
	}
	.comutador a,
	.ficha summary {
		display: inline-grid;
		place-items: center;
		min-width: 36px;
		min-height: 36px;
		padding: 0 0.55rem;
		border-radius: 999px;
		color: #111111;
		text-decoration: none;
		cursor: pointer;
	}
	.comutador a:hover {
		background: #ececec;
	}
	.comutador a[aria-current] {
		background: #111111;
		color: #ffffff;
	}
	.comutador :focus-visible {
		outline: 2px solid #1a56db;
		outline-offset: 2px;
	}
	.ficha summary {
		list-style: none;
		background: #111111;
		color: #ffffff;
		padding: 0 0.85rem;
	}
	.ficha summary::-webkit-details-marker {
		display: none;
	}
	.ficha-painel {
		position: fixed;
		right: calc(12px + env(safe-area-inset-right, 0px));
		bottom: calc(76px + env(safe-area-inset-bottom, 0px));
		width: min(25rem, calc(100vw - 24px));
		max-height: calc(100vh - 140px);
		overflow-y: auto;
		padding: 1rem 1.1rem;
		border-radius: 14px;
		background: #ffffff;
		color: #111111;
		box-shadow: 0 12px 40px rgb(0 0 0 / 0.5);
		font: 400 0.8125rem/1.45 system-ui, sans-serif;
		display: grid;
		gap: 0.6rem;
	}
	.ficha-painel h2 {
		font: 700 1rem/1.2 system-ui, sans-serif;
		margin: 0;
	}
	.ficha-painel p {
		margin: 0;
	}
	.comutador .cores,
	.comutador .decisoes {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.35rem;
	}
	.comutador .decisoes {
		list-style: disc;
		padding-left: 1.1rem;
	}
	.cores li {
		display: grid;
		grid-template-columns: 24px 1fr;
		gap: 0.55rem;
		align-items: center;
	}
	.amostra {
		width: 24px;
		height: 24px;
		border-radius: 6px;
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
	}
	.pe,
	.cores small {
		color: #555555;
	}
	@media (max-width: 520px) {
		.tag {
			display: none;
		}
	}
</style>
