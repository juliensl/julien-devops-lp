---
// PROTÓTIPO v3 · Ícone de folha, redesenhado a 20/10/2026 a pedido do Julien: contorno com ponta,
// talinho reto como nos ícones habituais, nervura e só dois riscos de detalhe.
interface Props {
	tamanho?: number;
}
const { tamanho = 20 } = Astro.props;
---

<svg
	class="folha"
	width={tamanho}
	height={tamanho}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.9"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	><path d="M5 19.5C1.8 11 11 3.8 20.5 3.5C20.7 13.5 13.5 22.7 5 19.5Z"></path><path d="M3 21.5L14.6 9.6"></path><path
		d="M8.1 16.3V12.3"></path><path d="M12.9 11.4H17"></path></svg
>
