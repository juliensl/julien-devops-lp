---
// The mini-diagram of a Block (prototype v3): it shows the Block's result, not only its technology.
// It animates only once the page has loaded, only while in view, and stops with the pause button.
// Until it first starts, with reduced motion and without JS, it stays still on a frame that shows
// the result.
import type { Dictionary } from '../i18n/fr';

interface Props {
	/** The Block, from 1 to 4. */
	block: number;
	/** The words drawn in the 4 diagrams, and what each one shows, for screen readers. */
	words: Dictionary['homePage']['services']['diagrams'];
}

const { block, words } = Astro.props;
const { pipeline, cleanup, scaling, monitoring } = words;
const description = [pipeline, cleanup, scaling, monitoring][block - 1]!.description;
---

{/* The margin on each side of the viewBox leaves room for the longer words in French and English. */}
<div class="rounded-2xl border border-line bg-surface p-3 sm:px-5 sm:py-4">
	<svg class="diagram" viewBox="-8 0 256 110" role="img" aria-label={description} data-diagram>
		{block === 1 && (
			<g>
				<line x1="24" y1="44" x2="216" y2="44" class="track" />
				<circle cx="24" cy="44" r="7" class="node" />
				<circle cx="88" cy="44" r="7" class="node" />
				<rect x="145" y="29" width="14" height="30" rx="4" class="gate" />
				<circle cx="216" cy="44" r="7" class="node end" />
				<circle cx="24" cy="44" r="5" class="change passes" />
				<circle cx="24" cy="44" r="5" class="change blocked" />
				<rect x="122" y="2" width="60" height="18" rx="9" class="badge appears" />
				<text x="152" y="15" class="badge-text appears">
					{pipeline.blocked}
				</text>
				<text x="24" y="84">
					{pipeline.commit}
				</text>
				<text x="88" y="84">
					{pipeline.tests}
				</text>
				<text x="152" y="84">
					{pipeline.security}
				</text>
				<text x="216" y="84">
					{pipeline.production}
				</text>
			</g>
		)}
		{block === 2 && (
			<g>
				<rect x="4" y="10" width="132" height="62" rx="8" class="code" />
				<g class="loops">
					<line x1="16" y1="22" x2="84" y2="22" class="line" />
					<line x1="28" y1="32" x2="92" y2="32" class="line" />
					<g class="bug">
						<line x1="28" y1="42" x2="72" y2="42" class="line" />
						<path d="M80 39l6 6m0-6-6 6" class="cross" />
						<text x="102" y="45.5" class="bug-text">
							{cleanup.bug}
						</text>
					</g>
					<g class="rises">
						<line x1="28" y1="42" x2="96" y2="42" class="line" />
						<line x1="40" y1="52" x2="80" y2="52" class="line" />
					</g>
					<g class="twice">
						<line x1="28" y1="72" x2="96" y2="72" class="line" />
						<line x1="40" y1="82" x2="80" y2="82" class="line" />
						<path d="M102 68h4v18h-4" class="brace" />
						<text x="119" y="80.5" class="twice-text">
							{cleanup.duplicate}
						</text>
					</g>
					<line x1="16" y1="62" x2="56" y2="62" class="line rises-twice" />
					<line x1="157" y1="42" x2="233" y2="42" class="response" />
				</g>
				<rect x="150" y="35" width="90" height="14" rx="7" class="frame" />
				<text x="195" y="64">
					{cleanup.responseTime}
				</text>
			</g>
		)}
		{block === 3 && (
			<g>
				<polyline points="10,74 50,70 80,40 110,22 140,30 170,62 200,72 230,74" class="load" />
				{[0, 1, 2, 3, 4, 5].map((k) => (
					<rect
						x={20 + k * 36}
						y="84"
						width="22"
						height="16"
						rx="4"
						class:list={['instance', `i${k}`]}
					/>
				))}
				<text x="34" y="20">
					{scaling.load}
				</text>
				<text x="120" y="109">
					{scaling.instances}
				</text>
			</g>
		)}
		{block === 4 && (
			<g>
				<rect x="8" y="10" width="224" height="76" rx="10" class="frame" />
				<polyline
					class="signal"
					points="16,58 56,58 66,58 74,40 84,70 94,58 140,58 150,58 158,22 168,78 178,58 224,58"
				/>
				<circle cx="158" cy="22" r="5" class="alert blinks" />
				<rect x="170" y="16" width="54" height="18" rx="9" class="badge blinks" />
				<text x="197" y="29" class="badge-text blinks">
					{monitoring.alert}
				</text>
				<text x="50" y="102">
					{monitoring.dashboard}
				</text>
			</g>
		)}
	</svg>
</div>

<script>
	import { afterLoad } from '../scripts/after-load';

	// A diagram runs while at least 30 % of it is in view. It starts the first time it is in view with
	// the animations running: a diagram first seen while paused shows the still frame, not the first one.
	afterLoad(() => {
		const html = document.documentElement;
		const diagrams = document.querySelectorAll<SVGElement>('[data-diagram]');
		const start = (diagram: Element) => {
			if (diagram.hasAttribute('data-in-view') && html.dataset.animation !== 'paused') {
				diagram.toggleAttribute('data-started', true);
			}
		};
		const observer = new IntersectionObserver(
			(entries) => {
				for (const { target, isIntersecting } of entries) {
					target.toggleAttribute('data-in-view', isIntersecting);
					start(target);
				}
			},
			{ threshold: 0.3 },
		);
		for (const diagram of diagrams) observer.observe(diagram);
		document.addEventListener('animation', () => diagrams.forEach(start));
	});
</script>

<style>
	/* The "blocked" and "alert" red of prototype v3. It is not in #54's colors: to confirm in the
	   First review (#74). */
	.diagram {
		--red: #f08f86;
		--red-text: #f4a49c;
		display: block;
		width: 100%;
		height: auto;
		max-height: 11rem;
		border-radius: 0.6rem;
		background: var(--color-background);
	}
	text {
		font:
			500 10px/1 var(--font-body),
			sans-serif;
		fill: var(--color-foreground-secondary);
		text-anchor: middle;
	}

	/* Block 1: a change goes through; the next one, with a security flaw, stops at the gate. Still,
	   the blocked one waits at the gate, in red. */
	.track {
		stroke: var(--color-line-strong);
		stroke-width: 2;
	}
	.node {
		fill: var(--color-surface-2);
		stroke: var(--color-foreground-secondary);
		stroke-width: 1.5;
	}
	.node.end {
		stroke: var(--color-green);
	}
	.gate {
		fill: color-mix(in srgb, var(--red) 25%, transparent);
		stroke: var(--red);
		stroke-width: 1.5;
	}
	.change {
		fill: var(--color-green);
	}
	.passes {
		opacity: 0;
	}
	.blocked {
		fill: var(--red);
		transform: translateX(110px);
	}
	.badge {
		fill: color-mix(in srgb, var(--red) 18%, transparent);
		stroke: var(--red);
	}
	.badge-text {
		fill: var(--red-text);
	}

	/* Block 2: in the code, the bug goes, then the lines written twice; the code gets shorter and the
	   response time drops. Still, the code is clean and the response time short. */
	.frame {
		fill: none;
		stroke: var(--color-line-strong);
		stroke-width: 1.2;
		stroke-dasharray: 3 3;
	}
	.code {
		fill: var(--color-surface-2);
		stroke: var(--color-line-strong);
		stroke-width: 1.2;
		vector-effect: non-scaling-stroke;
		transform-box: fill-box;
		transform-origin: top;
	}
	.line {
		stroke: var(--color-foreground-secondary);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.bug,
	.twice {
		opacity: 0;
	}
	.bug .line,
	.cross {
		stroke: var(--red);
	}
	.cross {
		fill: none;
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	.bug-text {
		fill: var(--red-text);
	}
	.twice .line,
	.brace {
		stroke: var(--color-purple);
	}
	.brace {
		fill: none;
		stroke-width: 1.2;
	}
	.twice-text {
		fill: var(--color-purple);
	}
	.response {
		stroke: var(--color-green);
		stroke-width: 8;
		stroke-linecap: round;
		stroke-dasharray: 20 200;
	}

	/* Block 3: the instances follow the load. Still, at the peak, they are all on. */
	.load {
		fill: none;
		stroke: var(--color-purple);
		stroke-width: 2;
		stroke-dasharray: 4 4;
	}
	.instance {
		fill: var(--color-green);
	}

	/* Block 4: an anomaly in the signal raises an alert. Still, the alert is on. */
	.signal {
		fill: none;
		stroke: var(--color-green);
		stroke-width: 2.5;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	.alert {
		fill: var(--red);
	}

	/* In motion: only once the script has started them, and never with reduced motion. */
	@media (prefers-reduced-motion: no-preference) {
		[data-started] .gate {
			animation: gate 4s ease-in-out 2s infinite backwards var(--play);
		}
		[data-started] .passes {
			animation: passes 4s linear infinite var(--play);
		}
		[data-started] .blocked {
			animation: blocked 4s linear 2s infinite backwards var(--play);
		}
		[data-started] .appears {
			animation: appears 4s ease 2s infinite backwards var(--play);
		}
		[data-started] .loops {
			animation: loops 5s linear infinite var(--play);
		}
		[data-started] .bug {
			animation: bug 5s ease-in-out infinite var(--play);
		}
		[data-started] .rises {
			animation: rises 5s ease-in-out infinite var(--play);
		}
		[data-started] .twice {
			animation: twice 5s ease-in-out infinite var(--play);
		}
		[data-started] .rises-twice {
			animation: rises-twice 5s ease-in-out infinite var(--play);
		}
		[data-started] .code {
			animation: shrinks 5s ease-in-out infinite var(--play);
		}
		[data-started] .response {
			animation: drops 5s ease-in-out infinite var(--play);
		}
		[data-started] .load {
			animation: load 5s linear infinite var(--play);
		}
		[data-started] :is(.i2, .i3, .i4, .i5) {
			animation: scales 5s ease-in-out infinite backwards var(--play);
		}
		[data-started] .i3 {
			animation-delay: 0.2s;
		}
		[data-started] .i4 {
			animation-delay: 0.4s;
		}
		[data-started] .i5 {
			animation-delay: 0.6s;
		}
		[data-started] .signal {
			stroke-dasharray: 340;
			animation: draws 3.6s linear infinite var(--play);
		}
		[data-started] .blinks {
			animation: blinks 3.6s ease infinite var(--play);
		}
	}

	/* Started, a diagram runs only while in view and the animations are not paused (#62). Each
	   animation takes its play state from --play, which its elements inherit from the diagram. */
	.diagram {
		--play: paused;
	}
	:global(:root:not([data-animation='paused'])) .diagram[data-in-view] {
		--play: running;
	}

	@keyframes passes {
		0% {
			transform: translateX(0);
			opacity: 0;
		}
		8%,
		88% {
			opacity: 1;
		}
		100% {
			transform: translateX(192px);
			opacity: 0;
		}
	}
	@keyframes blocked {
		0% {
			transform: translateX(0);
			opacity: 0;
			fill: var(--color-green);
		}
		8% {
			opacity: 1;
		}
		50% {
			transform: translateX(110px);
			fill: var(--color-green);
		}
		58%,
		88% {
			transform: translateX(110px);
			fill: var(--red);
			opacity: 1;
		}
		100% {
			transform: translateX(110px);
			opacity: 0;
		}
	}
	@keyframes gate {
		0%,
		48%,
		100% {
			stroke: var(--color-foreground-secondary);
			fill: var(--color-surface-2);
		}
		56%,
		90% {
			stroke: var(--red);
			fill: color-mix(in srgb, var(--red) 25%, transparent);
		}
	}
	@keyframes appears {
		0%,
		50%,
		100% {
			opacity: 0;
		}
		58%,
		88% {
			opacity: 1;
		}
	}
	/* The code fades out at the end of each loop, while its block grows back for the next one. */
	@keyframes loops {
		0%,
		94%,
		100% {
			opacity: 0;
		}
		6%,
		88% {
			opacity: 1;
		}
	}
	@keyframes bug {
		0%,
		15% {
			opacity: 1;
		}
		25%,
		100% {
			opacity: 0;
		}
	}
	/* Each line below a removed one moves up into its place, 10 units per line. */
	@keyframes rises {
		0%,
		25% {
			transform: translateY(10px);
		}
		35%,
		100% {
			transform: translateY(0);
		}
	}
	@keyframes twice {
		0%,
		25% {
			transform: translateY(0);
			opacity: 1;
		}
		35%,
		45% {
			transform: translateY(-10px);
			opacity: 1;
		}
		55%,
		100% {
			transform: translateY(-10px);
			opacity: 0;
		}
	}
	@keyframes rises-twice {
		0%,
		25% {
			transform: translateY(30px);
		}
		35%,
		55% {
			transform: translateY(20px);
		}
		65%,
		100% {
			transform: translateY(0);
		}
	}
	/* The block holds 8 lines, then 7, then 5: 92, 82 and 62 units high. */
	@keyframes shrinks {
		0%,
		25%,
		100% {
			transform: scaleY(1.4839);
		}
		35%,
		55% {
			transform: scaleY(1.3226);
		}
		65%,
		94% {
			transform: scaleY(1);
		}
	}
	@keyframes drops {
		0%,
		60% {
			stroke-dasharray: 76 200;
			stroke: var(--red);
		}
		75%,
		100% {
			stroke-dasharray: 20 200;
			stroke: var(--color-green);
		}
	}
	@keyframes load {
		to {
			stroke-dashoffset: -32;
		}
	}
	@keyframes scales {
		0%,
		15%,
		85%,
		100% {
			opacity: 0.15;
		}
		35%,
		65% {
			opacity: 1;
		}
	}
	@keyframes draws {
		from {
			stroke-dashoffset: 340;
		}
		to {
			stroke-dashoffset: 0;
		}
	}
	@keyframes blinks {
		0%,
		55%,
		100% {
			opacity: 0.2;
		}
		62%,
		92% {
			opacity: 1;
		}
	}
</style>
