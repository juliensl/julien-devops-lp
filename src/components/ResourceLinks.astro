---
// The header's links to the «Recursos» pages, which help a CTO decide, in the desktop submenu and in
// the mobile menu. The page the Visitor is on is marked as the current page.
import type { Language } from '../config/site';
import { dictionaries } from '../i18n';
import { ecologyPath } from '../lib/paths';
import { withNonBreakingSpaces } from '../lib/spaces';

interface Props {
	language: Language;
	class?: string;
}

const { language, class: className } = Astro.props;
const t = dictionaries[language];
const pages = [
	// One line per page, in the submenu's order.
	{ name: t.ecology.link, path: ecologyPath(language) },
];
---

<ul class={className}>
	{pages.map(({ name, path }) => (
		<li>
			<a
				href={path}
				aria-current={Astro.url.pathname === path ? 'page' : undefined}
				class="flex min-h-11 items-center rounded-lg px-2 hover:bg-surface-2"
			>
				{withNonBreakingSpaces(name)}
			</a>
		</li>
	))}
</ul>
