---
// PROTÓTIPO · Direção C «Faixas ao entardecer»: faixas largas em roxo, uma faixa
// verde-escura em «Quem é o Julien», Bona Nova + Inter, título à esquerda.
import { Image } from 'astro:assets';
import foto from '../../../data/IMG_2030.png';
import {
	calendly,
	textos,
	problemas,
	depois,
	paraQuem,
	blocos,
	notaBlocos,
	stack,
	niveis,
	notaStack,
	faq,
	rodape,
} from './conteudo';

const promessaH1 = textos.promessa.replace('entrego-te', '<span style="white-space:nowrap">entrego-te</span>');
---

<div class="vc" id="variante-c" data-variante="c" hidden>
	<header class="topo">
		<div class="dentro">
			<span class="nome" aria-label="Julien Laffont">
				<span class="l1"><span class="fr">Jul</span>ien</span>
				<span class="l2">Laff<span class="fr">ont</span></span>
			</span>
			<nav class="linguas" aria-label="Língua">
				<span>FR</span><span>EN</span><span aria-current="true">PT</span>
			</nav>
			<a class="botao" href={calendly}>{textos.cta}</a>
		</div>
	</header>

	<main>
		<section class="banda" data-secao="hero">
			<div class="grelha hero">
				<div class="hero-texto">
					<p class="etiqueta">{textos.designacao}</p>
					<h1 set:html={promessaH1} />
					<p class="lead">{textos.subPromessa}</p>
					<div class="acao">
						<a class="botao grande" href={calendly}>{textos.cta}</a>
						<span class="nota">{textos.notaCta}</span>
					</div>
				</div>
				<aside class="para-quem">
					<p class="etiqueta">Para quem é</p>
					<ul>
						{paraQuem.map((p) => <li>{p}</li>)}
					</ul>
				</aside>
			</div>
		</section>

		<section class="banda alt" data-secao="problema">
			<div class="grelha">
				<h2>Dois caminhos.</h2>
				<div class="dois">
					<div>
						<p class="etiqueta muted">Hoje</p>
						<ul class="lista">
							{
								problemas.map((p) => (
									<li>
										<strong>{p.titulo}</strong> {p.texto}
									</li>
								))
							}
						</ul>
					</div>
					<div>
						<p class="etiqueta verde">Depois</p>
						<ul class="lista depois">
							{depois.map((d) => <li>{d}</li>)}
						</ul>
					</div>
				</div>
			</div>
		</section>

		<section class="banda" data-secao="metodo cursor garantia">
			<div class="grelha">
				<div class="titulo-col">
					<h2>Escolhe os teus blocos.</h2>
					<p class="intro">{notaBlocos}</p>
				</div>
				<div class="config-grelha">
					<fieldset class="config">
						<legend class="sr">Blocos a contratar</legend>
						{
							blocos.map((b) => (
								<label class="opcao">
									<input type="checkbox" name="bloco-c" value={b.n} checked />
									<span class="topo-opcao">
										<span class="bn">Bloco {b.n}</span>
										<span class="visto" aria-hidden="true" />
									</span>
									<span class="on">{b.nome}</span>
									<span class="txt">{b.texto}</span>
									<span class="ferr">{b.ferramentas.join(' · ')}</span>
								</label>
							))
						}
						<label class="interruptor">
							<input type="checkbox" id="contentorizada-c" role="switch" />
							<span class="pista" aria-hidden="true"></span>
							A minha aplicação já está contentorizada
						</label>
					</fieldset>
					<aside class="resumo">
						<p class="etiqueta">O teu pedido</p>
						<dl aria-live="polite">
							<div>
								<dt>Blocos</dt>
								<dd data-r="blocos">1, 2, 3 e 4</dd>
							</div>
							<div>
								<dt>Prazo</dt>
								<dd data-r="prazo">Até 30 dias, a contar do início da Implementação</dd>
							</div>
							<div>
								<dt>Garantia de disponibilidade</dt>
								<dd data-r="garantia" class="sim">Aplica-se</dd>
							</div>
							<div>
								<dt>Preço</dt>
								<dd>Fixo, na Proposta de intervenção, depois do Diagnóstico gratuito</dd>
							</div>
						</dl>
						<p class="garantia-txt" data-r="garantia-txt">{textos.garantia}</p>
						<p class="aviso" data-r="aviso" hidden></p>
						<a class="botao" href={calendly}>{textos.cta}</a>
					</aside>
				</div>
			</div>
			<div class="grelha">
				<span></span>
				<p class="nota-proto">
					Usa só regras já validadas: qualquer combinação, o bloco 3 precisa de uma aplicação contentorizada, a
					Garantia só com os blocos 3 e 4. Não mostra preços.
				</p>
			</div>
		</section>

		<section class="banda alt" data-secao="stack">
			<div class="grelha">
				<div class="titulo-col">
					<h2>A stack, por nível de domínio.</h2>
					<p class="nota-proto">{notaStack}</p>
				</div>
				<div class="stack">
					<div class="filtros" role="group" aria-label="Filtrar por bloco">
						<button type="button" data-f="0" aria-pressed="true">Todos</button>
						{
							blocos.map((b) => (
								<button type="button" data-f={b.n} aria-pressed="false">
									Bloco {b.n}
								</button>
							))
						}
					</div>
					<div class="legenda" aria-hidden="true">
						<span><i class="n3"></i>{niveis[3]}</span>
						<span><i class="n2"></i>{niveis[2]}</span>
						<span><i class="n1"></i>{niveis[1]}</span>
					</div>
					<div class="colunas">
						{
							stack.map((g) => (
								<div class="grupo" data-bloco={g.bloco}>
									<ul class="barras">
										{g.ferramentas.map((f) => (
											<li class:list={[`n${f.nivel}`, { confirmar: f.aConfirmar }]} style={`--h:${f.nivel / 3}`}>
												<span class="area-col">
													<span class="col" />
												</span>
												<span class="rot">
													{f.nome}
													{f.aConfirmar && <em>a confirmar</em>}
												</span>
												<span class="sr">{niveis[f.nivel]}</span>
											</li>
										))}
									</ul>
									<p class="area">
										{g.area} <span>· bloco {g.bloco}</span>
									</p>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<section class="banda verde" data-secao="quem">
			<div class="grelha">
				<h2>Quem é o Julien</h2>
				<div class="quem">
					<Image src={foto} alt={textos.fotoAlt} width={560} format="avif" quality={55} loading="lazy" class="foto" />
					<div class="quem-dir">
						<p class="quem-texto">{textos.quem}</p>
						<figure class="testemunho">
							<blockquote>«Lugar para um testemunho de um CTO, com duas ou três frases.»</blockquote>
							<figcaption>Nome · Cargo · Empresa</figcaption>
						</figure>
						<p class="nota-proto">Os testemunhos chegam mais tarde.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="banda" data-secao="faq">
			<div class="grelha">
				<h2>Perguntas.</h2>
				<div class="faq">
					{
						faq.map((q) => (
							<details>
								<summary>{q.p}</summary>
								<p>{q.r}</p>
							</details>
						))
					}
				</div>
			</div>
		</section>

		<section class="banda alt" data-secao="final">
			<div class="grelha">
				<h2 class="final-titulo">{textos.finalTitulo}</h2>
				<div class="final">
					<p class="intro">{textos.finalTexto}</p>
					<a class="botao grande" href={calendly}>{textos.cta}</a>
					<p class="nota">{textos.notaLingua}</p>
				</div>
			</div>
		</section>
	</main>

	<footer class="rodape">
		<div class="grelha linha">
			<span>{rodape.marca}</span>
			<span>{rodape.email}</span>
			{rodape.ligacoes.map((l) => <span class="lig">{l}</span>)}
		</div>
	</footer>
</div>

<script>
	const raiz = document.getElementById('variante-c')!;
	const caixas = [...raiz.querySelectorAll<HTMLInputElement>('input[name="bloco-c"]')];
	const contentorizada = raiz.querySelector<HTMLInputElement>('#contentorizada-c')!;
	const r = (k: string) => raiz.querySelector<HTMLElement>(`[data-r="${k}"]`)!;

	const lista = (ns: number[]) =>
		ns.length === 1 ? String(ns[0]) : `${ns.slice(0, -1).join(', ')} e ${ns[ns.length - 1]}`;

	function atualiza() {
		const s = caixas.filter((c) => c.checked).map((c) => Number(c.value));
		const tem = (n: number) => s.includes(n);
		const contentor = tem(2) || contentorizada.checked;
		r('blocos').textContent = s.length ? lista(s) : 'Nenhum';
		r('prazo').textContent = s.length
			? 'Até 30 dias, a contar do início da Implementação'
			: 'Escolhe pelo menos um bloco';
		const garante = tem(3) && tem(4) && contentor;
		const g = r('garantia');
		g.className = garante ? 'sim' : 'nao';
		g.textContent = garante
			? 'Aplica-se'
			: !(tem(3) && tem(4))
				? 'Não se aplica: precisa dos blocos 3 e 4'
				: 'Não se aplica: falta uma aplicação contentorizada';
		r('garantia-txt').hidden = !garante;
		const aviso = r('aviso');
		aviso.hidden = !(tem(3) && !contentor);
		aviso.textContent = 'O bloco 3 precisa de uma aplicação contentorizada: junta o bloco 2 ou marca que já está.';
	}
	[...caixas, contentorizada].forEach((c) => c.addEventListener('change', atualiza));
	atualiza();

	const botoes = [...raiz.querySelectorAll<HTMLButtonElement>('.filtros button')];
	const grupos = [...raiz.querySelectorAll<HTMLElement>('.grupo')];
	botoes.forEach((b) =>
		b.addEventListener('click', () => {
			const f = b.dataset.f!;
			botoes.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
			grupos.forEach((g) => (g.hidden = f !== '0' && g.dataset.bloco !== f));
		}),
	);
</script>

<style>
	.vc {
		--bg: #1e1528;
		--band: #271c34;
		--band-green: #11271f;
		--line: #3d3049;
		--text: #f4eff8;
		--muted: #c0b4cd;
		--violet: #d2b6ff;
		--green: #97d6b0;
		--n3: #d2b6ff;
		--n2: #a68fd6;
		--n1: #8573b0;
		--serif: 'Bona Nova', 'Iowan Old Style', Georgia, serif;
		--sans: 'Inter', ui-sans-serif, system-ui, sans-serif;
		background: var(--bg);
		color: var(--text);
		font: 400 1rem/1.65 var(--sans);
		padding-bottom: 6rem;
	}
	.topo {
		position: sticky;
		top: env(safe-area-inset-top, 0px);
		z-index: 5;
		background: var(--bg);
		border-bottom: 1px solid var(--line);
	}
	.dentro,
	.grelha {
		max-width: 74rem;
		margin: 0 auto;
		padding-left: max(16px, env(safe-area-inset-left, 0px));
		padding-right: max(16px, env(safe-area-inset-right, 0px));
	}
	.dentro {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding-block: 0.6rem;
	}
	.nome {
		display: grid;
		font: 400 1.05rem/1.2 var(--serif);
		text-transform: uppercase;
		letter-spacing: 0.12em;
	}
	.l2 {
		padding-left: 1.1em;
	}
	.fr {
		display: inline-block;
		border: 1px solid var(--violet);
		border-radius: 0.38em;
		padding: 0 0.12em 0 0.2em;
		margin: 1px 0.05em;
	}
	.linguas {
		margin-left: auto;
		display: flex;
		gap: 0.75rem;
		font-size: 0.8125rem;
		letter-spacing: 0.06em;
		color: var(--muted);
	}
	.linguas span {
		display: inline-flex;
		align-items: center;
		min-height: 24px;
		min-width: 24px;
	}
	.linguas [aria-current] {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.botao {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0 1.15rem;
		border-radius: 10px;
		background: var(--violet);
		color: var(--bg);
		font-weight: 600;
		font-size: 0.9375rem;
		text-decoration: none;
		white-space: nowrap;
	}
	.botao:hover {
		background: #e2d0ff;
	}
	.botao:focus-visible,
	summary:focus-visible,
	.filtros button:focus-visible,
	.opcao:has(input:focus-visible),
	.interruptor:has(input:focus-visible) {
		outline: 2px solid var(--green);
		outline-offset: 3px;
	}
	.botao.grande {
		min-height: 52px;
		padding: 0 1.5rem;
		font-size: 1.0625rem;
	}
	.banda {
		padding-block: 4.5rem;
	}
	.banda.alt {
		background: var(--band);
	}
	.banda.verde {
		background: var(--band-green);
	}
	.grelha {
		display: grid;
		grid-template-columns: minmax(0, 19rem) minmax(0, 1fr);
		gap: 2rem 3.5rem;
		align-items: start;
	}
	.grelha + .grelha {
		margin-top: 1.5rem;
	}
	.titulo-col {
		display: grid;
		gap: 1rem;
		position: sticky;
		top: 6rem;
	}
	h1,
	h2,
	h3,
	summary,
	.quem-texto,
	.on {
		font-family: var(--serif);
		font-weight: 400;
	}
	h1,
	h2 {
		margin: 0;
		text-wrap: balance;
	}
	h1 {
		font-size: clamp(2.4rem, 5.5vw, 4rem);
		line-height: 1.08;
		letter-spacing: -0.01em;
	}
	h2 {
		font-size: clamp(1.9rem, 3.6vw, 2.6rem);
		line-height: 1.12;
	}
	p {
		margin: 0;
	}
	.etiqueta {
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--violet);
	}
	.etiqueta.muted {
		color: var(--muted);
	}
	.etiqueta.verde {
		color: var(--green);
	}
	.lead,
	.intro {
		color: var(--muted);
	}
	.lead {
		font-size: 1.125rem;
		max-width: 38rem;
	}
	.nota {
		font-size: 0.875rem;
		color: var(--muted);
	}
	.hero {
		grid-template-columns: minmax(0, 1fr) minmax(0, 19rem);
		padding-top: 1.5rem;
	}
	.hero-texto {
		display: grid;
		gap: 1.25rem;
	}
	.acao {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
	}
	.para-quem {
		display: grid;
		gap: 0.75rem;
		padding: 1.25rem 0 0 1.5rem;
		border-left: 1px solid var(--line);
	}
	.para-quem ul,
	.lista {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
	}
	.para-quem li {
		padding-block: 0.7rem;
		border-top: 1px solid var(--line);
	}
	.para-quem li::before,
	.depois li::before {
		content: '';
		display: inline-block;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--green);
		margin-right: 0.6rem;
		vertical-align: 0.15em;
	}
	.dois {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2.5rem;
	}
	.dois > div {
		display: grid;
		gap: 0.75rem;
		align-content: start;
	}
	.lista li {
		padding-block: 0.85rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
	}
	.lista strong {
		color: var(--text);
		font-weight: 600;
	}
	.depois li {
		color: var(--text);
	}
	.config-grelha {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 17rem);
		gap: 1.5rem;
		align-items: start;
	}
	.config {
		border: 0;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		min-width: 0;
	}
	.opcao {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1rem 1.1rem;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--band);
		cursor: pointer;
		transition: border-color 0.15s ease;
	}
	.opcao:has(input:checked) {
		border-color: var(--violet);
		background: #2e2240;
	}
	.opcao input,
	.interruptor input {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
	}
	.topo-opcao {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.bn {
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--violet);
	}
	.visto {
		width: 22px;
		height: 22px;
		border-radius: 7px;
		border: 1.5px solid var(--muted);
		display: grid;
		place-items: center;
	}
	.opcao:has(input:checked) .visto {
		background: var(--violet);
		border-color: var(--violet);
	}
	.opcao:has(input:checked) .visto::after {
		content: '';
		width: 9px;
		height: 5px;
		border-left: 2px solid var(--bg);
		border-bottom: 2px solid var(--bg);
		transform: translateY(-1px) rotate(-45deg);
	}
	.on {
		font-size: 1.3rem;
		line-height: 1.2;
	}
	.txt {
		font-size: 0.875rem;
		color: var(--muted);
	}
	.ferr {
		margin-top: auto;
		font-size: 0.8125rem;
		color: var(--green);
	}
	.interruptor {
		grid-column: 1 / -1;
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 0.25rem;
		font-size: 0.9375rem;
		cursor: pointer;
	}
	.interruptor .pista {
		flex: none;
		width: 42px;
		height: 24px;
		border-radius: 999px;
		border: 1.5px solid var(--muted);
		position: relative;
	}
	.interruptor .pista::after {
		content: '';
		position: absolute;
		top: 3px;
		left: 3px;
		width: 15px;
		height: 15px;
		border-radius: 50%;
		background: var(--muted);
		transition: transform 0.15s ease;
	}
	.interruptor:has(input:checked) .pista {
		border-color: var(--green);
		background: rgb(151 214 176 / 0.2);
	}
	.interruptor:has(input:checked) .pista::after {
		transform: translateX(18px);
		background: var(--green);
	}
	.resumo {
		position: sticky;
		top: 6rem;
		display: grid;
		gap: 1rem;
		padding: 1.25rem;
		border-radius: 14px;
		border: 1px solid var(--line);
		background: #160f1e;
	}
	.resumo dl {
		margin: 0;
		display: grid;
	}
	.resumo dl > div {
		padding-block: 0.6rem;
		border-top: 1px solid var(--line);
	}
	.resumo dt {
		font-size: 0.75rem;
		color: var(--muted);
	}
	.resumo dd {
		margin: 0;
		font-size: 0.9375rem;
	}
	.resumo dd.sim {
		color: var(--green);
		font-weight: 600;
	}
	.resumo dd.nao {
		color: var(--muted);
	}
	.garantia-txt {
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.aviso {
		font-size: 0.875rem;
		color: #ffd7a8;
		padding: 0.6rem 0.75rem;
		border-radius: 10px;
		border: 1px solid #a8805a;
	}
	.stack {
		display: grid;
		gap: 1.25rem;
		min-width: 0;
	}
	.filtros {
