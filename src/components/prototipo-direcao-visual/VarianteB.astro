---
// PROTÓTIPO · Direção B «Painel acolhedor»: grelha de cartões arredondados,
// Fraunces suave + Instrument Sans, azul-violeta perto da Scaleway sem néon.
import { Image } from 'astro:assets';
import foto from '../../../data/IMG_2030.png';
import {
	calendly,
	textos,
	blocos,
	notaBlocos,
	stack,
	niveis,
	notaStack,
	escalas,
	faq,
	rodape,
} from './conteudo';

const promessaH1 = textos.promessa.replace('entrego-te', '<span style="white-space:nowrap">entrego-te</span>');

const marcas = Array.from({ length: 40 });
const dias = Array.from({ length: 30 });
const curtos = ['Pré-lançamento', 'Dezenas', 'Centenas', 'Milhares'];
const inicial = 2;
const classe = (e: string) => (e === 'Essencial' ? 'ess' : e === 'Recomendado' ? 'rec' : 'esp');
---

<div class="vb" id="variante-b" data-variante="b" hidden>
	<div class="riscas" aria-hidden="true"></div>

	<header class="topo">
		<div class="dentro">
			<span class="nome"><span class="cx">J</span>ulien <span class="cx">L</span>affont</span>
			<nav class="linguas" aria-label="Língua">
				<span>FR</span><span>EN</span><span aria-current="true">PT</span>
			</nav>
			<a class="botao" href={calendly}>{textos.cta}</a>
		</div>
	</header>

	<main>
		<section class="faixa hero" data-secao="hero">
			<div class="hero-texto">
				<p class="chip"><span class="ponto"></span>{textos.designacao}</p>
				<h1 set:html={promessaH1} />
				<p class="lead">{textos.subPromessa}</p>
				<div class="acao">
					<a class="botao grande" href={calendly}>{textos.cta}</a>
					<span class="nota">{textos.notaCta}</span>
				</div>
			</div>
			<div class="hero-lado">
				<div class="pr" role="img" aria-label="Exemplo: um pull request com uma falha de segurança fica bloqueado pela pipeline">
					<div class="pr-topo">
						<span class="pr-num">Pull request #128</span>
						<span class="pr-titulo">Nova página de faturação</span>
					</div>
					<ul>
						<li class="ok" style="--d:0">
							<svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7"></path></svg>Testes unitários<span>passou</span>
						</li>
						<li class="ok" style="--d:1">
							<svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7"></path></svg>Testes de integração<span>passou</span>
						</li>
						<li class="ok" style="--d:2">
							<svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7"></path></svg>Lint<span>passou</span>
						</li>
						<li class="ko" style="--d:3">
							<svg viewBox="0 0 16 16"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7"></path></svg>Análise de segurança<span
								>1 dependência com falha conhecida</span
							>
						</li>
					</ul>
					<p class="pr-fim">Merge bloqueado até corrigir</p>
				</div>
				<p class="nota-proto">Exemplo ilustrativo do bloco 1, animado uma vez ao abrir.</p>
			</div>
		</section>

		<section class="faixa" data-secao="problema cursor">
			<h2>Onde está o teu SaaS?</h2>
			<div class="painel">
				<div class="painel-esq">
					<label class="rotulo" for="escala-b">Escala do teu SaaS</label>
					<div class="regua">
						<output for="escala-b" class="valor" style={`--p:${inicial / 3}`}>{escalas[inicial].nome}</output>
						<div class="marcas" aria-hidden="true">
							{marcas.map(() => <span />)}
						</div>
						<input
							type="range"
							id="escala-b"
							min="0"
							max={escalas.length - 1}
							step="1"
							value={inicial}
							data-escalas={JSON.stringify(escalas)}
						/>
						<div class="rotulos" aria-hidden="true">
							{curtos.map((c) => <span>{c}</span>)}
						</div>
					</div>
					<p class="sinal" aria-live="polite">{escalas[inicial].sinal}</p>
				</div>
				<div class="painel-dir">
					<p class="rotulo">Que blocos</p>
					<ul class="estados">
						{
							blocos.map((b, i) => (
								<li>
									<span>
										<span class="bn">Bloco {b.n}</span> {b.nome}
									</span>
									<span class={`estado ${classe(escalas[inicial].blocos[i])}`} data-i={i}>
										{escalas[inicial].blocos[i]}
									</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
			<p class="nota-proto">
				Afirmações novas: o Julien valida o que costuma acontecer em cada escala e que blocos recomenda.
			</p>
		</section>

		<section class="faixa" data-secao="metodo">
			<h2>Quatro blocos, os que precisares.</h2>
			<p class="intro">{notaBlocos}</p>
			<div class="cartoes">
				<article class="cartao">
					<svg class="diag d1" viewBox="0 0 240 96" aria-hidden="true">
						<line x1="24" y1="40" x2="216" y2="40" class="trilho"></line>
						<circle cx="24" cy="40" r="7" class="no"></circle>
						<circle cx="88" cy="40" r="7" class="no"></circle>
						<rect x="145" y="25" width="14" height="30" rx="4" class="portao"></rect>
						<circle cx="216" cy="40" r="7" class="no"></circle>
						<circle cx="24" cy="40" r="5" class="bola ok"></circle>
						<circle cx="24" cy="40" r="5" class="bola ko"></circle>
						<text x="24" y="78">commit</text>
						<text x="88" y="78">testes</text>
						<text x="152" y="78">segurança</text>
						<text x="216" y="78">produção</text>
					</svg>
					<p class="bn">Bloco 1</p>
					<h3>{blocos[0].nome}</h3>
					<p>{blocos[0].texto}</p>
					<p class="ferr">{blocos[0].ferramentas.map((f) => <span>{f}</span>)}</p>
				</article>
				<article class="cartao">
					<svg class="diag d2" viewBox="0 0 240 96" aria-hidden="true">
						{
							[0, 1, 2, 3, 4, 5].map((k) => (
								<g class="caixa" style={`--k:${k}`}>
									<rect x={42 + (k % 3) * 56} y={k < 3 ? 10 : 50} width="44" height="32" rx="8" />
									<line x1={52 + (k % 3) * 56} y1={k < 3 ? 22 : 62} x2={76 + (k % 3) * 56} y2={k < 3 ? 22 : 62} />
									<line x1={52 + (k % 3) * 56} y1={k < 3 ? 30 : 70} x2={68 + (k % 3) * 56} y2={k < 3 ? 30 : 70} />
								</g>
							))
						}
					</svg>
					<p class="bn">Bloco 2</p>
					<h3>{blocos[1].nome}</h3>
					<p>{blocos[1].texto}</p>
					<p class="ferr">{blocos[1].ferramentas.map((f) => <span>{f}</span>)}</p>
				</article>
				<article class="cartao">
					<svg class="diag d3" viewBox="0 0 240 96" aria-hidden="true">
						<line x1="20" y1="84" x2="220" y2="84" class="trilho"></line>
						{
							[0, 1, 2, 3, 4, 5, 6].map((k) => (
								<rect class="coluna" style={`--k:${k}`} x={30 + k * 27} y="14" width="18" height="70" rx="5" />
							))
						}
					</svg>
					<p class="bn">Bloco 3</p>
					<h3>{blocos[2].nome}</h3>
					<p>{blocos[2].texto}</p>
					<p class="ferr">{blocos[2].ferramentas.map((f) => <span>{f}</span>)}</p>
				</article>
				<article class="cartao">
					<svg class="diag d4" viewBox="0 0 240 96" aria-hidden="true">
						<polyline
							class="pulso"
							points="10,56 50,56 62,56 72,30 84,76 96,56 140,56 150,56 160,20 172,80 184,56 230,56"></polyline>
						<circle cx="160" cy="20" r="5" class="alerta"></circle>
						<rect x="172" y="6" width="56" height="20" rx="10" class="selo"></rect>
						<text x="200" y="20">alerta</text>
					</svg>
					<p class="bn">Bloco 4</p>
					<h3>{blocos[3].nome}</h3>
					<p>{blocos[3].texto}</p>
					<p class="ferr">{blocos[3].ferramentas.map((f) => <span>{f}</span>)}</p>
				</article>
			</div>
		</section>

		<section class="faixa" data-secao="stack">
			<h2>A stack, por nível de domínio.</h2>
			<p class="nota-proto">{notaStack}</p>
			<div class="painel-stack">
				<div class="ps-topo">
					<span class="rotulo">Ferramentas em produção</span>
					<div class="legenda" aria-hidden="true">
						<span><i class="n3"></i>{niveis[3]}</span>
						<span><i class="n2"></i>{niveis[2]}</span>
						<span><i class="n1"></i>{niveis[1]}</span>
					</div>
				</div>
				<div class="colunas">
					{
						stack.map((g) => (
							<div class="grupo">
								<ul class="barras">
									{g.ferramentas.map((f) => (
										<li class:list={[`n${f.nivel}`, { confirmar: f.aConfirmar }]} style={`--h:${f.nivel / 3}`}>
											<span class="area-col">
												<span class="col" />
											</span>
											<span class="rot">
												{f.nome}
												{f.aConfirmar && <em>a confirmar</em>}
											</span>
											<span class="sr">{niveis[f.nivel]}</span>
										</li>
									))}
								</ul>
								<p class="area">{g.area}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="faixa" data-secao="garantia">
			<div class="garantia">
				<div>
					<p class="rotulo">A garantia</p>
					<p class="garantia-num">99&nbsp;%</p>
					<p class="sub">de disponibilidade em cada mês</p>
				</div>
				<div class="garantia-texto">
					<div class="dias" aria-hidden="true">
						{dias.map((_, k) => <span style={`--k:${k}`} />)}
					</div>
					<p>{textos.garantia}</p>
					<p class="condicao">{textos.garantiaCondicao}</p>
				</div>
			</div>
		</section>

		<section class="faixa" data-secao="quem">
			<h2>Quem é o Julien</h2>
			<div class="quem">
				<Image src={foto} alt={textos.fotoAlt} width={560} format="avif" quality={55} loading="lazy" class="foto" />
				<div class="quem-dir">
					<p class="quem-texto">{textos.quem}</p>
					<figure class="testemunho">
						<blockquote>«Lugar para um testemunho de um CTO, com duas ou três frases.»</blockquote>
						<figcaption>Nome · Cargo · Empresa</figcaption>
					</figure>
					<p class="nota-proto">Os testemunhos chegam mais tarde.</p>
				</div>
			</div>
		</section>

		<section class="faixa" data-secao="faq">
			<h2>Perguntas frequentes</h2>
			<div class="faq">
				{
					faq.map((q) => (
						<details>
							<summary>{q.p}</summary>
							<p>{q.r}</p>
						</details>
					))
				}
			</div>
		</section>

		<section class="faixa" data-secao="final">
			<div class="final">
				<h2>{textos.finalTitulo}</h2>
				<p class="intro">{textos.finalTexto}</p>
				<a class="botao grande" href={calendly}>{textos.cta}</a>
				<p class="nota">{textos.notaLingua}</p>
			</div>
		</section>
	</main>

	<footer class="rodape">
		<div class="faixa">
			<span class="nome pequeno"><span class="cx">J</span>ulien <span class="cx">L</span>affont</span>
			<span>{rodape.marca}</span>
			<span>{rodape.email}</span>
			{rodape.ligacoes.map((l) => <span class="lig">{l}</span>)}
		</div>
	</footer>
</div>

<script>
	type Escala = { nome: string; sinal: string; blocos: string[] };
	const raiz = document.getElementById('variante-b')!;
	const input = raiz.querySelector<HTMLInputElement>('#escala-b')!;
	const escalas: Escala[] = JSON.parse(input.dataset.escalas!);
	const valor = raiz.querySelector<HTMLElement>('.valor')!;
	const sinal = raiz.querySelector('.sinal')!;
	const estados = [...raiz.querySelectorAll<HTMLElement>('.estado')];
	const marcas = [...raiz.querySelectorAll<HTMLElement>('.marcas span')];
	const classe = (e: string) => (e === 'Essencial' ? 'ess' : e === 'Recomendado' ? 'rec' : 'esp');

	function atualiza() {
		const i = Number(input.value);
		const e = escalas[i];
		const pos = i / (escalas.length - 1);
		valor.textContent = e.nome;
		valor.style.setProperty('--p', String(pos));
		sinal.textContent = e.sinal;
		input.setAttribute('aria-valuetext', e.nome);
		estados.forEach((el, k) => {
			el.textContent = e.blocos[k];
			el.className = `estado ${classe(e.blocos[k])}`;
		});
		marcas.forEach((m, k) => {
			const d = Math.abs(k / (marcas.length - 1) - pos);
			const perto = Math.max(0, 1 - d * 8);
			m.style.setProperty('--h', String(0.25 + perto * 0.75));
			m.classList.toggle('ativa', perto > 0.35);
		});
	}
	input.addEventListener('input', atualiza);
	atualiza();
</script>

<style>
	.vb {
		--bg: #141729;
		--surface: #1c2036;
		--surface-2: #232845;
		--panel: #0f1224;
		--line: #30365a;
		--text: #eceaf6;
		--muted: #a6a8c3;
		--violet: #b89bfb;
		--btn: #7a55e0;
		--green: #5cc493;
		--red: #f08f86;
		--n3: #b89bfb;
		--n2: #8d74d8;
		--n1: #6f5fae;
		--serif: 'Fraunces', 'Iowan Old Style', Georgia, serif;
		--sans: 'Instrument Sans', ui-sans-serif, system-ui, sans-serif;
		position: relative;
		background: var(--bg);
		color: var(--text);
		font: 400 1.0625rem/1.6 var(--sans);
		padding-bottom: 6rem;
	}
	.riscas {
		position: fixed;
		inset: 0 0 auto;
		height: 220px;
		pointer-events: none;
		z-index: 0;
		background: repeating-linear-gradient(to bottom, rgb(184 155 251 / 0.16) 0 1px, transparent 1px 9px);
		mask-image: linear-gradient(#000, transparent);
	}
	.topo {
		position: sticky;
		top: env(safe-area-inset-top, 0px);
		z-index: 5;
		background: rgb(20 23 41 / 0.85);
		border-bottom: 1px solid var(--line);
	}
	.dentro {
		max-width: 72rem;
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding-block: 0.75rem;
		padding-left: max(16px, env(safe-area-inset-left, 0px));
		padding-right: max(16px, env(safe-area-inset-right, 0px));
	}
	h1,
	h2,
	h3,
	.nome,
	.quem-texto,
	.garantia-num,
	summary {
		font-family: var(--serif);
		font-variation-settings: 'SOFT' 100, 'WONK' 0;
	}
	.nome {
		font-size: 1.45rem;
		font-weight: 560;
		letter-spacing: -0.005em;
		white-space: nowrap;
	}
	.cx {
		display: inline-block;
		border: 1.5px solid var(--violet);
		border-radius: 0.3em;
		padding: 0 0.12em;
		margin-right: 0.04em;
		line-height: 1.15;
	}
	.nome.pequeno {
		font-size: 1.15rem;
	}
	.linguas {
		margin-left: auto;
		display: flex;
		gap: 0.75rem;
		font-size: 0.8125rem;
		letter-spacing: 0.06em;
		color: var(--muted);
	}
	.linguas span {
		display: inline-flex;
		align-items: center;
		min-height: 24px;
		min-width: 24px;
	}
	.linguas [aria-current] {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.botao {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0 1.15rem;
		border-radius: 12px;
		background: var(--btn);
		color: #fff;
		font-weight: 600;
		font-size: 0.9375rem;
		text-decoration: none;
		white-space: nowrap;
	}
	.botao:hover {
		background: #6a46d3;
	}
	.botao:focus-visible,
	summary:focus-visible,
	input:focus-visible {
		outline: 2px solid var(--green);
		outline-offset: 3px;
	}
	.botao.grande {
		min-height: 52px;
		padding: 0 1.5rem;
		font-size: 1.0625rem;
	}
	main {
		position: relative;
		z-index: 1;
	}
	.faixa {
		max-width: 72rem;
		margin: 0 auto;
		padding-block: 4.5rem 0;
		padding-left: max(16px, env(safe-area-inset-left, 0px));
		padding-right: max(16px, env(safe-area-inset-right, 0px));
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	h1,
	h2,
	h3 {
		margin: 0;
		text-wrap: balance;
	}
	h1 {
		font-size: clamp(2.4rem, 5.6vw, 3.9rem);
		line-height: 1.06;
		font-weight: 600;
		letter-spacing: -0.015em;
	}
	h2 {
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		line-height: 1.1;
		font-weight: 560;
	}
	h3 {
		font-size: 1.3rem;
		line-height: 1.2;
		font-weight: 560;
	}
	p {
		margin: 0;
	}
	.lead,
	.intro {
		color: var(--muted);
		max-width: 40rem;
	}
	.lead {
		font-size: 1.1875rem;
	}
	.nota {
		font-size: 0.875rem;
		color: var(--muted);
	}
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		gap: 3rem;
		align-items: center;
		padding-top: 5rem;
	}
	.hero-texto {
		display: grid;
		gap: 1.25rem;
		justify-items: start;
	}
	.hero-lado {
		display: grid;
		gap: 0.75rem;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.3rem 0.8rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--surface);
		font-size: 0.875rem;
		color: var(--muted);
	}
	.ponto {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--green);
	}
	.acao {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
	}
	.pr {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 20px;
		padding: 1.25rem;
		display: grid;
		gap: 1rem;
	}
	.pr-topo {
		display: grid;
		gap: 0.15rem;
	}
	.pr-num {
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.pr-titulo {
		font-weight: 600;
	}
	.pr ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.5rem;
	}
	.pr li {
		display: grid;
		grid-template-columns: 22px 1fr;
		column-gap: 0.6rem;
		align-items: center;
		padding: 0.55rem 0.75rem;
		border-radius: 12px;
		background: var(--surface-2);
		font-size: 0.9375rem;
		animation: entra 0.5s ease both;
		animation-delay: calc(var(--d) * 0.45s + 0.2s);
	}
	.pr li span {
		grid-column: 2;
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.pr svg {
		grid-row: span 2;
		width: 22px;
		height: 22px;
		padding: 3px;
		border-radius: 50%;
		fill: none;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.pr .ok svg {
		stroke: var(--panel);
		background: var(--green);
	}
	.pr .ko svg {
		stroke: var(--panel);
		background: var(--red);
	}
	.pr .ko span {
		color: var(--red);
	}
	.pr-fim {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--red);
		animation: entra 0.5s ease both;
		animation-delay: 2.1s;
	}
	@keyframes entra {
		from {
