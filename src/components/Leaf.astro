---
// The leaf icon of the ecology links (#54, "Direção visual › Folha"): an outline with a tip, a straight
// stalk, the midrib and two veins, one up and one to the right. Decorative: the link names itself.
interface Props {
	size?: number;
}

const { size = 20 } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.9"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	class="shrink-0"
>
	<path d="M5 19.5C1.8 11 11 3.8 20.5 3.5C20.7 13.5 13.5 22.7 5 19.5Z"></path>
	<path d="M3 21.5L14.6 9.6"></path>
	<path d="M8.1 16.3V12.3"></path>
	<path d="M12.9 11.4H17"></path>
</svg>
