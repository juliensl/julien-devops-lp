---
// O rodapé de todas as páginas: o nome, o LinkedIn e a Ecologia.
// As partes que chegam com as páginas para onde levam têm o lugar marcado com o ticket.
import { type Lingua } from '../config/site';
import { valores } from '../config/valores';
import { dicionarios } from '../i18n';
import { caminhoDaEcologia } from '../lib/caminhos';
import Folha from './Folha';

interface Props {
	lingua: Lingua;
}

const { lingua } = Astro.props;
const t = dicionarios[lingua];
---

<footer class="mt-20 border-t border-linha text-sm text-texto-secundario">
	<div class="largura flex flex-wrap items-center gap-x-6 gap-y-3 py-8">
		<p class="font-titulos text-lg text-texto">{valores.nome}</p>

		{/* O email no domínio (#71) */}

		<a
			href={valores.linkedin}
			class="inline-flex min-h-6 items-center underline underline-offset-3 hover:text-texto"
		>
			LinkedIn
		</a>

		<a
			href={caminhoDaEcologia(lingua)}
			class="inline-flex min-h-6 items-center gap-1.5 underline underline-offset-3 hover:text-texto"
		>
			<Folha tamanho={16} className="shrink-0 text-verde" />
			{t.ecologia.ligacao}
		</a>

		{/* Informação legal e Política de privacidade (#71) */}
	</div>
</footer>
