---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SHARE_IMAGE } from '../config/share-image';
import { HTML_CODES, PHASE, SITE, type Language } from '../config/site';
import { values } from '../config/values';
import { dictionaries } from '../i18n';
import { commit } from '../lib/commit';
import { pathInLanguage } from '../lib/paths';

interface Props {
	language: Language;
	/**
	 * A página só existe nesta língua (a 404): tem sempre noindex, não tem canonical, hreflang nem
	 * Open Graph (ninguém a partilha), e o cabeçalho não tem seletor de língua.
	 */
	noEquivalents?: boolean;
	title: string;
	description: string;
}

const { language, noEquivalents = false, title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;
/** A mesma página noutra língua, com o URL absoluto. */
const urlInLanguage = (l: Language) =>
	new URL(pathInLanguage(Astro.url.pathname, language, l), SITE).href;
---

<!doctype html>
<html lang={HTML_CODES[language]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{(PHASE.noindex || noEquivalents) && <meta name="robots" content="noindex" />}
		{!noEquivalents && (
			<>
				<link rel="canonical" href={canonical} />
				{/* O hreflang: a página em cada língua publicada, com os códigos fr, en e pt.
				    O x-default aponta para o inglês, e só quando o inglês estiver publicado. */}
				{PHASE.publishedLanguages.map((l) => (
					<link rel="alternate" hreflang={l} href={urlInLanguage(l)} />
				))}
				{PHASE.publishedLanguages.includes('en') && (
					<link rel="alternate" hreflang="x-default" href={urlInLanguage('en')} />
				)}
				{/* O título e a descrição na língua da página; a imagem é a mesma nas três, em inglês. */}
				<meta property="og:type" content="website" />
				<meta property="og:url" content={canonical} />
				<meta property="og:title" content={title} />
				<meta property="og:description" content={description} />
				<meta property="og:image" content={new URL(SHARE_IMAGE.path, SITE).href} />
				<meta property="og:image:width" content={String(SHARE_IMAGE.width)} />
				<meta property="og:image:height" content={String(SHARE_IMAGE.height)} />
				<meta property="og:image:alt" content={`${values.name}, ${dictionaries.en.designation}`} />
			</>
		)}
		<meta name="commit" content={commit} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		{/* Só a fonte do Hero (a Promessa, em Bona Nova) é pré-carregada. */}
		<Font cssVariable="--font-bona-nova" preload />
		<Font cssVariable="--font-geist" />
	</head>
	<body class="antialiased">
		<Header language={language} noEquivalents={noEquivalents} />
		<slot />
		<Footer />
	</body>
</html>
