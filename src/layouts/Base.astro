---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SHARE_IMAGE } from '../config/share-image';
import { HTML_CODES, PHASE, SITE, type Language } from '../config/site';
import { values } from '../config/values';
import { dictionaries } from '../i18n';
import { commit } from '../lib/commit';
import { pathInLanguage } from '../lib/paths';

interface Props {
	language: Language;
	/**
	 * The page only exists in this language (the 404): it always has `noindex`, has no canonical,
	 * hreflang or Open Graph (nobody shares it), and the header has no language switcher.
	 */
	noEquivalents?: boolean;
	title: string;
	description: string;
}

const { language, noEquivalents = false, title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;
/** The same page in another language, as an absolute URL. */
const urlInLanguage = (l: Language) =>
	new URL(pathInLanguage(Astro.url.pathname, language, l), SITE).href;
---

<!doctype html>
<html lang={HTML_CODES[language]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{(PHASE.noindex || noEquivalents) && <meta name="robots" content="noindex" />}
		{!noEquivalents && (
			<>
				<link rel="canonical" href={canonical} />
				{/* The hreflang: the page in each published language, with the codes `fr`, `en` and `pt`.
				    `x-default` points to English, and only once English is published. */}
				{PHASE.publishedLanguages.map((l) => (
					<link rel="alternate" hreflang={l} href={urlInLanguage(l)} />
				))}
				{PHASE.publishedLanguages.includes('en') && (
					<link rel="alternate" hreflang="x-default" href={urlInLanguage('en')} />
				)}
				{/* The title and the description in the page's language; the image is the same in all three, in English. */}
				<meta property="og:type" content="website" />
				<meta property="og:url" content={canonical} />
				<meta property="og:title" content={title} />
				<meta property="og:description" content={description} />
				<meta property="og:image" content={new URL(SHARE_IMAGE.path, SITE).href} />
				<meta property="og:image:width" content={String(SHARE_IMAGE.width)} />
				<meta property="og:image:height" content={String(SHARE_IMAGE.height)} />
				<meta property="og:image:alt" content={`${values.name}, ${dictionaries.en.designation}`} />
			</>
		)}
		<meta name="commit" content={commit} />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		{/* Only the Hero font (the Promise, in Bona Nova) is preloaded. */}
		<Font cssVariable="--font-bona-nova" preload />
		<Font cssVariable="--font-geist" />
	</head>
	<body class="antialiased">
		<Header language={language} noEquivalents={noEquivalents} />
		<slot />
		<Footer language={language} noEquivalents={noEquivalents} />
	</body>
</html>
