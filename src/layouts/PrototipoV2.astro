---
// PROTÓTIPO v2 · Esqueleto das páginas do protótipo: fontes, reinício e os
// tokens de cada tema (.p1, .p2, .p3). Os estilos de cada tema só existem
// dentro da sua classe, por isso não contaminam os outros.
interface Props {
	titulo: string;
}
const { titulo } = Astro.props;
---

<html lang="pt-PT">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="robots" content="noindex" />
		<title>{titulo}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'Bona Nova';
		src: url('/prototipo-direcao-visual/fonts/bona-nova-400.woff2') format('woff2');
		font-weight: 400;
		font-display: swap;
	}
	@font-face {
		font-family: 'Inter';
		src: url('/prototipo-direcao-visual/fonts/inter-wght.woff2') format('woff2');
		font-weight: 100 900;
		font-display: swap;
	}
	@font-face {
		font-family: 'Instrument Sans';
		src: url('/prototipo-direcao-visual/fonts/instrument-sans-wght.woff2') format('woff2');
		font-weight: 400 700;
		font-display: swap;
	}
	@font-face {
		font-family: 'Geist';
		src: url('/prototipo-direcao-visual/fonts/geist-wght.woff2') format('woff2');
		font-weight: 100 900;
		font-display: swap;
	}

	:root {
		color-scheme: dark;
		-webkit-text-size-adjust: 100%;
	}
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		background: #18121f;
		color: #f1ebe4;
	}
	body:has(.vista.p2:not([hidden])) {
		background: #1a1422;
	}
	body:has(.vista.p3:not([hidden])) {
		background: #0d1f19;
	}
	[hidden] {
		display: none !important;
	}
	img {
		max-width: 100%;
		height: auto;
	}
	[id] {
		scroll-margin-top: 96px;
	}

	/* ---------- Tokens dos temas ---------- */
	.p1 {
		--bg: #18121f;
		--surface: #221a2c;
		--surface-2: #2b2238;
		--surface-verde: #13261f;
		--line: #3b3148;
		--line-forte: #6e6280;
		--text: #f1ebe4;
		--muted: #b4a9bf;
		--acao: #c3a6ff;
		--acao-hover: #d5c2ff;
		--acao-texto: #18121f;
		--acento: #c3a6ff;
		--verde: #8ccfa6;
		--verde-forte: #5fae82;
		--ponto-a: rgb(195 166 255 / 0.22);
		--ponto-b: rgb(140 207 166 / 0.75);
		--s1: #8ccfa6;
		--s2: #c3a6ff;
		--s3: #e0c48a;
		--s4: #7d6ca6;
		--serif: 'Bona Nova', 'Iowan Old Style', Georgia, serif;
		--sans: 'Inter', ui-sans-serif, system-ui, sans-serif;
		--raio: 14px;
		--raio-botao: 999px;
	}
	.p2 {
		--bg: #1a1422;
		--surface: #262033;
		--surface-2: #2f2840;
		--surface-verde: #16261f;
		--line: #3a3149;
		--line-forte: #73688a;
		--text: #f3eef6;
		--muted: #bcb1c8;
		--acao: #c9b2ff;
		--acao-hover: #dacbff;
		--acao-texto: #1a1422;
		--acento: #c9b2ff;
		--verde: #92d6ad;
		--verde-forte: #5fae82;
		--ponto-a: rgb(201 178 255 / 0.16);
		--ponto-b: rgb(146 214 173 / 0.6);
		--s1: #92d6ad;
		--s2: #c9b2ff;
		--s3: #e3c78f;
		--s4: #7f71a0;
		--serif: 'Bona Nova', 'Iowan Old Style', Georgia, serif;
		--sans: 'Instrument Sans', ui-sans-serif, system-ui, sans-serif;
		--raio: 20px;
		--raio-botao: 12px;
	}
	.p3 {
		--bg: #0d1f19;
		--surface: #12291f;
		--surface-2: #163126;
		--surface-verde: #1d3b2e;
		--line: #234536;
		--line-forte: #5f8a76;
		--text: #eaf3ee;
		--muted: #a9c2b5;
		--acao: #8fe0b0;
		--acao-hover: #aaebc4;
		--acao-texto: #0d1f19;
		--acento: #c7b2ff;
		--verde: #8fe0b0;
		--verde-forte: #4fa57a;
		--ponto-a: rgb(143 224 176 / 0.2);
		--ponto-b: rgb(199 178 255 / 0.7);
		--s1: #8fe0b0;
		--s2: #c7b2ff;
		--s3: #e6cf94;
		--s4: #4f8a6c;
		--serif: 'Bona Nova', 'Iowan Old Style', Georgia, serif;
		--sans: 'Geist', ui-sans-serif, system-ui, sans-serif;
		--raio: 10px;
		--raio-botao: 10px;
	}

	/* ---------- Base comum, sempre através dos tokens ---------- */
	.vista {
		position: relative;
		min-height: 100vh;
		background: var(--bg);
		color: var(--text);
		font: 400 1rem/1.65 var(--sans);
		padding-bottom: 6rem;
		overflow-x: clip;
	}
	.vista :is(h1, h2, h3) {
		font-family: var(--serif);
		font-weight: 400;
		margin: 0;
		text-wrap: balance;
	}
	.vista p {
		margin: 0;
	}
	.vista a {
		color: inherit;
	}
	.vista :focus-visible {
		outline: 2px solid var(--verde);
		outline-offset: 3px;
	}
	.vista .botao {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-height: 44px;
		padding: 0 1.15rem;
		border-radius: var(--raio-botao);
		background: var(--acao);
		color: var(--acao-texto);
		font: 600 0.9375rem/1 var(--sans);
		text-decoration: none;
		white-space: nowrap;
		border: 0;
		cursor: pointer;
		transition:
			background 0.15s ease,
			transform 0.15s ease;
	}
	.vista .botao:hover {
		background: var(--acao-hover);
	}
	.vista .botao:active {
		transform: translateY(1px);
	}
	.vista .botao.grande {
		min-height: 52px;
		padding: 0 1.6rem;
		font-size: 1.0625rem;
	}
	.vista .ligacao-seta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--verde);
		font-weight: 600;
		text-decoration: none;
		min-height: 24px;
	}
	.vista .ligacao-seta:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.vista .etiqueta {
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--verde);
		font-weight: 500;
	}
	.vista .largura {
		max-width: 76rem;
		margin-inline: auto;
		padding-left: max(20px, env(safe-area-inset-left, 0px));
		padding-right: max(20px, env(safe-area-inset-right, 0px));
	}
	.sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* Estado de cada dado: publicado, calculado, hipótese, demonstração, a validar. */
	.selo {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font: 600 0.6875rem/1.2 var(--sans, system-ui);
		letter-spacing: 0.04em;
		padding: 0.2rem 0.5rem;
		border-radius: 999px;
		white-space: nowrap;
		vertical-align: middle;
	}
	.selo.validado {
		background: rgb(140 207 166 / 0.16);
		color: #a6e3bd;
	}
	.selo.publicado {
		background: rgb(140 207 166 / 0.16);
		color: #a6e3bd;
		border: 1px solid #5fae82;
	}
	.selo.calculado {
		background: rgb(195 166 255 / 0.16);
		color: #d6c4ff;
	}
	.selo.hipotese {
		border: 1px dashed #d6c4ff;
		color: #d6c4ff;
	}
	.selo.demo {
		background: repeating-linear-gradient(135deg, #4a3d14 0 6px, #3d3416 6px 12px);
		color: #fff1c2;
	}
	.selo.a-validar {
		background: #3d3416;
		color: #fff1c2;
		border: 1px dashed #d9c27a;
	}
	/* Notas do protótipo: não fazem parte do design. */
	.nota-proto {
		font: 500 0.8125rem/1.45 system-ui, sans-serif;
		color: #fff6d6;
		background: #3d3416;
		border: 1px dashed #d9c27a;
		border-radius: 6px;
		padding: 0.5rem 0.75rem;
		max-width: 64ch;
	}
	.nota-proto::before {
		content: 'Nota do protótipo · ';
		font-weight: 700;
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation: none !important;
			transition: none !important;
			scroll-behavior: auto !important;
		}
	}
</style>
