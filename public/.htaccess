# Lido só pelo Apache da Infomaniak: o astro preview e a suite Playwright ignoram-no.
# Verifica-se com a confirmação depois de cada Publicação (scripts/confirmar-publicacao.sh)
# e à mão no Lançamento comercial: PageSpeed Insights, compressão, cache e HTTPS (#54).
# Só usa diretivas que um .htaccess pode ter com «AllowOverride FileInfo».

RewriteEngine On

# HTTPS forçado e www.julienlaffont.com → julienlaffont.com, com 301 e num só salto.
# A Infomaniak pode estar atrás de um proxy: aí o HTTPS vem em X-Forwarded-Proto
# e testar só %{HTTPS} daria um ciclo de redirecionamentos.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://julienlaffont.com%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://julienlaffont.com%{REQUEST_URI} [R=301,L]

# Uma pasta sem index.html dá a página 404, e não 403 nem a lista dos ficheiros.
# É o caso de / antes do Lançamento comercial, e de /_astro/.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]

ErrorDocument 404 /404.html

# Cache: os ficheiros de _astro/ têm o hash no nome e nunca mudam;
# o HTML confirma sempre com o servidor, para mostrar logo a última Publicação.
Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/_astro/#"
Header set Cache-Control "no-cache" "expr=%{CONTENT_TYPE} =~ m#^text/html#"

# Tipos que um Apache antigo pode não conhecer.
AddType image/avif .avif
AddType font/woff2 .woff2

# Compressão, se o Apache a tiver: brotli e, para os navegadores sem brotli, gzip.
<IfModule mod_filter.c>
	<IfModule mod_brotli.c>
		AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml application/xml text/xml text/plain
	</IfModule>
	<IfModule mod_deflate.c>
		AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml application/xml text/xml text/plain
	</IfModule>
</IfModule>
