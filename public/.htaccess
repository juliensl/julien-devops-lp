# Read only by the Infomaniak Apache: astro preview and the Playwright suite ignore it.
# Checked by the confirmation after each Publishing (npm run confirm)
# and by hand at the Commercial launch: compression, cache and HTTPS (#54).
# The rewrite and the headers are required: if Apache lacks them, the site returns 500
# and the confirmation turns red. Compression only applies if Apache has it.

RewriteEngine On

# HTTPS forced, with a 301. Behind a proxy, HTTPS arrives in X-Forwarded-Proto,
# and testing only %{HTTPS} would cause a redirect loop.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# A folder without index.html returns the 404 page, not a 403 or the file list.
# That is the case of / before the Commercial launch, and of /_astro/.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]

ErrorDocument 404 /404.html

# The _astro/ files have the hash in their name and never change. HTML always
# revalidates with the server, so that Visitors see the latest Publishing right away.
Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/_astro/#"
Header set Cache-Control "no-cache" "expr=%{CONTENT_TYPE} =~ m#^text/html#"

<IfModule mod_filter.c>
	<IfModule mod_deflate.c>
		AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/plain
	</IfModule>
</IfModule>
