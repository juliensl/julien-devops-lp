{
	"name": "julien-devops-lp",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"build:lancamento": "LANCAMENTO_COMERCIAL=1 astro build --outDir dist-lancamento",
		"preview": "astro preview",
		"check": "astro check",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "playwright test",
		"verificar": "npm run check && npm run format:check && npm run build && npm run build:lancamento && npm test",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/react": "^7.1.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"astro": "^7.4.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.3"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.64.1",
		"@types/node": "^24.19.2",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.1",
		"typescript": "^6.0.3"
	}
}
